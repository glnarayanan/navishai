<% content_for :title, "Runtimes · #{Current.workspace.name} — NavishAI" %>

<main class="page-shell runtime-shell page-family-config">
  <%= link_to "Back to crews", workspace_crew_templates_path(Current.workspace), class: "back-link" %>
  <div class="page-heading runtime-heading">
    <div>
      <h1>Runtime approvals</h1>
      <p>Review runner-detected installations and set the workspace boundary for each one.</p>
    </div>
    <% if @can_configure %>
      <%= button_to "Check runner", detect_workspace_runtime_installations_path(Current.workspace),
        class: "button button-primary" %>
    <% end %>
  </div>

  <div class="runtime-safety-note">
    <strong>Credentials stay on the runner</strong>
    <span>NavishAI stores the resolved executable, reported version, capabilities, and non-secret account details. Approval never copies a login token.</span>
  </div>

  <% if @runtime_error %>
    <p class="inline-error" role="alert"><%= @runtime_error %></p>
  <% end %>

  <% if @installations.empty? %>
    <section class="empty-state runtime-empty">
      <h2>No runtime installations detected</h2>
      <p>Ask an Owner or Admin to check the connected runner after an adapter is installed.</p>
      <% if @can_configure %>
        <%= button_to "Check runner", detect_workspace_runtime_installations_path(Current.workspace), class: "button button-primary" %>
      <% end %>
    </section>
  <% else %>
    <div class="runtime-list">
      <% @installations.each do |installation| %>
        <section class="runtime-installation" id="runtime-<%= installation.id %>" aria-labelledby="runtime-<%= installation.id %>-title">
          <div class="runtime-installation-heading">
            <div>
              <span class="eyebrow"><%= installation.protocol_version %> adapter</span>
              <h2 id="runtime-<%= installation.id %>-title"><%= installation.adapter_key.humanize %></h2>
              <code><%= installation.executable_path %></code>
            </div>
            <span class="status-badge <%= installation.runnable? ? "status-success" : "status-neutral" %>">
              <%= installation.runnable? ? "Approved" : installation.health_status.humanize %>
            </span>
          </div>

          <dl class="runtime-facts">
            <div><dt>Version</dt><dd><%= installation.executable_version %></dd></div>
            <div><dt>Compatibility</dt><dd><%= installation.compatibility_status.humanize %></dd></div>
            <div><dt>Maintained range</dt><dd><%= [installation.minimum_version.presence, installation.maximum_version.presence].compact.join(" – ").presence || "Not reported" %></dd></div>
            <div><dt>Last checked</dt><dd><%= time_tag installation.checked_at, installation.checked_at.to_fs(:short) %></dd></div>
          </dl>

          <% if installation.incompatibility_reason.present? %>
            <p class="runtime-status-note"><%= installation.incompatibility_reason %></p>
          <% end %>
          <div class="runtime-metadata">
            <div>
              <h3>Runner account</h3>
              <% installation.account_metadata.each do |key, value| %>
                <span><%= key.humanize %>: <strong><%= value.humanize %></strong></span>
              <% end %>
            </div>
            <div>
              <h3>Capabilities</h3>
              <span><%= installation.capabilities.map(&:humanize).join(", ").presence || "None reported" %></span>
            </div>
          </div>

          <% if @can_configure %>
            <%= form_with model: installation, url: workspace_runtime_installation_path(Current.workspace, installation),
              method: :patch, class: "runtime-policy-form" do |form| %>
              <label class="runtime-approval-toggle">
                <%= form.check_box :approved, disabled: installation.health_status != "available" || installation.compatibility_status == "incompatible" %>
                <span><strong>Allow this runtime</strong><small>Unchecked installations cannot run workspace tasks.</small></span>
              </label>

              <div class="runtime-policy-groups">
                <fieldset>
                  <legend>Routing profiles</legend>
                  <% AgentPolicy::RUNTIME_PROFILES.each do |key, label| %>
                    <label><%= check_box_tag "runtime_installation[profile_keys][]", key, installation.profile_keys.include?(key), id: "runtime_#{installation.id}_profile_#{key}" %><span><%= label %></span></label>
                  <% end %>
                </fieldset>
                <fieldset>
                  <legend>Roles</legend>
                  <% AgentPolicy::ROLE_DEFINITIONS.each do |key, definition| %>
                    <label><%= check_box_tag "runtime_installation[allowed_role_keys][]", key, installation.allowed_role_keys.include?(key), id: "runtime_#{installation.id}_role_#{key}" %><span><%= CrewConfiguration::CREWS.fetch(definition.fetch(:crew_kind)) %> · <%= definition.fetch(:name) %></span></label>
                  <% end %>
                </fieldset>
                <fieldset>
                  <legend>Tools</legend>
                  <% AgentPolicy::TOOLS.each do |key, label| %>
                    <label><%= check_box_tag "runtime_installation[allowed_tools][]", key, installation.allowed_tools.include?(key), id: "runtime_#{installation.id}_tool_#{key}" %><span><%= label %></span></label>
                  <% end %>
                </fieldset>
                <fieldset>
                  <legend>Data</legend>
                  <% RuntimeInstallation::DATA_CLASSES.each do |key, label| %>
                    <label><%= check_box_tag "runtime_installation[allowed_data_classes][]", key, installation.allowed_data_classes.include?(key), id: "runtime_#{installation.id}_data_#{key}" %><span><%= label %></span></label>
                  <% end %>
                </fieldset>
              </div>

              <div class="runtime-budget-grid">
                <div class="field"><%= form.label :max_timeout_seconds, "Timeout cap (seconds)" %><%= form.number_field :max_timeout_seconds, min: 30, max: 900, required: true %></div>
                <div class="field"><%= form.label :max_steps, "Step cap" %><%= form.number_field :max_steps, min: 1, max: 20, required: true %></div>
                <div class="field"><%= form.label :max_tool_calls, "Tool-call cap" %><%= form.number_field :max_tool_calls, min: 0, max: 50, required: true %></div>
                <div class="field"><%= form.label :max_input_units, "Input-unit cap" %><%= form.number_field :max_input_units, min: 1, max: 10_000_000, required: true %></div>
                <div class="field"><%= form.label :max_output_units, "Output-unit cap" %><%= form.number_field :max_output_units, min: 1, max: 10_000_000, required: true %></div>
              </div>
              <%= form.submit "Save runtime policy", class: "button button-primary" %>
            <% end %>
          <% else %>
            <p class="runtime-readonly-policy">
              <strong>Workspace policy</strong>
              <span><%= pluralize(installation.allowed_role_keys.size, "role") %> · <%= pluralize(installation.allowed_tools.size, "tool") %> · <%= pluralize(installation.allowed_data_classes.size, "data class") %></span>
            </p>
          <% end %>
        </section>
      <% end %>
    </div>
  <% end %>
</main>
