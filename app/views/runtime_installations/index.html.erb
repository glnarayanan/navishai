<% content_for :title, "AI providers · #{Current.workspace.name} — NavishAI" %>

<main class="page-shell runtime-shell page-family-config">
  <div class="page-heading runtime-heading">
    <div>
      <h1>AI providers</h1>
      <p>Connect, test, and control the AI services this workspace can use.</p>
    </div>
    <% if @can_configure %>
      <%= link_to "Add provider", new_workspace_provider_connection_path(Current.workspace), class: "button button-primary button-compact" %>
    <% end %>
  </div>

  <aside class="provider-key-note" role="note">
    <strong>API keys stay private.</strong>
    <span>Keys are encrypted in your self-hosted provider vault and are never shown again.</span>
  </aside>

  <% if @provider_catalog_error %>
    <p class="inline-error" role="alert"><%= @provider_catalog_error %></p>
  <% end %>
  <% if @runtime_error %>
    <p class="inline-error" role="alert"><%= @runtime_error %></p>
  <% end %>

  <% if @configured_providers.empty? && @standalone_installations.empty? %>
    <section class="empty-state provider-empty">
      <h2>No providers connected</h2>
      <p>Add a provider, choose its sign-in method and model, then run a connection test.</p>
      <% if @can_configure %>
        <%= link_to "Add your first provider", new_workspace_provider_connection_path(Current.workspace), class: "button button-secondary button-compact" %>
      <% end %>
    </section>
  <% else %>
    <div class="runtime-list" aria-label="Provider connections">
      <% @configured_providers.each do |provider| %>
        <%= render "provider", provider:, installation: @installations.find { |item| item.adapter_key == provider.fetch("adapter_key") } %>
      <% end %>
      <% @standalone_installations.each do |installation| %>
        <%= render "provider", provider: nil, installation: %>
      <% end %>
    </div>
  <% end %>

  <% if @can_configure && (@configured_providers.any? || @standalone_installations.any?) %>
    <div class="provider-refresh">
      <div>
        <strong>Provider status</strong>
        <span>Refresh after credentials, model, or provider service changes.</span>
      </div>
      <%= button_to "Refresh status", detect_workspace_runtime_installations_path(Current.workspace),
        class: "button button-secondary button-compact" %>
    </div>
  <% end %>
</main>
