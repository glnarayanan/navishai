<% content_for :title, "Scenarios — NavishAI" %>
<main class="page-shell">
  <%= link_to @corpus.name, workspace_corpus_path(Current.workspace, @corpus), class: "back-link" %>
  <div class="page-heading"><div><h1>Scenarios</h1><p>Real-source cases and controlled variants. Experts own the expected behaviour.</p></div></div>
  <section id="scenario-search" class="section-block" aria-labelledby="scenario-search-heading">
    <h2 id="scenario-search-heading">Find a scenario</h2>
    <p id="scenario-search-help">Search a literal phrase in current titles, situations and taxonomy labels, ignoring case. Facts, requirements and old versions are not searched. This local search grants no association or approval.</p>
    <%= form_with url: workspace_corpus_scenarios_path(Current.workspace, @corpus, anchor: "scenario-search"), method: :get, class: "form-stack config-panel", role: "search" do |form| %>
      <div class="field"><%= form.label :corpus_query, "Scenario search phrase" %>
        <div class="search-row"><%= form.search_field :corpus_query, value: @query, maxlength: 200, aria: { invalid: @search_error.present?, describedby: @search_error ? "scenario-search-help scenario-search-error" : "scenario-search-help" } %><%= form.submit "Find scenarios", class: "button" %></div>
      </div>
    <% end %>
    <p><%= link_to "Clear search", workspace_corpus_scenarios_path(Current.workspace, @corpus, anchor: "scenario-search") %>. Phrases stay in your browser URL/history; do not paste secrets.</p>
    <% if @search_error %><p id="scenario-search-error" class="inline-error" role="alert"><%= @search_error %></p><% else %><p role="status"><%= pluralize(@matching_count, "matching scenario") %> · page <%= @page %> · up to 50 scenarios. Counts describe this filter, not issue coverage.</p><% end %>
  </section>
  <% if !@search_error && @scenarios.empty? %><p><%= @query.blank? && @page == 1 ? "No candidates yet. Analyse a corpus, inspect its selection, then create scenarios." : "No scenarios on this page. Clear the phrase or return to the first page, then inspect your corpus if needed." %></p><% end %>
  <% if @scenarios.any? %>
    <div class="table-wrap">
      <table class="data-table" id="scenario-list">
        <thead><tr><th scope="col">Scenario</th><th scope="col">Review</th><th scope="col" class="hide-narrow">Importance</th></tr></thead>
        <tbody>
          <% @scenarios.each do |scenario| %>
            <% version = scenario.current_version %>
            <tr class="record-row">
              <td><%= link_to version.title, workspace_corpus_scenario_path(Current.workspace, @corpus, scenario) %><span class="cell-sub">#<%= scenario.id %> · version <%= version.number %></span></td>
              <td><span class="pill-group"><%= scenario_review_pill(scenario.merged_into_id ? "merge" : version.latest_review&.decision) %><%= status_pill("stale", label: "Source changed") if version.stale? %></span></td>
              <td class="hide-narrow"><%= importance_label(version.importance) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <%= render "shared/record_pagination", more: @more, page_number: @page, query: request.query_parameters.except("page") %>
</main>
