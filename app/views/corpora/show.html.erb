<% content_for :title, "#{@corpus.name} — NavishAI" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-preview"><% end %>
<main class="page-shell">
  <%= link_to "Corpora", workspace_corpora_path(Current.workspace), class: "back-link" %>
  <div class="page-heading"><div><h1><%= @corpus.name %></h1><p>Fixed source snapshots. Local processing unless you approve a model request.</p></div></div>
  <%= render "shared/corpus_navigation", active: "sources" %>
  <section aria-labelledby="sources-title"><h2 id="sources-title">Sources</h2>
    <ul class="workspace-list" role="list">
      <% @sources.each do |source| %>
        <li class="workspace-card"><% if source.expires_at > Time.current %><%= link_to source.name, workspace_corpus_source_path(Current.workspace, @corpus, source) %><% else %><%= source.name %> (expired; awaiting deletion)<% end %>
          <span>Snapshot <%= source.current_snapshot.number %> · <%= source.kind.humanize %> · expires <%= source.expires_at.to_date %></span></li>
      <% end %>
    </ul>
    <% if @sources.empty? %><p>No data yet. Add historical conversations and documentation below.</p><% end %>
    <p><%= link_to "Explore current records", "#corpus-records", data: { turbo: false } %></p>
  </section>
  <section class="section-block config-panel"><h2>Corpus analysis</h2>
    <p>Discover conversation/document term clusters and select bounded, risk-prioritised candidates. This local baseline needs expert correction; it does not prove issue coverage. Production traces use source review, not term discovery.</p>
    <% if Current.require_membership!.can_write? %>
      <%= form_with url: workspace_corpus_corpus_analyses_path(Current.workspace, @corpus), class: "form-stack" do |form| %>
        <div class="field"><%= form.label :scenario_limit, "Candidate limit" %><%= form.number_field :scenario_limit, value: 20, min: 1, max: 100, required: true %></div>
        <%= form.submit "Analyse corpus locally", class: "button button-primary" %>
      <% end %>
      <p><%= link_to "Model-assisted corpus discovery", new_workspace_corpus_corpus_analysis_path(Current.workspace, @corpus) %>. Preview exact records and approve their separate disclosure before any model request.</p>
      <p><%= link_to "Bounded multi-request discovery", new_workspace_corpus_corpus_analysis_path(Current.workspace, @corpus, processing_method: "model_batch") %>. Preview all records, repeated documents and the fixed maximum call plan separately.</p>
    <% end %>
    <ul class="workspace-list" role="list"><% @analyses.each do |analysis| %><li class="workspace-card"><%= link_to "Analysis #{analysis.id} · #{analysis.state}", workspace_corpus_corpus_analysis_path(Current.workspace, @corpus, analysis) %></li><% end %></ul>
  </section>
  <% if Current.require_membership!.can_write? %>
    <section class="section-block config-panel"><h2>Add company data</h2>
      <p>UTF-8 JSON conversation exports or production traces, or plain text/Markdown documents. 10 MiB and 2000 records per upload. A changed upload with the same name adds a snapshot; an exact repeat reuses it.</p>
      <%= form_with url: workspace_corpus_sources_path(Current.workspace, @corpus), multipart: true, class: "form-stack" do |form| %>
        <div class="field"><%= form.label :name, "Source name" %><%= form.text_field :name, required: true, maxlength: 180 %></div>
        <div class="field-grid">
          <div class="field"><%= form.label :kind, "Source type" %><%= form.select :kind, [["Conversation export", "conversations"], ["Text / Markdown", "document"], ["Production traces", "traces"]] %></div>
          <div class="field"><%= form.label :redaction, "Redaction" %><%= form.select :redaction, [["Mask email addresses", "email"], ["Keep original text", "none"]] %></div>
        </div>
        <p class="field-hint">Email masking is not full PII removal. Review names, phone numbers, credentials and other sensitive text before upload. Original files are not stored; snapshots retain normalised text and an input digest.</p>
        <div class="field-grid">
          <div class="field"><%= form.label :file, "Company data file" %><%= form.file_field :file, required: true, accept: ".json,.txt,.md" %></div>
          <div class="field"><%= form.label :retention_days, "Retention days" %><%= form.number_field :retention_days, value: 365, min: 1, max: 3650, required: true %></div>
        </div>
        <%= form.submit "Import source", class: "button button-primary" %>
      <% end %>
      <details class="section-block"><summary>Conversation export format</summary><p>A JSON array of objects with id, title, content and an optional context object. Intercom conversations with source/parts and Zendesk tickets with description/comments also work. HTML inside export fields stays untrusted text.</p>
        <pre class="evidence-text">[{"id":"sso-42","title":"SAML certificate expired","content":"Customer reports login failure.","context":{"plan":"enterprise"}}]</pre>
      </details>
      <details class="section-block"><summary>Production trace format</summary><p>A JSON array of support-trace-v1 objects, at most 100 KiB each. Fields: schema, id, title, target_version, observed_at (ISO 8601 with timezone), input, output, observed_failure and human_correction. Input has situation, known_facts and knowledge; output uses support-output-v1. Failure/correction may be empty text. Extra fields, hidden expectations and malformed outputs are rejected. Reports do not create authoritative labels or run an agent.</p></details>
    </section>
  <% end %>
  <section class="section-block" id="corpus-records"><h2>Explore current records</h2><p>Search a literal phrase in titles, source record IDs, normalised text and context, ignoring case. Only current, unexpired snapshots appear. This local search does not find semantic matches or measure coverage.</p>
    <%= form_with url: workspace_corpus_path(Current.workspace, @corpus, anchor: "corpus-records"), method: :get, class: "form-stack config-panel" do |form| %>
      <div class="field-grid"><div class="field"><%= form.label :corpus_query, "Search phrase" %><%= form.search_field :corpus_query, value: @query, maxlength: 200 %></div>
        <div class="field"><%= form.label :source_id, "Search source" %><%= form.select :source_id, @sources.select { |source| source.expires_at > Time.current }.map { |source| [ source.name, source.id ] }, { include_blank: "All current sources", selected: @selected_source&.id } %></div></div>
      <%= form.submit "Search retained records", class: "button" %>
    <% end %>
    <p><%= link_to "Clear search", workspace_corpus_path(Current.workspace, @corpus, anchor: "corpus-records") %>. Search phrases appear in your browser URL/history; do not paste secrets.</p>
    <% if @search_error %><p class="inline-error" role="alert"><%= @search_error %></p><% else %><p role="status"><%= pluralize(@matching_count, "matching record") %> · page <%= @page %> · up to 50 records.</p><% end %>
    <% if !@search_error && @items.empty? %><p>No records on this page. Clear the phrase or source filter, return to the first page, or import company data.</p><% end %>
    <% @items.each do |item| %><details class="source-record"><summary><%= item.external_id %> · <%= item.title %></summary>
      <p><%= link_to "#{item.source_snapshot.source.name} · snapshot #{item.source_snapshot.number} · record #{item.external_id}", source_evidence_path(item) %></p>
      <pre class="evidence-text"><%= item.content %></pre><details><summary>Retained context</summary><pre class="evidence-text"><%= JSON.pretty_generate(item.context) %></pre></details>
    </details><% end %>
    <nav class="workspace-tabs" aria-label="Record pages"><% if @page > 1 %><%= link_to "Previous records", url_for(request.query_parameters.merge(page: @page - 1, anchor: "corpus-records")) %><% end %><% if @more %><%= link_to "Next records", url_for(request.query_parameters.merge(page: @page + 1, anchor: "corpus-records")) %><% end %></nav>
  </section>
</main>
