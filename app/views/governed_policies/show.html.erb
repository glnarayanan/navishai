<% content_for :title, "Policy changes · #{Current.workspace.name} — NavishAI" %>

<main class="page-shell policy-page">
  <header class="page-heading policy-heading">
    <div>
      <h1>Review policy changes</h1>
      <p>Preview how a change affects selected cases, accounts, or one specialist before publishing it.</p>
    </div>
    <div class="policy-guardrail" role="note">
      <strong>What the preview cannot tell you</strong>
      <p>It cannot predict response quality, customer behavior, resolution rate, or any causal outcome.</p>
    </div>
  </header>

  <% if @policy_error %>
    <div class="notice notice-destructive" role="alert">
      <div class="notice-body"><strong>Policy was not changed</strong><p><%= @policy_error %></p></div>
    </div>
  <% end %>

  <section class="policy-compose" aria-labelledby="policy-compose-title">
    <div class="section-heading-row">
      <div>
        <h2 id="policy-compose-title">Create a policy proposal</h2>
        <p>Choose the cases, accounts, or specialist this proposal applies to.</p>
      </div>
    </div>

    <div class="policy-profile-list">
      <% @profiles.each do |profile| %>
        <% profile_version = profile.current_version %>
        <% family_key = profile.crew_template.support? ? "support_resolution" : "customer_success_intervention" %>
        <% family = @families.find { |item| item.family_key == family_key } %>
        <% contract = family.current_version %>
        <details class="policy-profile">
          <summary>
            <span><strong><%= profile.name %></strong><small><%= family.name %></small></span>
            <span>Choose scope and requirements</span>
          </summary>
          <%= form_with url: propose_workspace_governed_policy_path(Current.workspace),
            scope: :governed_policy, class: "policy-proposal-form" do |form| %>
            <%= form.hidden_field :resolution_contract_family_id, value: family.id %>
            <%= form.hidden_field :agent_profile_id, value: profile.id %>

            <fieldset>
              <legend>Test scope</legend>
              <div class="policy-scope-choice">
                <%= form.label :scope_kind_support_case do %>
                  <%= form.radio_button :scope_kind, "support_case", checked: profile.crew_template.support? %>
                  <span>Selected current cases</span>
                <% end %>
                <%= form.label :scope_kind_account do %>
                  <%= form.radio_button :scope_kind, "account", checked: !profile.crew_template.support? %>
                  <span>Selected Accounts</span>
                <% end %>
                <%= form.label :scope_kind_agent_profile do %>
                  <%= form.radio_button :scope_kind, "agent_profile" %>
                  <span>This crew profile</span>
                <% end %>
              </div>
              <div class="policy-subject-columns">
                <div>
                  <h3>Current cases</h3>
                  <%= hidden_field_tag "governed_policy[support_case_ids][]", "", id: nil %>
                  <% if @current_cases.any? %>
                    <% @current_cases.each do |support_case| %>
                      <label><%= check_box_tag "governed_policy[support_case_ids][]", support_case.id, false,
                        id: "profile_#{profile.id}_case_#{support_case.id}" %><span><%= support_case.conversation.subject %></span></label>
                    <% end %>
                  <% else %><p>No current cases are available.</p><% end %>
                </div>
                <div>
                  <h3>Accounts</h3>
                  <%= hidden_field_tag "governed_policy[account_ids][]", "", id: nil %>
                  <% @accounts.each do |account| %>
                    <label><%= check_box_tag "governed_policy[account_ids][]", account.id, false,
                      id: "profile_#{profile.id}_account_#{account.id}" %><span><%= account.name %></span></label>
                  <% end %>
                </div>
                <div>
                  <h3>Crew profile</h3>
                  <%= hidden_field_tag "governed_policy[agent_profile_ids][]", "", id: nil %>
                  <label><%= check_box_tag "governed_policy[agent_profile_ids][]", profile.id, false,
                    id: "profile_#{profile.id}_self" %><span><%= profile.name %> only</span></label>
                </div>
              </div>
            </fieldset>

            <div class="policy-field-grid policy-field-grid-single">
              <fieldset>
                <legend>Resolution and review</legend>
                <%= hidden_field_tag "governed_policy[contract][required_claim_categories][]", "", id: nil %>
                <% ResolutionContractVersion::CLAIM_CATEGORIES.each do |key, label| %>
                  <label><%= check_box_tag "governed_policy[contract][required_claim_categories][]", key,
                    contract.required_claim_categories.include?(key), id: "profile_#{profile.id}_claim_#{key}" %><span><%= label %></span></label>
                <% end %>
                <%= hidden_field_tag "governed_policy[contract][mandatory_review_checks][]", "", id: nil %>
                <% ResolutionContractVersion::REVIEW_CHECKS.each do |key, label| %>
                  <label><%= check_box_tag "governed_policy[contract][mandatory_review_checks][]", key,
                    contract.mandatory_review_checks.include?(key), id: "profile_#{profile.id}_check_#{key}" %><span><%= label %></span></label>
                <% end %>
                <label class="policy-inline-check">
                  <%= check_box_tag "governed_policy[contract][missing_items_block]", "1", contract.missing_items_block?,
                    id: "profile_#{profile.id}_missing_block" %><span>Missing required items block readiness</span>
                </label>
              </fieldset>

              <%= hidden_field_tag "governed_policy[contract][execution_budget_units]", contract.execution_budget_units %>
              <%= hidden_field_tag "governed_policy[profile][runtime_profile_key]", profile_version.runtime_profile_key %>
              <% profile_version.fallback_profile_keys.each do |fallback| %>
                <%= hidden_field_tag "governed_policy[profile][fallback_profile_keys][]", fallback %>
              <% end %>
              <%= hidden_field_tag "governed_policy[profile][timeout_seconds]", profile_version.timeout_seconds %>
              <%= hidden_field_tag "governed_policy[profile][max_steps]", profile_version.max_steps %>
              <%= hidden_field_tag "governed_policy[profile][max_tool_calls]", profile_version.max_tool_calls %>
              <%= hidden_field_tag "governed_policy[profile][review_policy]", profile_version.review_policy %>
              <div class="field">
                <%= label_tag "profile_#{profile.id}_isolation_policy", "Execution isolation" %>
                <%= select_tag "governed_policy[profile][isolation_policy]",
                  options_for_select(AgentPolicy::ISOLATION_POLICIES.map { |key, label| [ label, key ] }, profile_version.isolation_policy),
                  id: "profile_#{profile.id}_isolation_policy" %>
              </div>
            </div>

            <details class="policy-freshness">
              <summary>Evidence freshness</summary>
              <div class="policy-number-grid">
                <% ResolutionContractVersion::SOURCE_KINDS.each do |kind, label| %>
                  <div class="field"><%= label_tag "profile_#{profile.id}_freshness_#{kind}", label %><%= number_field_tag "governed_policy[contract][evidence_freshness_days][#{kind}]", contract.evidence_freshness_days.fetch(kind), id: "profile_#{profile.id}_freshness_#{kind}", min: 1, max: 3650, required: true %></div>
                <% end %>
              </div>
            </details>
            <div class="field"><%= form.label :reason, "Reason" %><%= form.text_area :reason, rows: 2, maxlength: 500, required: true, placeholder: "Why this test is needed" %></div>
            <%= form.submit "Save proposal", class: "button button-primary" %>
          <% end %>
        </details>
      <% end %>
    </div>
  </section>

  <section class="policy-history" aria-labelledby="policy-history-title">
    <div class="section-heading-row">
      <div><h2 id="policy-history-title">Preview and publication history</h2><p>Previews and published changes keep their evidence, decisions, and approver history.</p></div>
    </div>
    <% if @proposals.empty? %>
      <div class="empty-state"><h3>No policy proposals yet</h3><p>Choose a specialist and where you want to test the change.</p></div>
    <% end %>
    <% @proposals.each do |proposal| %>
      <% preview = proposal.previews.first %>
      <article class="policy-record" id="proposal-<%= proposal.id %>">
        <header>
          <div><h3><%= proposal.agent_profile.name %></h3><p><%= proposal.resolution_contract_family.name %> · <%= proposal.scope_kind.humanize %> · <%= pluralize(proposal.subjects.size, "named subject") %></p></div>
          <span class="status-badge <%= preview ? "status-success" : "status-warning" %>"><%= preview ? "Previewed" : "Needs preview" %></span>
        </header>
        <p><%= proposal.reason %></p>
        <% if preview.nil? %>
          <%= button_to "Preview changes", preview_workspace_governed_policy_path(Current.workspace, proposal_id: proposal.id), class: "button button-primary" %>
        <% elsif preview.expired_at? %>
          <div class="notice notice-info"><div class="notice-body"><strong>Preview details expired</strong><p>The change record, reviewer, and publication history remain.</p></div></div>
        <% else %>
          <section class="policy-preview" id="preview-<%= preview.id %>" aria-label="Deterministic policy preview">
            <details class="policy-technical-verification"><summary>Technical verification</summary><div class="policy-digests"><span>Evidence <code><%= preview.evidence_digest %></code></span><span>Results <code><%= preview.results_digest %></code></span></div></details>
            <% preview.results.each do |result| %>
              <details class="policy-diff" open>
                <summary><span><strong><%= result.fetch("subject_kind").humanize %> <%= result.fetch("subject_id") %></strong><small><%= result.fetch("result").humanize %></small></span><span><%= result.fetch("changes").presence&.to_sentence || "No policy decision changes" %></span></summary>
                <div class="policy-decision-grid">
                  <% { "Current" => result.fetch("old_decision"), "Proposed" => result.fetch("proposed_decision") }.each do |label, decision| %>
                    <div><h4><%= label %></h4><dl><div><dt>Grounding</dt><dd><%= decision.fetch("grounding").humanize %></dd></div><div><dt>Quality review</dt><dd><%= decision.dig("quality_review", "requirement").humanize %></dd></div><div><dt>Routing</dt><dd><%= decision.fetch("routing").humanize %></dd></div><div><dt>Fallback</dt><dd><%= decision.fetch("fallback").humanize %></dd></div><div><dt>Budget</dt><dd><%= decision.dig("budget", "result").humanize %> · <%= number_with_delimiter(decision.dig("budget", "used_units")) %> / <%= number_with_delimiter(decision.dig("budget", "limit_units")) %></dd></div></dl></div>
                  <% end %>
                </div>
                <details class="policy-facts"><summary>Evidence used</summary><dl><% result.fetch("facts").each do |fact| %><div><dt><%= fact.fetch("key").humanize %></dt><dd><%= fact.fetch("value").is_a?(Array) ? fact.fetch("value").to_sentence : fact.fetch("value") %></dd></div><% end %></dl></details>
              </details>
            <% end %>
            <% unless preview.publication %>
              <%= button_to "Publish to selected scope", publish_workspace_governed_policy_path(Current.workspace, proposal_id: proposal.id), params: { preview_id: preview.id }, class: "button button-primary" %>
            <% end %>
          </section>
        <% end %>
      </article>
    <% end %>
  </section>

  <% active = @publications.select { |publication| publication.successor.nil? } %>
  <section class="policy-active" aria-labelledby="policy-active-title">
    <div class="section-heading-row"><div><h2 id="policy-active-title">Active policy changes</h2><p>Other work continues using the current policy.</p></div><span class="status-badge"><%= active.size %> active</span></div>
    <% active.each do |publication| %>
      <article class="policy-publication" id="publication-<%= publication.id %>">
        <div><strong><%= publication.action.humanize %> · <%= publication.scope_kind.humanize %></strong><p>Contract v<%= publication.resolution_contract_version.version_number %> · profile v<%= publication.agent_profile_version.version_number %> · <%= publication.created_by_user.email_address %></p></div>
        <% if publication.canary_action? %>
          <%= form_with url: rollback_workspace_governed_policy_path(Current.workspace, publication_id: publication.id), class: "policy-rollback" do |form| %>
            <%= hidden_field_tag :expected_publication_id, publication.id %><%= label_tag "reason_#{publication.id}", "Rollback reason" %><%= text_field_tag :reason, nil, id: "reason_#{publication.id}", maxlength: 500, required: true %><%= form.submit "Roll back future decisions", class: "button button-secondary" %>
          <% end %>
        <% end %>
      </article>
    <% end %>
  </section>
</main>
