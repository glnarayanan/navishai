<% content_for :title, "Graders — NavishAI" %>
<main class="page-shell">
  <%= link_to @corpus.name, workspace_corpus_path(Current.workspace, @corpus), class: "back-link" %>
  <div class="page-heading"><div><h1>Graders</h1><p>Check a concrete support behaviour. Keep each definition fixed and measure it against expert labels.</p></div></div>
  <% if @graders.empty? %><p class="empty-state">No graders yet. Start with a tool, field or escalation check where code can decide. Use a rubric only when the check needs meaning and context.</p><% else %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th scope="col">Grader</th><th scope="col">Kind</th><th scope="col" class="numeric">Version</th></tr></thead>
        <tbody>
          <% @graders.each do |grader| %>
            <tr class="record-row">
              <td><%= link_to grader.name, workspace_corpus_grader_path(Current.workspace, @corpus, grader) %></td>
              <td><%= grader.current_version.kind.humanize %></td>
              <td class="numeric muted">Version <%= grader.current_version.number %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <%= render "shared/record_pagination", more: @more, page_number: @page %>
  <% if Current.require_membership!.can_write? %><section class="section-block config-panel"><h2>Define a grader</h2><%= render "form", url: workspace_corpus_graders_path(Current.workspace, @corpus), method: :post %></section><% end %>
</main>
