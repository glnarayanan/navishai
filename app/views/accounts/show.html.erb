<% content_for :title, "#{@account.name} health — NavishAI" %>

<main class="account-health-page account-health-detail page-family-record">
  <header class="account-health-heading">
    <div>
      <%= link_to "All accounts", workspace_accounts_path(@workspace), class: "back-link" %>
      <h1><%= @account.name %></h1>
      <p>Deterministic account facts stay separate from crew analysis and proposed interventions.</p>
    </div>
    <div class="account-health-actions">
      <% if @membership.can_write? %>
        <%= button_to "Open risk review", request_risk_review_workspace_account_path(@workspace, @account), class: "button button-primary" %>
      <% end %>
      <div class="account-health-secondary">
        <%= link_to "Explain this outcome",
          workspace_outcome_explanation_path(@workspace, subject_type: "account", subject_id: @account.id),
          class: "button button-primary" %>
        <%= link_to "Scorecard", workspace_health_scorecard_path(@workspace), class: "button button-quiet" %>
        <%= link_to "Crew work", workspace_account_crew_tasks_path(@workspace, @account), class: "button button-secondary" %>
      </div>
      <% if @membership.can_write? %>
        <%= button_to "Recalculate", recalculate_workspace_account_path(@workspace, @account), class: "button button-quiet account-health-tertiary" %>
      <% end %>
    </div>
  </header>

  <% if @command_error %>
    <%= render "shared/notice", kind: "destructive", title: "Risk review not changed", body: @command_error %>
  <% end %>

  <%= render "dossier", dossier: @dossier %>

  <% if @assessment %>
    <section class="health-overview" id="health-assessment" aria-labelledby="health-title">
      <div class="health-score-panel health-score-panel-<%= @assessment.risk_level.dasherize %>">
        <span>Current health</span>
        <strong><%= @assessment.score %><small>/100</small></strong>
        <b id="health-title"><%= @assessment.risk_level.humanize %></b>
        <time datetime="<%= @assessment.calculated_at.iso8601 %>">Calculated <%= time_ago_in_words(@assessment.calculated_at) %> ago</time>
      </div>
      <dl class="health-context">
        <div><dt>Renewal</dt><dd><%= @assessment.renewal_on&.to_fs(:long) || "Not supplied" %></dd></div>
        <div><dt>Trigger</dt><dd><%= @assessment.trigger_kind.humanize %></dd></div>
        <div><dt>Change</dt><dd><%= @assessment.material_change? ? "Material change" : "Below material threshold" %></dd></div>
        <div><dt>Prior score</dt><dd><%= @assessment.previous_assessment&.score || "First snapshot" %></dd></div>
        <div><dt>Scorecard</dt><dd>Version <%= @assessment.health_scorecard_version.version_number %></dd></div>
        <div><dt>Scored rules</dt><dd><%= pluralize(@assessment.health_scorecard_version.definition.fetch("rules").size, "signal") %></dd></div>
      </dl>
      <%= link_to "Explain this health assessment",
        workspace_outcome_explanation_path(@workspace, subject_type: "health-assessment", subject_id: @assessment.id),
        class: "button button-secondary" %>
    </section>

    <section class="health-signals" aria-labelledby="signals-title">
      <header><div><h2 id="signals-title">Deterministic signals</h2><p>Risk points subtract from 100. Zero-weight rows add context without changing the score.</p></div></header>
      <div class="table-scroll health-signals-table" role="region" tabindex="0" aria-label="Deterministic signals">
        <table>
          <thead><tr><th>Signal</th><th>Value</th><th>Source and range</th><th>Weight</th><th>Risk points</th></tr></thead>
          <tbody>
            <% @assessment.signals.each do |signal| %>
              <tr>
                <th scope="row"><%= health_signal_label(signal) %></th>
                <td><%= signal.value_kind == "date" ? signal.date_value.to_fs(:long) : number_with_delimiter(signal.numeric_value) %></td>
                <td><span><%= signal.source_kind.humanize %></span><code><%= signal.source_locator %></code><small><%= signal.range_starts_at&.to_fs(:short) || "All retained history" %> – <%= signal.range_ends_at.to_fs(:short) %></small></td>
                <td><%= signal.weight %></td>
                <td><strong><%= signal.risk_points %></strong><small><%= signal.citation_uri %></small>
                  <%= link_to "View evidence", health_evidence_workspace_account_path(
                    @workspace, @account, assessment_id: @assessment.id, signal_key: signal.signal_key
                  ) if signal.evidence_refs.any? %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <ul class="signal-cards">
        <% @assessment.signals.each do |signal| %>
          <li>
            <details class="signal-card">
              <summary>
                <span>
                  <strong><%= health_signal_label(signal) %></strong>
                  <small>Weight <%= signal.weight %></small>
                </span>
                <b><%= signal.risk_points %> pts</b>
              </summary>
              <dl>
                <div><dt>Value</dt><dd><%= signal.value_kind == "date" ? signal.date_value.to_fs(:long) : number_with_delimiter(signal.numeric_value) %></dd></div>
                <div><dt>Source and range</dt><dd><%= signal.source_kind.humanize %> · <code><%= signal.source_locator %></code><small><%= signal.range_starts_at&.to_fs(:short) || "All retained history" %> – <%= signal.range_ends_at.to_fs(:short) %></small></dd></div>
                <div><dt>Weight</dt><dd><%= signal.weight %></dd></div>
                <div><dt>Risk points</dt><dd><%= signal.risk_points %></dd></div>
                <div><dt>Citation</dt><dd><code><%= signal.citation_uri %></code></dd></div>
                <% if signal.evidence_refs.any? %><div><dt>Evidence</dt><dd><%= link_to "View contributing records", health_evidence_workspace_account_path(
                  @workspace, @account, assessment_id: @assessment.id, signal_key: signal.signal_key
                ) %></dd></div><% end %>
              </dl>
            </details>
          </li>
        <% end %>
      </ul>
    </section>
  <% else %>
    <%= render "shared/empty_state", title: "Health has not been calculated",
      description: "Recalculate now or import renewal and usage inputs to create a typed snapshot." %>
  <% end %>

  <section class="risk-workspace" id="risk-reviews" aria-labelledby="risk-reviews-title">
    <header><div><h2 id="risk-reviews-title">Renewal-risk work</h2><p>Crew findings are bounded analysis, not score facts. Each finding must cite retained evidence and state uncertainty.</p></div></header>
    <% if @investigations.any? %>
      <ol class="risk-review-list">
        <% @investigations.each do |investigation| %>
          <li>
            <div class="risk-review-summary">
              <span class="risk-state risk-state-<%= investigation.account_health_assessment.risk_level.dasherize %>"><%= investigation.status.humanize %></span>
              <div><strong><%= investigation.trigger_kind.humanize %></strong><p>Snapshot <%= investigation.account_health_assessment.score %>/100 · opened <%= investigation.opened_at.to_fs(:short) %></p></div>
            </div>
            <% if investigation.detected? && @membership.can_write? %>
              <%= button_to "Start crew investigation", start_risk_review_workspace_account_path(@workspace, @account, investigation_id: investigation.id), class: "button button-primary" %>
            <% elsif investigation.crew_task %>
              <div class="risk-review-actions">
                <%= link_to "Open #{investigation.crew_task.assigned_agent_profile.name} work", workspace_account_crew_task_path(@workspace, @account, investigation.crew_task), class: "button button-secondary" %>
                <% if investigation.investigating? && investigation.crew_task.completed? && @membership.can_manage_work? %>
                  <%= button_to "Resolve review", resolve_risk_review_workspace_account_path(@workspace, @account, investigation_id: investigation.id), class: "button button-primary" %>
                <% end %>
              </div>
              <% investigation.crew_task.artifacts.each do |artifact| %>
                <article class="risk-artifact">
                  <header><strong><%= artifact.artifact_kind.humanize %></strong><span>AI analysis · v<%= artifact.version_number %></span></header>
                  <div class="message-body"><%= simple_format(artifact.body) %></div>
                  <p><strong>Uncertainty:</strong> <%= artifact.uncertainty %></p>
                  <details><summary><%= pluralize(artifact.citations.size, "citation") %></summary><ul><% artifact.citations.each do |citation| %><li><code><%= citation.fetch("locator") %></code> — <%= citation.fetch("label") %></li><% end %></ul></details>
                </article>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="muted-copy">No material change, renewal-window trigger, or human-requested review is open.</p>
    <% end %>
  </section>

  <%= render "interventions",
    interventions: @interventions,
    intervention_count: @intervention_count,
    intervention_proposed_count: @intervention_proposed_count,
    intervention_overdue_count: @intervention_overdue_count,
    plans: @proposable_intervention_plans,
    origin_assessment: @intervention_origin_assessment,
    origin_investigation: @intervention_origin_investigation,
    review_assessments: @intervention_review_assessments %>

  <div class="account-supporting-grid">
    <section><h2>Contacts</h2><ul><% @contacts.each do |contact| %><li><strong><%= contact.name.presence || "Unnamed contact" %></strong></li><% end %></ul></section>
    <section><h2>Score history</h2><ol><% @history.each do |assessment| %><li><time><%= assessment.calculated_at.to_fs(:short) %></time><strong><%= assessment.score %></strong><span><%= assessment.risk_level.humanize %></span></li><% end %></ol></section>
  </div>
</main>
