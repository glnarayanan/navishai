<% content_for :title, "Workspace settings — NavishAI" %>
<main class="page-shell">
  <%= link_to "Back to workspace", workspace_path(@workspace), class: "back-link" %>
  <div class="page-heading"><div><h1>Workspace settings</h1><p>Manage the identity of <%= @workspace.name %>.</p></div></div>
  <section class="config-panel" aria-labelledby="identity-title">
    <h2 id="identity-title">Name and URL</h2>
    <%= render "form", workspace: @workspace, organizations: nil %>
  </section>
  <section class="section-block">
    <h2>People and access</h2>
    <p>Invite teammates and choose their roles.</p>
    <%= link_to "Manage invitations", workspace_workspace_invitations_path(@workspace) %>
  </section>
</main>
