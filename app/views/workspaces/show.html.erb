<% content_for :title, "#{@workspace.name} — NavishAI" %>

<main class="page-shell">
  <%= link_to "All workspaces", workspaces_path, class: "back-link" %>
  <div class="workspace-heading">
    <div class="page-heading">
      <h1><%= @workspace.name %></h1>
      <p><%= @workspace.organization.name %></p>
    </div>
    <span class="role-badge"><%= role_label(@membership.role) %></span>
  </div>

  <% if @membership.owner? || @membership.admin? %>
    <%= render "shared/empty_state",
      title: "Workspace ready",
      description: "Customer, policy, and work queues will appear here as they are added.",
      action_label: "Manage invitations",
      action_path: workspace_workspace_invitations_path(@workspace) %>
  <% else %>
    <%= render "shared/empty_state",
      title: "Workspace ready",
      description: "Customer, policy, and work queues will appear here as they are added." %>
  <% end %>
</main>
