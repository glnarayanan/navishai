<main class="page-shell">
  <%= link_to "All workspaces", workspaces_path, class: "back-link" %>
  <div class="workspace-heading">
    <div class="page-heading">
      <h1><%= @workspace.name %></h1>
      <p><%= @workspace.organization.name %></p>
    </div>
    <span class="role-badge"><%= role_label(@membership.role) %></span>
  </div>

  <section class="empty-state workspace-empty">
    <h2>Workspace ready</h2>
    <p>Customer, policy, and work queues will appear here as they are added.</p>
    <% if @membership.owner? || @membership.admin? %>
      <%= link_to "Manage invitations", workspace_workspace_invitations_path(@workspace), class: "button button-secondary" %>
    <% end %>
  </section>
</main>
