<% content_for :title, "#{@workspace.name} — NavishAI" %>
<main class="page-shell">
  <%= link_to "All workspaces", workspaces_path, class: "back-link" %>
  <div class="page-heading">
    <div><p class="repository-path"><%= @workspace.organization.name %> / <%= @workspace.slug %></p>
      <h1><%= @workspace.name %></h1></div>
    <span class="role-badge"><%= role_label(@membership.role) %></span>
  </div>
  <nav class="workspace-tabs" aria-label="Workspace">
    <%= link_to "Overview", workspace_path(@workspace), aria: { current: "page" } %>
    <% if @membership.owner? || @membership.admin? %>
      <%= link_to "People and access", workspace_workspace_invitations_path(@workspace) %>
    <% end %>
    <% if @membership.owner? %><%= link_to "Settings", edit_workspace_path(@workspace) %><% end %>
  </nav>
  <section class="lab-empty" aria-labelledby="empty-title">
    <p class="eyebrow">Workspace ready</p>
    <h2 id="empty-title">A clean starting point</h2>
    <p>This lab has no evaluation content. Corpus intake, scenario review and evaluation runs are not yet available.</p>
    <p class="muted-copy">For now, you can manage workspace access. No customer data is processed or sent to an evaluation target.</p>
    <% if @membership.owner? || @membership.admin? %>
      <%= link_to "Manage invitations", workspace_workspace_invitations_path(@workspace), class: "button button-secondary" %>
    <% end %>
  </section>
</main>
