<% source = record&.source_crew_artifact %>
<% result_state = record&.generated_contract_result_state || "unavailable" %>
<section id="<%= dom_id %>" class="draft-provenance <%= source ? "draft-provenance-linked" : "draft-provenance-human" %>" aria-labelledby="<%= dom_id %>-title">
  <header>
    <div>
      <h3 id="<%= dom_id %>-title">
        <% if source %>
          AI source · <%= record.human_edited_at? ? "Human-edited" : "Generated body" %>
        <% else %>
          Human-authored <%= delivery_record ? "delivery" : "draft" %>
        <% end %>
      </h3>
      <% if source %>
        <p>
          Crew draft v<%= source.version_number %> was generated by <%= source.execution_run.agent_profile.name %>
          at <time datetime="<%= source.created_at.iso8601 %>"><%= source.created_at.to_fs(:long) %></time>.
        </p>
      <% else %>
        <p>No AI artifact is linked. The exact final text belongs to the human who sends it.</p>
      <% end %>
    </div>
    <% if source %>
      <span class="draft-proof-state draft-proof-state-<%= result_state.dasherize %>"><%= result_state.humanize %></span>
    <% end %>
  </header>

  <% if source %>
    <% if record.human_edited_at? %>
      <p class="draft-edit-attribution">
        Edited by <strong><%= record.human_edited_by_user.email_address %></strong>
        at <time datetime="<%= record.human_edited_at.iso8601 %>"><%= record.human_edited_at.to_fs(:long) %></time>.
        No sentence-level authorship is inferred.
      </p>
    <% else %>
      <p class="draft-edit-attribution">This message still matches the generated body exactly.</p>
    <% end %>
    <p class="draft-authority-note">
      You may qualify, remove, or add evidence outside this artifact, or replace the final text. The Crew artifact stays unchanged, and replacement text does not inherit its grounding.
    </p>
    <% if delivery_record %>
      <p class="draft-frozen-note">This proof state and edit record were frozen when the delivery was claimed.</p>
    <% else %>
      <p class="draft-frozen-note">This generated-body digest and contract result were frozen when the artifact was selected.</p>
    <% end %>
    <details class="draft-proof-details" <%= "open" unless result_state == "complete" %>>
      <summary>Review linked proof</summary>
      <%= render "artifact_proof", artifact: source %>
      <details class="artifact-original-body">
        <summary>Read the unchanged AI body</summary>
        <div class="message-body"><%= simple_format(source.body) %></div>
      </details>
    </details>
  <% end %>
</section>
