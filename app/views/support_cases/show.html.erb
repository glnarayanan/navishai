<% contact = @support_case.conversation.contact.canonical %>
<% account = contact.account&.canonical %>
<% content_for :title, "#{@support_case.conversation.subject.presence || "Case"} · #{@workspace.name} — NavishAI" %>

<main class="case-workspace">
  <header class="case-toolbar">
    <%= link_to "Back to case queue", workspace_support_cases_path(@workspace), class: "back-link" %>
    <div class="case-title-row">
      <div>
        <h1><%= @support_case.conversation.subject.presence || "Case ##{@support_case.id}" %></h1>
        <p><%= contact.name.presence || "Unnamed contact" %><% if account %> · <%= account.name %><% end %></p>
        <p class="text-meta"><%= @contact_emails.to_sentence.presence || "No email recorded" %><% if @account_domains.any? %> · <%= @account_domains.to_sentence %><% end %></p>
      </div>
      <span class="status-badge status-<%= @support_case.status.dasherize %>"><%= case_status_label(@support_case.status) %></span>
    </div>
    <%= link_to "Explain this outcome",
      workspace_outcome_explanation_path(@workspace, subject_type: "case", subject_id: @support_case.id),
      class: "button button-secondary" %>
  </header>

  <div class="case-workspace-grid">
    <aside class="queue-rail" aria-label="Case queue">
      <%= render "queue", support_cases: @support_cases, selected_case: @support_case %>
    </aside>

    <section class="conversation-thread" aria-labelledby="conversation-title">
      <div class="decision-next decision-next-mobile">
        <%= render "next_action" %>
      </div>
      <% if @command_error %>
        <div class="inline-error command-error" role="alert" tabindex="-1" autofocus>
          <h2>Case not changed</h2>
          <p><%= @command_error %></p>
        </div>
      <% end %>
      <%= render "investigation" %>
      <% if @email_thread %>
        <section class="email-reply send-gate" id="email-reply" aria-labelledby="email-reply-title">
          <div>
            <h2 id="email-reply-title">Email reply</h2>
            <% if @email_delivery&.unknown? || @email_delivery&.sending? %>
              <p>Review the frozen delivery attempt before recording its outcome.</p>
            <% elsif @email_draft.sent? && !@email_follow_up_available %>
              <p>The sent reply is locked. A new customer message will open a fresh draft.</p>
            <% else %>
              <p>Review the exact message, then press Send. Agents and jobs cannot send it.</p>
            <% end %>
          </div>
          <%
            email_delivery_record = @email_delivery if @email_delivery&.unknown? || @email_delivery&.sending? || (@email_draft.sent? && !@email_follow_up_available)
            email_provenance_record = email_delivery_record || (@email_draft unless @email_follow_up_available)
          %>
          <%= render "draft_provenance", record: email_provenance_record,
            delivery_record: email_delivery_record.present?, dom_id: "email-draft-provenance" %>
          <% if @email_delivery&.unknown? || @email_delivery&.sending? %>
            <div class="inline-error" role="status">
              <strong>Delivery outcome needs review</strong>
              <p>Check the shared mailbox or SMTP logs, then record whether SMTP accepted this exact message. Do not resend before checking.</p>
              <dl class="case-facts delivery-review-facts">
                <div><dt>To</dt><dd><%= @email_delivery.to_address %></dd></div>
                <div><dt>Subject</dt><dd><%= @email_delivery.subject %></dd></div>
                <div><dt>Message-ID</dt><dd><code><%= @email_delivery.message_id %></code></dd></div>
                <div><dt>Attempted</dt><dd><time datetime="<%= @email_delivery.started_at.iso8601 %>"><%= @email_delivery.started_at.to_fs(:long) %></time></dd></div>
              </dl>
              <div class="message-body delivery-review-body"><%= simple_format(@email_delivery.body) %></div>
              <% if @email_delivery.stored_attachments.any? %>
                <ul class="attachment-list" aria-label="Delivery attachments">
                  <% @email_delivery.stored_attachments.each do |attachment| %>
                    <li>
                      <%= link_to attachment.filename, workspace_attachment_path(@workspace, attachment), class: "attachment-link" %>
                      <small><%= number_to_human_size(attachment.byte_size) %></small>
                    </li>
                  <% end %>
                </ul>
              <% end %>
              <% if @membership.can_write? %>
                <div class="reply-actions">
                  <%= button_to "Mark accepted",
                    email_delivery_review_workspace_support_case_path(@workspace, @support_case, @email_delivery),
                    params: { outcome: "accepted" }, class: "button button-primary",
                    data: { turbo_confirm: "Confirm that SMTP accepted this exact message?" } %>
                  <%= button_to "Mark not sent",
                    email_delivery_review_workspace_support_case_path(@workspace, @support_case, @email_delivery),
                    params: { outcome: "rejected" }, class: "button button-secondary",
                    data: { turbo_confirm: "Confirm that SMTP did not accept this message? A fresh send will be allowed." } %>
                </div>
              <% end %>
            </div>
          <% elsif @email_draft.sent? && !@email_follow_up_available %>
            <p class="delivery-actor">Sent by <strong><%= @email_delivery.actor_user.email_address %></strong> at <time datetime="<%= @email_delivery.sent_at.iso8601 %>"><%= @email_delivery.sent_at.to_fs(:long) %></time>.</p>
            <div class="message-body delivery-review-body"><%= simple_format(@email_delivery.body) %></div>
          <% elsif @membership.can_write? %>
            <% email_send_blocked = !HumanDraftProvenance.ready_for_send?(@email_draft) %>
            <%= render "draft_source_selector", channel_name: "email", draft: @email_draft,
              save_path: email_draft_workspace_support_case_path(@workspace, @support_case) %>
            <%= form_with url: email_send_workspace_support_case_path(@workspace, @support_case), class: "email-reply-form" do |form| %>
              <%= form.hidden_field :idempotency_key, value: @send_token %>
              <%= form.hidden_field :draft_version, value: @email_draft.persisted? ? @email_draft.lock_version : "new" %>
              <% if @email_draft.source_crew_artifact_id && !@email_follow_up_available %>
                <%= form.hidden_field :source_crew_artifact_id, value: @email_draft.source_crew_artifact_id %>
              <% end %>
              <%= form.hidden_field :expected_recipient_address, value: @email_recipient.address %>
              <%= form.hidden_field :expected_inbound_message_id, value: @email_recipient.inbound_message_id %>
              <div class="recipient-review <%= "recipient-review-warning" unless @email_recipient.trusted %>">
                <span>To</span>
                <strong><%= @email_recipient.address %></strong>
                <% unless @email_recipient.trusted %>
                  <p>This Reply-To address is not linked to the contact. Check it before sending customer data.</p>
                  <label>
                    <%= check_box_tag :confirmed_recipient_address, @email_recipient.address, false, required: true %>
                    I checked this recipient address
                  </label>
                <% end %>
              </div>
              <div class="field">
                <%= form.label :body, "Message" %>
                <%= form.text_area :body, value: @submitted_email_body || (@email_draft.sent? ? "" : @email_draft.body), required: true, rows: 8, maxlength: EmailDraft::MAX_BODY_BYTES %>
                <span class="field-hint">Plain text. Up to five scanned attachments.</span>
              </div>
              <% if @draft_attachments.any? %>
                <ul class="attachment-list draft-attachment-list" aria-label="Draft attachments">
                  <% @draft_attachments.each do |attachment| %>
                    <li>
                      <span><%= attachment.filename %></span>
                      <small><%= attachment.available? ? number_to_human_size(attachment.byte_size) : "#{attachment.scan_status.humanize}: #{attachment.scan_result_code.humanize}" %></small>
                      <%= link_to "Remove",
                        email_attachment_workspace_support_case_path(
                          @workspace, @support_case, attachment_id: attachment.id,
                          draft_version: @email_draft.lock_version
                        ),
                        data: { turbo_method: :delete }, class: "button button-quiet" %>
                    </li>
                  <% end %>
                </ul>
                <% if @draft_attachments.any? { |attachment| !attachment.available? } %>
                  <p class="field-hint" role="status">Send stays blocked until every attachment passes malware scanning. Remove blocked files to continue.</p>
                <% end %>
              <% end %>
              <% if email_send_blocked %>
                <p class="field-hint" role="status"><%= HumanDraftProvenance::SEND_REVIEW_MESSAGE %></p>
              <% end %>
              <div class="reply-actions">
                <%= form.submit "Save draft", formaction: email_draft_workspace_support_case_path(@workspace, @support_case), class: "button button-secondary" %>
                <%= form.submit "Send email", class: "button button-primary",
                  disabled: email_send_blocked || @draft_attachments.any? { |attachment| !attachment.available? },
                  data: { turbo_confirm: "Send this exact message to the customer now?" } %>
              </div>
            <% end %>
            <% if @email_draft.persisted? && !@email_draft.sent? %>
              <%= form_with url: email_attachments_workspace_support_case_path(@workspace, @support_case),
                class: "attachment-upload-form", multipart: true do |form| %>
                <%= form.hidden_field :draft_version, value: @email_draft.lock_version %>
                <div class="field">
                  <%= form.label :files, "Add attachments" %>
                  <%= form.file_field :files, multiple: true, required: true,
                    accept: "text/plain,application/pdf,image/png,image/jpeg,image/gif" %>
                  <span class="field-hint">PDF, text, PNG, JPEG, or GIF. 5 MiB per file; 10 MiB total.</span>
                </div>
                <%= form.submit "Add files", class: "button button-secondary" %>
              <% end %>
            <% else %>
              <p class="field-hint">Save this draft before adding attachments.</p>
            <% end %>
          <% else %>
            <p class="muted-copy">Read-only access. You cannot draft or send customer email.</p>
          <% end %>
        </section>
      <% end %>

      <% if @intercom_link %>
        <section class="email-reply intercom-reply send-gate" id="intercom-reply" aria-labelledby="intercom-reply-title">
          <div>
            <h2 id="intercom-reply-title">Intercom reply</h2>
            <% if @intercom_delivery&.unknown? || @intercom_delivery&.sending? %>
              <p>Review the frozen Intercom attempt before recording its outcome.</p>
            <% elsif @intercom_draft.sent? && !@intercom_follow_up_available %>
              <p>The sent reply is locked. A new customer message will open a fresh draft.</p>
            <% else %>
              <p>Review the exact message, then press Send. Agents and jobs cannot send it.</p>
            <% end %>
          </div>

          <%
            intercom_delivery_record = @intercom_delivery if @intercom_delivery&.unknown? || @intercom_delivery&.sending? || (@intercom_draft.sent? && !@intercom_follow_up_available)
            intercom_provenance_record = intercom_delivery_record || (@intercom_draft unless @intercom_follow_up_available)
          %>
          <%= render "draft_provenance", record: intercom_provenance_record,
            delivery_record: intercom_delivery_record.present?, dom_id: "intercom-draft-provenance" %>

          <% if @intercom_delivery&.unknown? || @intercom_delivery&.sending? %>
            <div class="inline-error" role="status">
              <strong>Delivery outcome needs review</strong>
              <p>Check Intercom for this exact reply. Do not resend before checking.</p>
              <dl class="case-facts delivery-review-facts">
                <div><dt>Conversation</dt><dd><code><%= @intercom_delivery.remote_conversation_id %></code></dd></div>
                <div><dt>Admin</dt><dd><code><%= @intercom_delivery.admin_id %></code></dd></div>
                <div><dt>Source part</dt><dd><code><%= @intercom_delivery.source_part_id %></code></dd></div>
                <div><dt>Attempted</dt><dd><time datetime="<%= @intercom_delivery.started_at.iso8601 %>"><%= @intercom_delivery.started_at.to_fs(:long) %></time></dd></div>
              </dl>
              <div class="message-body delivery-review-body"><%= simple_format(@intercom_delivery.body) %></div>
              <% if @membership.can_write? %>
                <%= form_with url: intercom_delivery_review_workspace_support_case_path(@workspace, @support_case, @intercom_delivery), class: "compact-form" do |form| %>
                  <div class="field">
                    <%= form.label :remote_part_id, "Intercom part ID for an accepted reply" %>
                    <%= form.text_field :remote_part_id, autocomplete: "off" %>
                    <span class="field-hint">Required only when marking the reply accepted.</span>
                  </div>
                  <div class="reply-actions">
                    <%= form.button "Mark accepted", name: :outcome, value: "accepted", class: "button button-primary",
                      data: { turbo_confirm: "Confirm that Intercom accepted this exact reply?" } %>
                    <%= form.button "Mark not sent", name: :outcome, value: "rejected", class: "button button-secondary",
                      data: { turbo_confirm: "Confirm that Intercom did not accept this reply? A fresh send will be allowed." } %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% elsif @intercom_draft.sent? && !@intercom_follow_up_available %>
            <p class="delivery-actor">Sent by <strong><%= @intercom_delivery.actor_user.email_address %></strong> at <time datetime="<%= @intercom_delivery.sent_at.iso8601 %>"><%= @intercom_delivery.sent_at.to_fs(:long) %></time>.</p>
            <div class="message-body delivery-review-body"><%= simple_format(@intercom_delivery.body) %></div>
          <% elsif @membership.can_write? %>
            <% intercom_send_blocked = !HumanDraftProvenance.ready_for_send?(@intercom_draft) %>
            <%= render "draft_source_selector", channel_name: "Intercom", draft: @intercom_draft,
              save_path: intercom_draft_workspace_support_case_path(@workspace, @support_case) %>
            <%= form_with url: intercom_send_workspace_support_case_path(@workspace, @support_case), class: "email-reply-form" do |form| %>
              <%= form.hidden_field :idempotency_key, value: @intercom_send_token %>
              <%= form.hidden_field :draft_version, value: @intercom_draft.persisted? ? @intercom_draft.lock_version : "new" %>
              <% if @intercom_draft.source_crew_artifact_id && !@intercom_follow_up_available %>
                <%= form.hidden_field :source_crew_artifact_id, value: @intercom_draft.source_crew_artifact_id %>
              <% end %>
              <%= form.hidden_field :expected_source_part_id, value: @intercom_source_part_id %>
              <div class="recipient-review">
                <span>To</span>
                <strong>Intercom conversation <%= @intercom_link.remote_conversation_id %></strong>
              </div>
              <div class="field">
                <%= form.label :body, "Message" %>
                <%= form.text_area :body, value: @submitted_intercom_body || (@intercom_draft.sent? ? "" : @intercom_draft.body),
                  required: true, rows: 8, maxlength: IntercomDraft::MAX_BODY_BYTES %>
                <span class="field-hint">Plain text. The signed-in human sends this reply as their matching Intercom admin.</span>
              </div>
              <% if intercom_send_blocked %>
                <p class="field-hint" role="status"><%= HumanDraftProvenance::SEND_REVIEW_MESSAGE %></p>
              <% end %>
              <div class="reply-actions">
                <%= form.submit "Save draft", formaction: intercom_draft_workspace_support_case_path(@workspace, @support_case), class: "button button-secondary" %>
                <%= form.submit "Send to Intercom", class: "button button-primary",
                  disabled: intercom_send_blocked,
                  data: { turbo_confirm: "Send this exact reply to the customer in Intercom now?" } %>
              </div>
            <% end %>
          <% else %>
            <p class="muted-copy">Read-only access. You cannot draft or send an Intercom reply.</p>
          <% end %>
        </section>
      <% end %>

      <div class="thread-heading">
        <div>
          <h2 id="conversation-title">Conversation</h2>
          <p>Started <%= time_ago_in_words(@support_case.conversation.started_at) %> ago</p>
        </div>
        <span><%= pluralize(@messages.size, "message") %></span>
      </div>

      <% if @messages.any? %>
        <ol class="message-list" role="list">
          <% @messages.each do |message| %>
            <li>
              <article class="message message-<%= message.direction %>">
                <header>
                <strong>
                  <% if message.contact? %>
                    <%= message.author_contact.name.presence || "Customer" %>
                  <% elsif message.user? %>
                    <%= message.author_user.email_address %>
                  <% else %>
                    <%= message.external_author_name %>
                  <% end %>
                </strong>
                  <span class="message-direction"><%= message.direction.titleize %></span>
                  <time datetime="<%= message.occurred_at.iso8601 %>"><%= message.occurred_at.to_fs(:short) %></time>
                </header>
                <div class="message-body">
                  <% if message.intercom_part_link&.redacted_at? %>
                    <p class="muted-copy">This message was redacted in Intercom.</p>
                  <% else %>
                    <%= simple_format(message.body) %>
                  <% end %>
                </div>
                <% if message.stored_attachments.any? %>
                  <ul class="attachment-list" aria-label="Attachments">
                    <% message.stored_attachments.each do |attachment| %>
                      <li>
                        <% if attachment.available? %>
                          <%= link_to attachment.filename, workspace_attachment_path(@workspace, attachment), class: "attachment-link" %>
                        <% else %>
                          <span><%= attachment.filename %></span>
                          <small><%= attachment.rejected? ? "Blocked" : "Quarantined" %>: <%= attachment.scan_result_code.humanize %></small>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </article>
            </li>
          <% end %>
        </ol>
      <% else %>
        <%= render "shared/empty_state",
          title: "No messages yet",
          description: "This case has no customer messages. Sending is not available from this workspace." %>
      <% end %>
    </section>

    <aside class="case-context decision-rail" aria-label="Case context">
      <% unless @membership.can_write? %>
        <%= render "shared/notice", kind: "info", css: "read-only-notice", title: "Read-only access",
          body: "You can review case work but cannot change it." %>
      <% end %>
      <div class="decision-next decision-next-rail">
        <%= render "next_action" %>
      </div>
      <%= render "account_context", dossier: @account_dossier if @account_dossier %>
      <% if @intercom_link %>
        <section class="context-section" aria-labelledby="intercom-context-title">
          <h2 id="intercom-context-title">Intercom source</h2>
          <dl class="case-facts">
            <div><dt>State</dt><dd><%= @intercom_link.remote_state.titleize %></dd></div>
            <div><dt>Assigned to</dt><dd><%= @intercom_link.remote_assignee_name.presence || "Unassigned" %></dd></div>
            <div><dt>Last synced</dt><dd><time datetime="<%= @intercom_link.synced_at.iso8601 %>"><%= @intercom_link.synced_at.to_fs(:long) %></time></dd></div>
          </dl>
          <% remote_notes = @intercom_link.intercom_part_links.select { |part| part.note? && !part.redacted_at? } %>
          <% if remote_notes.any? %>
            <h3>Private notes</h3>
            <ul class="integration-failures">
              <% remote_notes.sort_by { |note| [ note.remote_created_at, note.id ] }.reverse_each do |note| %>
                <li><strong><%= note.author_name.presence || "Intercom teammate" %></strong>: <%= strip_tags(note.body).squish %></li>
              <% end %>
            </ul>
          <% end %>
          <% if @intercom_operations.any? %>
            <h3>Sync needs review</h3>
            <ul class="integration-failures">
              <% @intercom_operations.each do |operation| %>
                <li><%= operation.operation_kind.humanize %>: <%= operation.status.humanize %><%= " (#{operation.failure_code.humanize})" if operation.failure_code %></li>
              <% end %>
            </ul>
          <% end %>
        </section>
      <% end %>
      <section class="context-section">
        <h2>Case controls</h2>
        <dl class="case-facts">
          <div><dt>Status</dt><dd><%= case_status_label(@support_case.status) %></dd></div>
          <div><dt>Priority</dt><dd><%= @support_case.priority.titleize %></dd></div>
          <div><dt>Assigned to</dt><dd><%= @support_case.assigned_membership&.user&.email_address || "Unassigned" %></dd></div>
        </dl>

        <% if @membership.can_write? %>
          <% transitions = CaseWorkflow::TRANSITIONS.fetch(@support_case.status) %>
          <% if transitions.any? %>
            <%= form_with url: transition_workspace_support_case_path(@workspace, @support_case), method: :patch, class: "compact-form" do |form| %>
              <div class="field">
                <%= form.label :status, "Move to" %>
                <%= form.select :status, transitions.map { |status| [ case_status_label(status), status ] }, selected: @submitted_status %>
              </div>
              <div class="field">
                <%= form.label :reason, "Reason (required)" %>
                <%= form.text_field :reason, value: @submitted_reason, required: true, maxlength: 500, autocomplete: "off" %>
              </div>
              <%= form.submit "Update status", class: "button button-secondary" %>
            <% end %>
          <% end %>
        <% end %>
      </section>

      <details class="record-disclosure">
        <summary>Priority and assignment</summary>
        <% if @membership.can_write? %>
          <%= form_with url: priority_workspace_support_case_path(@workspace, @support_case), method: :patch, class: "compact-form inline-control" do |form| %>
            <div class="field">
              <%= form.label :priority, "Priority" %>
              <%= form.select :priority, SupportCase::PRIORITIES.map { |priority| [ priority.titleize, priority ] }, selected: @submitted_priority || @support_case.priority %>
            </div>
            <%= form.submit "Save", class: "button button-quiet" %>
          <% end %>
        <% end %>

        <% if @membership.can_manage_work? %>
          <%= form_with url: assignment_workspace_support_case_path(@workspace, @support_case), method: :patch, class: "compact-form inline-control" do |form| %>
            <div class="field">
              <%= form.label :assigned_membership_id, "Assignee" %>
              <%= form.select :assigned_membership_id,
                options_for_select([[ "Unassigned", "" ]] + @assignable_memberships.map { |membership| [ membership.user.email_address, membership.id ] }, @submitted_assignee_id || @support_case.assigned_membership_id) %>
            </div>
            <%= form.submit "Save", class: "button button-quiet" %>
          <% end %>
        <% else %>
          <p class="muted-copy"><%= @support_case.assigned_membership&.user&.email_address || "Unassigned" %> · <%= @support_case.priority.titleize %></p>
        <% end %>
      </details>

      <details class="record-disclosure">
        <summary>Customer</summary>
        <dl class="case-facts">
          <div><dt>Contact</dt><dd><%= contact.name.presence || "Unnamed contact" %></dd></div>
          <div><dt>Account</dt><dd><%= account&.name || "No account linked" %></dd></div>
          <div><dt>Email</dt><dd><%= @contact_emails.to_sentence.presence || "Not recorded" %></dd></div>
          <div><dt>Domain</dt><dd><%= @account_domains.to_sentence.presence || "Not recorded" %></dd></div>
        </dl>
      </details>

      <details class="record-disclosure" id="tags" <%= "open" if @support_case.tags.any? %>>
        <summary>Tags</summary>
        <% if @support_case.tags.any? %>
          <ul class="tag-list" role="list">
            <% @support_case.tags.order(:name).each do |tag| %>
              <li>
                <span><%= tag.name %></span>
                <% if @membership.can_write? %>
                  <%= button_to "Remove", tagging_workspace_support_case_path(@workspace, @support_case, tag), method: :delete, class: "text-action", aria: { label: "Remove #{tag.name} tag" } %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="muted-copy">No tags</p>
        <% end %>

        <% if @membership.can_write? && @available_tags.any? %>
          <%= form_with url: tag_workspace_support_case_path(@workspace, @support_case), class: "compact-form inline-control" do |form| %>
            <div class="field">
              <%= form.label :tag_id, "Add tag" %>
              <%= form.select :tag_id, @available_tags.map { |tag| [ tag.name, tag.id ] }, selected: @submitted_tag_id %>
            </div>
            <%= form.submit "Add", class: "button button-quiet" %>
          <% end %>
        <% end %>

        <% if @membership.can_manage_work? %>
          <%= form_with url: create_tag_workspace_support_case_path(@workspace, @support_case), class: "compact-form inline-control" do |form| %>
            <div class="field">
              <%= form.label :name, "Create tag" %>
              <%= form.text_field :name, value: @submitted_tag_name, required: true, maxlength: 100, autocomplete: "off" %>
            </div>
            <%= form.submit "Create", class: "button button-quiet" %>
          <% end %>
        <% end %>
      </details>

      <details class="record-disclosure" id="notes" <%= "open" if @notes.any? %>>
        <summary>Private notes</summary>
        <p class="muted-copy">Private — staff only</p>
        <% if @membership.can_write? %>
          <%= form_with url: notes_workspace_support_case_path(@workspace, @support_case), class: "compact-form note-form" do |form| %>
            <%= form.label :body, "Add a private note" %>
            <%= form.text_area :body, value: @submitted_note, required: true, rows: 3 %>
            <%= form.submit "Add note", class: "button button-secondary" %>
          <% end %>
        <% end %>
        <% if @notes.any? %>
          <ol class="note-list" role="list">
            <% @notes.each do |note| %>
              <li>
                <p><%= note.body %></p>
                <small><%= note.author.email_address %> · <%= time_ago_in_words(note.created_at) %> ago</small>
              </li>
            <% end %>
          </ol>
        <% elsif !@membership.can_write? %>
          <p class="muted-copy">No private notes</p>
        <% end %>
      </details>

      <details class="record-disclosure">
        <summary>Case activity</summary>
        <ol class="audit-list" role="list">
          <% @activity_items.each do |item| %>
            <%= render "activity_item", item: item %>
          <% end %>
        </ol>
      </details>
    </aside>
  </div>
</main>
