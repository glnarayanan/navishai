<% content_for :title, "Edit #{@provider.fetch("name")} · #{Current.workspace.name} — NavishAI" %>

<main class="page-shell provider-form-shell page-family-config">
  <%= link_to "← AI providers", workspace_runtime_installations_path(Current.workspace), class: "back-link" %>
  <div class="page-heading">
    <div>
      <h1>Edit <%= @provider.fetch("name") %></h1>
      <p>Choose the sign-in method and model for this provider. Save changes before testing again.</p>
    </div>
  </div>

  <%= render "form", provider: @provider %>
</main>
