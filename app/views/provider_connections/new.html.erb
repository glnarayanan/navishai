<% content_for :title, "Add AI provider · #{Current.workspace.name} — NavishAI" %>

<main class="page-shell provider-form-shell page-family-config">
  <%= link_to "← AI providers", workspace_runtime_installations_path(Current.workspace), class: "back-link" %>
  <div class="page-heading">
    <div>
      <h1>Add a provider</h1>
      <p>Choose the provider and sign-in method. Select a model when the provider requires one.</p>
    </div>
  </div>

  <% if @provider %>
    <%= render "form", provider: @provider %>
  <% elsif @all_providers_configured %>
    <section class="empty-state provider-empty">
      <h2>All supported providers are connected</h2>
      <p>Manage an existing provider connection to change its sign-in method, model, or access.</p>
      <%= link_to "Manage providers", workspace_runtime_installations_path(Current.workspace), class: "button button-secondary button-compact" %>
    </section>
  <% else %>
    <section class="empty-state provider-empty">
      <h2>Provider options are temporarily unavailable</h2>
      <p>Try again in a moment or check System health.</p>
    </section>
  <% end %>
</main>
