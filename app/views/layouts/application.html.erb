<!DOCTYPE html>
<html lang="en" data-theme="<%= color_theme %>">
  <head>
    <title><%= content_for(:title) || "NavishAI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="NavishAI">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_tag nonce: true do %>
      (function () {
        var root = document.documentElement;
        var stored = root.getAttribute("data-theme") || "system";
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var resolved = stored === "dark" || (stored === "system" && prefersDark) ? "dark" : "light";
        root.classList.toggle("dark", resolved === "dark");
        root.style.colorScheme = resolved;
      })();
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= authenticated? ? "is-app" : "is-public" %>" data-controller="theme<%= " landing-header" if landing_page? %>">
    <%= link_to "Skip to content", "#main-content", class: "skip-link" %>
    <div class="site-frame">
      <% unless authenticated? %>
        <div class="site-rail site-rail-start" aria-hidden="true"></div>
        <div class="site-rail site-rail-end" aria-hidden="true"></div>
      <% end %>

      <%= render authenticated? ? "layouts/app_header" : "layouts/public_header" %>
      <%= render "shared/flash_messages" %>

      <div class="app-container" id="main-content" tabindex="-1">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
