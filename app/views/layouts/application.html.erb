<!DOCTYPE html>
<html lang="en" data-theme="<%= color_theme %>">
  <head>
    <title><%= content_for(:title) || "NavishAI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="NavishAI">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#2B7FFF">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_tag nonce: true do %>
      (function () {
        window.__navishaiCspViolations = [];
        document.addEventListener("securitypolicyviolation", function (event) {
          window.__navishaiCspViolations.push([
            event.effectiveDirective,
            event.blockedURI,
            event.sourceFile || "",
            event.lineNumber || 0
          ].join(" "));
        });
        var root = document.documentElement;
        var stored = root.getAttribute("data-theme") || "system";
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var resolved = stored === "dark" || (stored === "system" && prefersDark) ? "dark" : "light";
        root.classList.toggle("dark", resolved === "dark");
      })();
    <% end %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= authenticated? ? "is-app" : "is-public" %>" data-controller="theme">
    <%= link_to "Skip to content", "#main-content", class: "skip-link" %>
    <header class="lab-header">
      <%= link_to "NavishAI", root_path, class: "wordmark", aria: { label: "Homepage" } %>
      <div class="header-tools">
        <%= render "layouts/theme_control" %>
        <details class="lab-navigation">
          <summary>Navigation</summary>
          <nav aria-label="Main navigation">
            <% if authenticated? %>
              <%= link_to "Workspaces", workspaces_path %>
              <%= button_to "Sign out", session_path, method: :delete, class: "button button-quiet" %>
            <% else %>
              <%= link_to "Sign in", new_session_path %>
            <% end %>
          </nav>
        </details>
      </div>
    </header>
    <div class="lab-container" id="main-content" tabindex="-1">
      <%= render "shared/flash_messages" %>
      <%= yield %>
    </div>
  </body>
</html>
