<!DOCTYPE html>
<html lang="en" data-theme="<%= color_theme %>">
  <head>
    <title><%= content_for(:title) || "NavishAI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="NavishAI">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#2B7FFF">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_tag nonce: true do %>
      (function () {
        var root = document.documentElement;
        var stored = root.getAttribute("data-theme") || "system";
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var resolved = stored === "dark" || (stored === "system" && prefersDark) ? "dark" : "light";
        root.classList.toggle("dark", resolved === "dark");
      })();
    <% end %>
    <%= javascript_tag nonce: true do %>
      (function () {
        function turboProgressStyle(node) {
          return node && node.nodeType === 1 && node.tagName === "STYLE" &&
            /turbo-progress-bar/.test(node.textContent || "");
        }

        var insertBefore = Node.prototype.insertBefore;
        Node.prototype.insertBefore = function (node, reference) {
          if (turboProgressStyle(node)) return node;
          return insertBefore.call(this, node, reference);
        };

        var appendChild = Node.prototype.appendChild;
        Node.prototype.appendChild = function (node) {
          if (turboProgressStyle(node)) return node;
          return appendChild.call(this, node);
        };

        function freezeProgress(element) {
          if (!element || element.dataset.progressFrozen) return;
          element.dataset.progressFrozen = "true";
          try {
            Object.defineProperty(element.style, "width", {
              configurable: true,
              enumerable: true,
              get: function () { return "0%"; },
              set: function () {}
            });
            Object.defineProperty(element.style, "opacity", {
              configurable: true,
              enumerable: true,
              get: function () { return "0"; },
              set: function () {}
            });
          } catch (error) {}
        }

        var className = Object.getOwnPropertyDescriptor(Element.prototype, "className");
        if (className && className.set) {
          Object.defineProperty(Element.prototype, "className", {
            configurable: true,
            enumerable: className.enumerable,
            get: className.get,
            set: function (value) {
              className.set.call(this, value);
              if (String(value).indexOf("turbo-progress-bar") !== -1) freezeProgress(this);
            }
          });
        }
      })();
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= authenticated? ? "is-app" : "is-public" %>" data-controller="<%= body_controllers %>">
    <%= link_to "Skip to content", "#main-content", class: "skip-link" %>
    <% if authenticated? %>
      <div class="app-shell">
        <%= render "layouts/app_sidebar" %>
        <div class="app-canvas">
          <%= render "layouts/app_mobile_bar" %>
          <%= render "layouts/app_pagebar" %>
          <%= render "shared/flash_messages" %>
          <div class="app-content" id="main-content" tabindex="-1">
            <%= yield %>
          </div>
        </div>
      </div>
      <%= render "layouts/app_nav_drawer" %>
    <% else %>
      <div class="site-frame">
        <div class="site-rail site-rail-start" aria-hidden="true"></div>
        <div class="site-rail site-rail-end" aria-hidden="true"></div>
        <%= render "layouts/public_header" %>
        <%= render "shared/flash_messages" %>
        <div class="app-container" id="main-content" tabindex="-1">
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
