<% membership = Current.workspace && Current.require_membership! %>
<div class="sidebar-panel sidebar-panel-<%= local_assigns.fetch(:variant, "desktop") %>">
  <div class="sidebar-head">
    <%= render "layouts/wordmark" %>
    <% if Current.workspace %>
      <div class="sidebar-identity">
        <p class="sidebar-workspace-name" title="<%= Current.workspace.name %>"><%= Current.workspace.name %></p>
        <p class="sidebar-workspace-meta">
          <span title="<%= Current.workspace.organization.name %>"><%= Current.workspace.organization.name %></span>
          <span aria-hidden="true">·</span>
          <span><%= role_label(membership.role) %></span>
        </p>
        <p class="sidebar-user" title="<%= Current.user.email_address %>"><%= Current.user.email_address %></p>
      </div>
    <% else %>
      <div class="sidebar-identity">
        <p class="sidebar-workspace-name">Choose a workspace</p>
        <p class="sidebar-user" title="<%= Current.user.email_address %>"><%= Current.user.email_address %></p>
      </div>
    <% end %>
    <%= link_to "Workspaces", workspaces_path, class: "nav-item #{ "is-current" if nav_current?("workspaces", "workspace_invitations") }",
      aria: { current: nav_current?("workspaces", "workspace_invitations") ? "page" : nil } %>
  </div>

  <% if Current.workspace %>
    <nav class="sidebar-nav" aria-label="Workspace">
      <div class="sidebar-group">
        <p class="sidebar-group-label">Work</p>
        <%= nav_link "Cases", workspace_support_cases_path(Current.workspace), "support_cases", "support_case_commands" %>
        <%= nav_link "Accounts", workspace_accounts_path(Current.workspace), "accounts", "account_imports" %>
      </div>
      <div class="sidebar-group">
        <p class="sidebar-group-label">Knowledge and intelligence</p>
        <%= nav_link "Knowledge", workspace_knowledge_sources_path(Current.workspace), "knowledge_sources" %>
        <% if membership.can_inspect_memory? %>
          <%= nav_link "Memory", workspace_memory_records_path(Current.workspace), "memory_records", "memory_corrections" %>
        <% end %>
        <%= nav_link "Scorecard", workspace_health_scorecard_path(Current.workspace), "health_scorecards" %>
      </div>
      <div class="sidebar-group">
        <p class="sidebar-group-label">Agent operations</p>
        <%= nav_link "Crews", workspace_crew_templates_path(Current.workspace), "crew_templates", "agent_profiles", "crew_tasks" %>
        <%= nav_link "Runtimes", workspace_runtime_installations_path(Current.workspace), "runtime_installations" %>
      </div>
      <% if membership.can_configure_integrations? %>
        <div class="sidebar-group">
          <p class="sidebar-group-label">Channels</p>
          <%= nav_link "Email", workspace_shared_email_inboxes_path(Current.workspace), "shared_email_inboxes" %>
          <%= nav_link "Intercom", workspace_intercom_connections_path(Current.workspace), "intercom_connections" %>
        </div>
      <% end %>
      <% if membership.can_configure_integrations? || membership.owner? %>
        <div class="sidebar-group">
          <p class="sidebar-group-label">Workspace administration</p>
          <% if membership.can_configure_integrations? %>
            <%= nav_link "Webhooks", workspace_outbound_webhook_endpoints_path(Current.workspace), "outbound_webhook_endpoints" %>
          <% end %>
          <% if membership.owner? %>
            <%= nav_link "Data", workspace_data_controls_path(Current.workspace), "workspace_data_controls" %>
          <% end %>
        </div>
      <% end %>
    </nav>
  <% end %>

  <div class="sidebar-foot">
    <% if Current.workspace %>
      <%= link_to workspace_notifications_path(Current.workspace),
        class: "nav-item nav-utility #{ "is-current" if nav_current?("notifications") }",
        aria: { current: nav_current?("notifications") ? "page" : nil } do %>
        Notifications
        <% if unread_notification_count.positive? %>
          <span class="nav-count" aria-label="<%= pluralize(unread_notification_count, "unread notification") %>"><%= unread_notification_count %></span>
        <% end %>
      <% end %>
      <% if workspace_runtime_needs_review? %>
        <%= link_to "Runtime needs review", workspace_runtime_installations_path(Current.workspace), class: "nav-item nav-health" %>
      <% end %>
    <% end %>
    <%= render "layouts/theme_control" %>
    <%= button_to "Sign out", session_path, method: :delete, class: "button button-quiet sidebar-sign-out" %>
  </div>
</div>
