<div class="theme-switch" role="radiogroup" aria-label="Color theme" data-action="keydown->theme#move">
  <% color_theme_options.each do |label, value| %>
    <button type="button" class="theme-option" role="radio" data-theme-target="option"
      aria-label="<%= label %> theme" title="<%= label %>"
      aria-checked="<%= value == color_theme %>" tabindex="<%= value == color_theme ? 0 : -1 %>"
      data-theme-value="<%= value %>" data-action="theme#choose"><%= nav_icon(value.to_sym) %></button>
  <% end %>
</div>
