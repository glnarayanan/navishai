<%= form_with url:, method:, class: "form-stack" do |form| %>
  <% if @target %><%= hidden_field_tag :version_id, params[:version_id] || @target.current_version_id %><% else %><div class="field"><%= form.label :name, "Target name" %><%= form.text_field :name, required: true, maxlength: 120, value: params[:name] %></div><% end %>
  <% unless @target %><div class="field"><%= form.label :adapter, "Target adapter" %><%= form.select :adapter, [["Scripted · local fixture", "scripted"], ["HTTP · approved HTTPS endpoint", "http"], ["HTTP conversation · bounded turns", "http_conversation"], ["Recorded · uploaded trace", "recorded"]], selected: params[:adapter] || "scripted" %></div><% end %>
  <% if !@target || @version.adapter == "recorded" %><div class="field"><%= form.label :trace_item_id, "Trace record ID (recorded only)" %><%= form.number_field :trace_item_id, min: 1, value: params[:trace_item_id] || @version&.trace_item_id %><small>Find the ID on a production-trace source page. Recorded targets return that fixed output only for identical visible input, not a new agent execution.</small></div><% end %>
  <% if !@target || @version.adapter != "recorded" %><div class="field"><%= form.label :configuration, "Target configuration JSON" %><%= form.text_area :configuration, rows: 10, value: params[:configuration] || (@version && JSON.pretty_generate(@version.configuration)) %><small>Required for scripted or HTTP; unused for recorded. Scripted: rules and default_output, at most 20 rules and 1 MiB. HTTP: only an endpoint URL approved by your operator. Never paste credentials here.</small></div><% end %>
  <%= form.submit @target ? "Save target version" : "Create target", class: "button button-primary", data: { turbo_submits_with: "Saving…" } %>
<% end %>
