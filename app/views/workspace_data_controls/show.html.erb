<% content_for :title, "Data controls · #{Current.workspace.name} — NavishAI" %>

<main class="page-shell data-controls-shell page-family-admin">
  <div class="page-heading">
    <h1>Data controls</h1>
    <p>Set how long this workspace keeps customer content and its separate audit record.</p>
  </div>

  <section class="data-policy-summary" aria-labelledby="retention-boundary-title">
    <div>
      <h2 id="retention-boundary-title">Two retention boundaries</h2>
      <p>Customer content includes conversations, source mail, attachments, knowledge, execution evidence, and Memory. Audit events hold action, actor, time, and safe metadata—not copied customer content.</p>
    </div>
    <dl>
      <div><dt>Content</dt><dd><%= @policy.content_retention_days ? pluralize(@policy.content_retention_days, "day") : "No automatic expiry" %></dd></div>
      <div><dt>Audit</dt><dd><%= @policy.audit_retention_days ? pluralize(@policy.audit_retention_days, "day") : "No automatic expiry" %></dd></div>
    </dl>
  </section>

  <section class="section-block data-policy-form-section" aria-labelledby="workspace-export-title">
    <div>
      <h2 id="workspace-export-title">Workspace export</h2>
      <p>Download a compressed, workspace-scoped snapshot of PostgreSQL records and verified attachment bytes. The archive names referenced users by email but excludes passwords, sessions, and deployment secrets.</p>
    </div>
    <%= link_to "Download workspace export", export_workspace_data_controls_path(Current.workspace),
      class: "button button-secondary" %>
  </section>

  <details class="data-task" <%= "open" if @import_error.present? %>>
    <summary>Workspace import</summary>
    <div>
      <h2 id="workspace-import-title">Workspace import</h2>
      <p>Restore an export as a new Workspace in this Organization. Referenced users must already have verified local accounts. NavishAI gives the new Workspace fresh endpoint and ledger IDs and rebuilds its external Memory index.</p>
    </div>
    <% if @import_error %><p class="inline-error" role="alert"><%= @import_error %></p><% end %>
    <%= form_with url: import_workspace_data_controls_path(Current.workspace), multipart: true, class: "data-policy-form" do |form| %>
      <div class="field">
        <%= form.label :workspace_name, "New Workspace name" %>
        <%= form.text_field :workspace_name, required: true, maxlength: 100, autocomplete: "off" %>
      </div>
      <div class="field">
        <%= form.label :workspace_slug, "New Workspace slug" %>
        <%= form.text_field :workspace_slug, required: true, maxlength: 63, pattern: "[a-z0-9]+(?:-[a-z0-9]+)*", autocomplete: "off" %>
        <span class="field-hint">Use lowercase letters, numbers, and single hyphens.</span>
      </div>
      <div class="field">
        <%= form.label :workspace_archive, "Compressed Workspace archive" %>
        <%= form.file_field :workspace_archive, required: true, accept: ".json.gz,application/gzip" %>
        <span class="field-hint">The compressed file limit is 8 MiB.</span>
      </div>
      <%= form.submit "Import as new Workspace", class: "button button-secondary",
        data: { turbo_confirm: "Import this archive as a new Workspace?" } %>
    <% end %>
  </details>

  <section class="section-block data-policy-form-section" aria-labelledby="retention-policy-title">
    <div>
      <h2 id="retention-policy-title">Retention policy</h2>
      <p>Saving records the boundary but does not delete data. Deletion runs only through the separate audited expiry operation.</p>
    </div>

    <%= render "shared/form_errors", record: @policy %>
    <%= form_with model: @policy, url: workspace_data_controls_path(Current.workspace), method: :patch,
      class: "data-policy-form" do |form| %>
      <div class="field">
        <%= form.label :content_retention_days, "Customer content" %>
        <%= form.select :content_retention_days,
          options_for_select([[ "No automatic expiry", "" ]] + WorkspaceDataPolicy::CONTENT_RETENTION_OPTIONS.map { |days| [distance_of_time_in_words(days.days), days] }, @policy.content_retention_days),
          {}, aria: { describedby: "content-retention-hint" } %>
        <span class="field-hint" id="content-retention-hint">The clock starts from each source record's trusted receipt or creation time.</span>
      </div>

      <div class="field">
        <%= form.label :audit_retention_days, "Security and approval audit" %>
        <%= form.select :audit_retention_days,
          options_for_select([[ "No automatic expiry", "" ]] + WorkspaceDataPolicy::AUDIT_RETENTION_OPTIONS.map { |days| [distance_of_time_in_words(days.days), days] }, @policy.audit_retention_days),
          {}, aria: { describedby: "audit-retention-hint" } %>
        <span class="field-hint" id="audit-retention-hint">Audit retention cannot be shorter than content retention.</span>
      </div>

      <%= form.submit "Save retention policy", class: "button button-primary" %>
    <% end %>
  </section>

  <section class="section-block data-policy-form-section" aria-labelledby="content-expiry-title">
    <div>
      <h2 id="content-expiry-title">Content expiry</h2>
      <p>NavishAI runs expiry each day. It removes object bytes and external Memory entries before replacing content older than the current cutoff with retained tombstones. Security and approval audits stay unchanged.</p>
    </div>
    <% if @policy.content_retention_days %>
      <%= button_to "Run content expiry now", expire_workspace_data_controls_path(Current.workspace),
        class: "button button-secondary",
        form: { data: { turbo_confirm: "Expire all customer content older than #{@policy.content_retention_days} days? This cannot be undone." } } %>
    <% else %>
      <p class="empty-state">Choose a customer content period before running expiry.</p>
    <% end %>

    <% if @expiry_runs.any? %>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Requested</th><th scope="col">Cutoff</th><th scope="col">State</th><th scope="col">Records</th></tr></thead>
          <tbody>
            <% @expiry_runs.each do |run| %>
              <tr>
                <td><%= run.created_at.to_fs(:long) %></td>
                <td><%= run.cutoff_at.to_fs(:long) %></td>
                <td><%= run.failed? ? "Failed: #{run.failure_code.humanize}" : run.status.humanize %></td>
                <td><%= run.completed? ? number_with_delimiter(run.expired_record_count) : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="empty-state">No content expiry runs yet.</p>
    <% end %>
  </section>

  <section class="section-block data-policy-form-section" aria-labelledby="audit-expiry-title">
    <div>
      <h2 id="audit-expiry-title">Audit expiry</h2>
      <p>Audit expiry removes actor, network, request, and metadata fields after the separate audit cutoff. The action, subject, trusted time, and an expiry mark remain as a tombstone so ledger links do not break.</p>
    </div>
    <% if @policy.audit_retention_days %>
      <%= button_to "Run audit expiry now", expire_audit_workspace_data_controls_path(Current.workspace),
        class: "button button-secondary",
        form: { data: { turbo_confirm: "Expire audit details older than #{@policy.audit_retention_days} days? This cannot be undone." } } %>
    <% else %>
      <p class="empty-state">Choose an audit period before running expiry.</p>
    <% end %>

    <% if @policy.audit_expiry_status %>
      <dl class="data-policy-summary">
        <div><dt>State</dt><dd><%= @policy.audit_expiry_status == "failed" ? "Failed: #{@policy.audit_expiry_failure_code.humanize}" : @policy.audit_expiry_status.humanize %></dd></div>
        <div><dt>Cutoff</dt><dd><%= @policy.audit_expiry_cutoff_at.to_fs(:long) %></dd></div>
        <div><dt>Events</dt><dd><%= @policy.audit_expiry_status == "completed" ? number_with_delimiter(@policy.audit_expired_event_count) : "—" %></dd></div>
      </dl>
    <% else %>
      <p class="empty-state">No audit expiry runs yet.</p>
    <% end %>
  </section>

  <details class="data-task danger-zone">
    <summary>Delete Workspace</summary>
    <div>
      <h2 id="workspace-deletion-title">Delete Workspace</h2>
      <p>Deletion blocks access at once, removes attachment objects and external Memory entries, then erases this Workspace from PostgreSQL. A small immutable tombstone keeps the tenant, actor, time, and record counts. Export first. This cannot be undone.</p>
    </div>
    <%= form_with url: workspace_deletion_path(Current.workspace), class: "data-policy-form" do |form| %>
      <div class="field">
        <%= form.label :confirmation, "Type #{Current.workspace.slug} to confirm" %>
        <%= form.text_field :confirmation, required: true, autocomplete: "off" %>
      </div>
      <%= form.submit "Delete Workspace", class: "button button-danger",
        data: { turbo_confirm: "Delete #{Current.workspace.name}? Access will stop now and the data cannot be recovered." } %>
    <% end %>
  </details>
</main>
