<% content_for :title, "Run #{@run.id} — NavishAI" %>
<main class="page-shell">
  <%= link_to @run.eval_suite.name, workspace_corpus_eval_suite_path(Current.workspace, @corpus, @run.eval_suite), class: "back-link" %>
  <div class="page-heading"><div><h1>Run <%= @run.id %></h1><p><%= @run.state.humanize %> · <%= @items.size %> fixed cases · <%= @run.processing_version %></p></div><%= link_to "Refresh run", workspace_corpus_evaluation_run_path(Current.workspace, @corpus, @run), class: "button" %></div>
  <p><%= link_to @run.evaluation_target_version.evaluation_target.name, workspace_corpus_evaluation_target_path(Current.workspace, @corpus, @run.evaluation_target_version.evaluation_target, version: @run.evaluation_target_version.number) %> · target v<%= @run.evaluation_target_version.number %> · requested by expert #<%= @run.requested_by_id %>.</p>
  <p role="status">Scripted fixture run, not a live agent test. Trace checks report behaviour; rubric checks without a judge abstain. Calibration must establish grader accuracy.</p>
  <% if @run.error %><p class="inline-error" role="alert"><%= @run.error %></p><% end %>
  <% if @run.state == "queued" %><p>Waiting for the evaluation worker. Refresh for results; do not submit another run just to refresh.</p><% end %>
  <% if @run.state == "running" %><p><%= @items.count { |item| item.evaluation_result } %> of <%= @items.size %> results saved. A worker crash does not grant permission to repeat execution.</p><% end %>
  <section class="section-block"><h2>Case results</h2><ul class="workspace-list" role="list"><% @items.each do |item| %><li class="workspace-card"><% if item.evaluation_result %><%= link_to item.eval_case.scenario_version.title, workspace_corpus_evaluation_result_path(Current.workspace, @corpus, item.evaluation_result) %><strong><%= item.evaluation_result.status.humanize %></strong><% else %><span><%= item.eval_case.scenario_version.title %></span><strong>Not executed</strong><% end %><span><%= item.eval_case.scenario_version.importance.humanize %> importance · case #<%= item.eval_case_id %></span></li><% end %></ul></section>
  <section class="section-block"><h2>Failure patterns</h2><p>Groups share an exact grader version. Counts are observed failed checks, not semantic clusters or measured corpus coverage.</p>
    <% if @failures.empty? %><p>No reported behavioural failures yet. Missing, incomplete and error results do not prove a pass.</p><% end %>
    <% @failures.each do |grader_id, failures| %><article class="source-record"><h3><%= @graders.fetch(grader_id).grader.name %> · v<%= @graders.fetch(grader_id).number %></h3><p><%= failures.size %> failed checks across <%= failures.map { |item, _decision| item.eval_case_id }.uniq.size %> cases.</p><ul role="list"><% failures.each do |item, decision| %><li><%= link_to "Case #{item.eval_case_id}: #{decision['reason']}", workspace_corpus_evaluation_result_path(Current.workspace, @corpus, item.evaluation_result) %></li><% end %></ul></article><% end %>
  </section>
  <% if Current.require_membership!.can_write? && (@run.state == "queued" || (@run.state == "running" && @run.started_at < 10.minutes.ago)) %><section class="section-block"><h2>Stop without retrying</h2><p>Interrupt this run. Retain prior results and start a separate run only if you intend another execution.</p><%= button_to "Interrupt run", workspace_corpus_evaluation_run_path(Current.workspace, @corpus, @run), method: :patch, class: "button" %></section><% end %>
</main>
