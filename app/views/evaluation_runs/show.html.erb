<% content_for :title, "Run #{@run.id} — NavishAI" %>
<main class="page-shell">
  <%= link_to @run.eval_suite.name, workspace_corpus_eval_suite_path(Current.workspace, @corpus, @run.eval_suite), class: "back-link" %>
  <div class="page-heading"><div><h1>Run <%= @run.id %></h1><p><%= @run.state.humanize %> · <%= @items.size %> fixed cases · <%= @run.processing_version %></p></div><%= link_to "Refresh run", workspace_corpus_evaluation_run_path(Current.workspace, @corpus, @run, baseline_id: @baseline&.id), class: "button" %></div>
  <p><%= link_to @run.evaluation_target_version.evaluation_target.name, workspace_corpus_evaluation_target_path(Current.workspace, @corpus, @run.evaluation_target_version.evaluation_target, version: @run.evaluation_target_version.number) %> · target v<%= @run.evaluation_target_version.number %> · requested by expert #<%= @run.requested_by_id %>.</p>
  <p role="status"><%= {"http_conversation" => "Bounded HTTP conversation: only conditionally released messages and actual history go to the approved endpoint, at most eleven calls per case. No automatic retry or continuation after unknown calls.", "http" => "HTTP run: visible inputs go to the approved endpoint; remote outcomes may be unknown after a failed call.", "scripted" => "Scripted fixture run, not a live agent test.", "recorded" => "Recorded production output replay, not a new agent execution. The visible input must match the original trace."}.fetch(@run.evaluation_target_version.adapter) %> Trace checks report behaviour; rubric checks without a judge abstain. Calibration must establish grader accuracy.</p>
  <% if @run.error %><p class="inline-error" role="alert"><%= @run.error %></p><% end %>
  <% if @run.state == "queued" %><p>Waiting for the evaluation worker. Refresh for results; do not submit another run just to refresh.</p><% end %>
  <% if @run.state == "running" %><p><%= @items.count { |item| item.evaluation_result } %> of <%= @items.size %> results saved. A worker crash does not grant permission to repeat execution.</p><% end %>
  <section class="section-block" id="run-comparison"><h2>Compare fixed cases</h2><p>This run is the after run. Match only the same fixed case and identical frozen visible input. Changed contracts, graders or inputs stay unmatched. A missing, incomplete or error result is unresolved, never a pass or improvement.</p>
    <% if @baseline_options.empty? %><p>No other run in this corpus yet. Start a separate run deliberately when you need to test another target version.</p><% else %>
      <%= form_with url: workspace_corpus_evaluation_run_path(Current.workspace, @corpus, @run, anchor: "run-comparison"), method: :get, class: "form-stack config-panel" do |form| %>
        <div class="field"><%= form.label :baseline_id, "Baseline run (before)" %><%= form.select :baseline_id, @baseline_options.map { |run| [ "Run #{run.id} · target #{run.evaluation_target_version.evaluation_target_id} v#{run.evaluation_target_version.number} · #{run.evaluation_target_version.adapter}", run.id ] }, { prompt: "Choose a baseline", selected: @baseline&.id }, required: true %><p class="field-hint">Latest 100 other corpus runs. Comparing only reads saved records; it does not execute or send data.</p></div>
        <%= form.submit "Compare saved runs", class: "button" %>
      <% end %>
    <% end %>
    <% if @comparison %>
      <p><%= link_to "Before: run #{@baseline.id}", workspace_corpus_evaluation_run_path(Current.workspace, @corpus, @baseline) %> · <%= @baseline.state.humanize %> · <%= @baseline.evaluation_target_version.evaluation_target.name %> v<%= @baseline.evaluation_target_version.number %>. After: this run.</p>
      <% changes = { "regression" => "Reported regression", "recovery" => "Reported recovery", "unchanged_pass" => "Still passes", "unchanged_fail" => "Still fails", "unresolved" => "Unresolved", "unmatched" => "Unmatched" } %>
      <p><%= @comparison.count { |row| row[:change] == "regression" } %> reported regressions · <%= @comparison.count { |row| row[:change] == "recovery" } %> reported recoveries · <%= @comparison.count { |row| row[:change] == "unresolved" } %> unresolved pairs · <%= @comparison.count { |row| row[:change] == "unmatched" } %> unmatched entries. These are observed grader decisions, not measured agent quality.</p>
      <% if @comparison.empty? %><p>Neither run has fixed cases to compare.</p><% end %>
      <% @comparison.each do |row| %><article class="source-record comparison-row" data-change="<%= row[:change] %>"><h3><%= changes.fetch(row[:change]) %> · case <%= (row[:after] || row[:before]).eval_case_id %></h3><p><%= (row[:after] || row[:before]).eval_case.scenario_version.title %></p>
        <div class="review-layout"><% { before: "Before", after: "After" }.each do |side, label| %><section><h4><%= label %></h4><% item = row[side] %>
          <% if item.nil? %><p>No identical case/input in this run.</p><% else %><p><%= link_to "Fixed case #{item.eval_case_id}", workspace_corpus_eval_case_path(Current.workspace, @corpus, item.eval_case) %> · <%= item.eval_case.scenario_version.importance.humanize %> importance.</p><% if item.evaluation_result %><p><%= link_to "#{label} result: #{item.evaluation_result.status.humanize}", workspace_corpus_evaluation_result_path(Current.workspace, @corpus, item.evaluation_result) %></p><% else %><p>Not executed; no result.</p><% end %><% if row[:change] == "unmatched" %><details><summary><%= label %> frozen visible input</summary><pre class="evidence-text"><%= JSON.pretty_generate(item.target_input) %></pre></details><% end %><% end %>
        </section><% end %></div>
      </article><% end %>
    <% end %>
  </section>
  <section class="section-block"><h2>Case results</h2><ul class="workspace-list" role="list"><% @items.each do |item| %><li class="workspace-card"><% if item.evaluation_result %><%= link_to item.eval_case.scenario_version.title, workspace_corpus_evaluation_result_path(Current.workspace, @corpus, item.evaluation_result) %><strong><%= item.evaluation_result.status.humanize %></strong><% else %><span><%= item.eval_case.scenario_version.title %></span><strong>Not executed</strong><% end %><span><%= item.eval_case.scenario_version.importance.humanize %> importance · case #<%= item.eval_case_id %></span></li><% end %></ul></section>
  <%= render "failure_patterns" %>
  <% if Current.require_membership!.can_write? && (@run.state == "queued" || (@run.state == "running" && @run.started_at < 10.minutes.ago)) %><section class="section-block"><h2>Stop without retrying</h2><p>Interrupt this run. Retain prior results and start a separate run only if you intend another execution.</p><%= button_to "Interrupt run", workspace_corpus_evaluation_run_path(Current.workspace, @corpus, @run), method: :patch, class: "button" %></section><% end %>
</main>
