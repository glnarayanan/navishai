<% content_for :title, "NavishAI — Evidence-backed customer operations" %>

<main class="landing">
  <section class="landing-hero" id="hero" aria-labelledby="hero-title">
    <div class="landing-hero-inner">
      <div class="landing-hero-copy">
        <h1 id="hero-title">Resolve support cases with proof.<br>Keep every message human.</h1>
        <p>Bring shared email and Intercom into one workspace. Self-hosted customer operations use current knowledge and account history to prepare a cited draft and show what needs review before a teammate sends it.</p>
      </div>
      <div class="landing-actions">
        <%= link_to "Sign in to your workspace", new_session_path, class: "button button-primary" %>
        <a href="#how-it-works" class="button button-secondary" data-action="landing-header#jump">See the support workflow</a>
      </div>
    </div>
    <figure class="hero-media" aria-label="Illustrative case workspace preview">
      <div class="hero-media-frame">
        <div class="product-preview">
          <div class="product-preview-bar">
            <span class="product-stage-dot"></span>
            <span class="product-stage-dot"></span>
            <span class="product-stage-dot"></span>
            <span>Support · Cases</span>
          </div>
          <div class="product-preview-body">
            <aside class="product-preview-rail">
              <article class="stage-row is-current"><strong>Invoice webhook retry</strong><small>Investigating · High</small></article>
              <article class="stage-row"><strong>SSO domain mismatch</strong><small>Draft ready</small></article>
              <article class="stage-row"><strong>Renewal risk: Northwind</strong><small>Waiting internally</small></article>
            </aside>
            <div class="product-preview-main">
              <div class="stage-message"><strong>Maya Chen</strong><span>The webhook still returns 401 after we rotated the secret. Can you confirm whether the new key is live?</span></div>
              <div class="stage-draft">
                <strong>Cited draft ready for review</strong>
                <span>The secret rotation completed at 14:02. The 401 is from the previous signing key still cached on one worker.</span>
                <span class="draft-status" aria-hidden="true">Draft awaiting review</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </figure>
  </section>

  <section class="proof-section" id="proof" aria-labelledby="proof-title">
    <header class="proof-heading">
      <h2 id="proof-title">The customer context behind every answer</h2>
    </header>
    <div class="proof-grid">
      <% [
        ["Shared email + Intercom", "Conversations become linked cases with Account and Contact context."],
        ["Cited investigations", "Drafts keep current knowledge, memory, and public sources close to each claim."],
        ["Account context", "Support history feeds a source-backed dossier and explainable health signals."],
        ["Human-controlled replies", "A teammate owns the final wording and deliberately sends the message."]
      ].each do |name, detail| %>
        <article class="proof-cell">
          <strong class="proof-mark"><%= name %></strong>
          <span class="proof-more"><%= detail %></span>
        </article>
      <% end %>
    </div>
  </section>

  <section id="how-it-works" class="feature-section" aria-labelledby="workflow-title">
    <header class="section-header section-header-plain">
      <h2 id="workflow-title">From customer question to reviewed answer</h2>
      <p>Follow the same evidence from intake through investigation, review, and the final human action.</p>
    </header>
    <% workflow_steps = [
      ["Bring the conversation together", "Shared email and Intercom connect the customer, Account, conversation, and case."],
      ["Investigate current evidence", "The crew uses approved knowledge, scoped memory, Account history, and read-only public sources."],
      ["See what needs attention", "Material claims show whether evidence is supported, stale, conflicting, uncertain, or refused."],
      ["Edit and send as yourself", "A signed-in teammate owns the final wording. NavishAI records the exact message, channel, and actor."]
    ] %>
    <ol class="workflow-steps" role="list" aria-label="Support workflow steps">
      <% workflow_steps.each_with_index do |(title, body), index| %>
        <li class="workflow-step">
          <div class="workflow-copy">
            <span class="workflow-number" aria-hidden="true"><%= format("%02d", index + 1) %></span>
            <h3><%= title %></h3>
            <p><%= body %></p>
          </div>
          <div class="feature-canvas">
            <div class="feature-canvas-inner">
              <% if index.zero? %>
                <span class="feature-chip">Shared email</span>
                <span class="feature-chip">Intercom</span>
                <div class="feature-inbox-row is-new"><strong>New case</strong><small>Invoice webhook retry</small></div>
                <div class="feature-inbox-row"><strong>Customer linked</strong><small>Acme · Maya Chen</small></div>
              <% elsif index == 1 %>
                <div class="feature-evidence-card"><strong>Knowledge</strong><small>Rotation runbook · current</small></div>
                <div class="feature-evidence-card"><strong>Account history</strong><small>Prior 401 after secret change</small></div>
                <div class="feature-evidence-card is-web"><strong>Public source</strong><small>Cited and ready for review</small></div>
              <% elsif index == 2 %>
                <p class="feature-chip">Evidence check</p>
                <ul class="feature-review-list">
                  <li class="is-ok">Supported facts stay cited beside the draft</li>
                  <li class="is-warn">Stale guidance is visible before review</li>
                  <li class="is-ok">Uncertain claims stay qualified</li>
                </ul>
              <% else %>
                <div class="feature-send-card">
                  <strong>Ready for your review</strong>
                  <span>Edit the wording, confirm the recipient, and send as yourself.</span>
                  <span class="draft-status">Draft awaiting review</span>
                </div>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
  </section>

  <section id="features" class="bento-section" aria-labelledby="outcomes-title">
    <div class="section-frame">
      <header class="section-header">
        <h2 id="outcomes-title">Support history becomes customer context</h2>
        <p>Carry what the team learns into a source-backed Account view, explainable health, and human-owned Customer Success work.</p>
      </header>
      <div class="bento-grid">
        <article class="bento-card">
          <div class="bento-visual outcome-stage">
            <div class="outcome-board">
              <div class="feature-evidence-card"><strong>Customer identity</strong><small>Linked sources and corrections</small></div>
              <div class="feature-evidence-card"><strong>Current facts</strong><small>Source, observed time, and conflicts</small></div>
              <div class="feature-evidence-card is-web"><strong>Next human action</strong><small>Open questions stay visible</small></div>
            </div>
          </div>
          <div class="bento-copy">
            <h3>A complete Account view</h3>
            <p>See identities, facts, conversations, cases, memory, conflicts, corrections, and open questions with their source and date.</p>
          </div>
        </article>

        <article class="bento-card">
          <div class="bento-visual health-stage is-on" aria-hidden="true">
            <div class="health-tooltip">72</div>
            <svg class="health-chart" viewBox="0 0 600 200">
              <path class="chart-fill" d="M0 160 C100 150 150 120 200 128 C280 140 340 70 400 82 C470 96 530 48 600 54 L600 200 L0 200 Z"/>
              <path class="chart-line" d="M0 160 C100 150 150 120 200 128 C280 140 340 70 400 82 C470 96 530 48 600 54"/>
              <circle class="chart-dot" cx="300" cy="105" r="4"/>
            </svg>
          </div>
          <div class="bento-copy">
            <h3>Health your team can explain</h3>
            <p>See which accounts need attention and the customer evidence behind each change. AI commentary stays separate from the health history.</p>
          </div>
        </article>

        <article class="bento-card">
          <div class="bento-visual outcome-stage">
            <div class="outcome-board outcome-timeline">
              <div class="outcome-event"><span class="outcome-state">1</span><p><strong>Evidence gathered</strong><small>Knowledge, history, and sources</small></p></div>
              <div class="outcome-event"><span class="outcome-state">2</span><p><strong>Draft reviewed</strong><small>Edits and unresolved claims retained</small></p></div>
              <div class="outcome-event"><span class="outcome-state">3</span><p><strong>Human action recorded</strong><small>Exact message, channel, and actor</small></p></div>
            </div>
          </div>
          <div class="bento-copy">
            <h3>Know why an outcome happened</h3>
            <p>Trace the customer evidence, draft changes, reviewer decisions, and final human action behind every result.</p>
          </div>
        </article>

        <article class="bento-card">
          <div class="bento-visual outcome-stage">
            <div class="outcome-board">
              <ul class="feature-review-list">
                <li class="is-ok">Recommendation tied to Account evidence</li>
                <li class="is-ok">Manager decision stays attributable</li>
                <li class="is-warn">Observed outcome is not presented as cause</li>
              </ul>
            </div>
          </div>
          <div class="bento-copy">
            <h3>Human-owned retention work</h3>
            <p>Turn recurring support evidence into an intervention your team can approve, complete, abandon, and later review against observed outcomes.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="quote-section" id="quote" aria-labelledby="trust-title">
    <blockquote>
      <p>AI prepares the work. Your team owns the answer.</p>
      <footer>
        <span class="quote-mark" aria-hidden="true">N</span>
        <cite>
          <strong id="trust-title">Human-controlled communication</strong>
          <span>Review the evidence, change the wording, and deliberately send the final message yourself.</span>
        </cite>
      </footer>
    </blockquote>
  </section>

