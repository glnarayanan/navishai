<% content_for :title, "NavishAI — Support and Customer Success crews" %>

<main class="landing">
  <section class="landing-hero" id="hero" aria-labelledby="hero-title">
    <div class="landing-hero-wash" aria-hidden="true"></div>
    <div class="landing-hero-inner">
      <p class="landing-badge">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path fill="currentColor" d="M7.63 1.1A.87.87 0 0 1 8 1c.13 0 .26.03.37.1l5.25 3c.23.13.38.37.38.64s-.15.51-.38.64L8.37 8.4A.87.87 0 0 1 8 8.5a.87.87 0 0 1-.37-.1L2.38 5.4A.75.75 0 0 1 2 4.75c0-.27.15-.51.38-.64l5.25-3z"/>
          <path fill="currentColor" d="M2.57 7.24 2.38 7.35A.75.75 0 0 0 2 8c0 .27.15.51.38.64l5.25 3c.11.06.24.1.37.1s.26-.04.37-.1l5.25-3A.75.75 0 0 0 14 8a.75.75 0 0 0-.38-.65l-.19-.11-4.31 2.46A2.6 2.6 0 0 1 8 10a2.6 2.6 0 0 1-1.12-.3L2.57 7.24z"/>
          <path fill="currentColor" d="M2.38 10.6 2.57 10.49 6.88 12.95c.34.2.73.3 1.12.3s.78-.1 1.12-.3l4.31-2.46.19.11c.23.13.38.37.38.64s-.15.51-.38.64L8.37 14.9A.87.87 0 0 1 8 15a.87.87 0 0 1-.37-.1L2.38 11.9A.75.75 0 0 1 2 11.25c0-.27.15-.51.38-.64z"/>
        </svg>
        Open source and self-hosted
      </p>
      <div class="landing-hero-copy">
        <h1 id="hero-title">Specialist AI crews<br>for customer operations</h1>
        <p>Investigate, retrieve, and draft with evidence. A signed-in human still reviews every customer message and presses Send.</p>
      </div>
      <div class="landing-actions">
        <%= link_to "Sign in", new_session_path, class: "button button-primary" %>
        <a href="#how-it-works" class="button button-secondary" data-action="landing-header#jump">See how it works</a>
      </div>
    </div>
    <figure class="hero-media" aria-label="Case workspace preview">
      <div class="hero-media-frame">
        <div class="product-preview">
          <div class="product-preview-bar">
            <span class="product-stage-dot"></span>
            <span class="product-stage-dot"></span>
            <span class="product-stage-dot"></span>
            <span>Customer Operations · Cases</span>
          </div>
          <div class="product-preview-body">
            <aside class="product-preview-rail">
              <article class="stage-row is-current"><strong>Invoice webhook retry</strong><small>Investigating · High</small></article>
              <article class="stage-row"><strong>SSO domain mismatch</strong><small>Draft ready</small></article>
              <article class="stage-row"><strong>Renewal risk: Northwind</strong><small>Waiting internally</small></article>
            </aside>
            <div class="product-preview-main">
              <div class="stage-message"><strong>Maya Chen</strong><span>The webhook still returns 401 after we rotated the secret. Can you confirm whether the new key is live?</span></div>
              <div class="stage-draft">
                <strong>Draft ready for human send</strong>
                <span>The secret rotation completed at 14:02. The 401 is from the previous signing key still cached on one worker.</span>
                <span class="button button-primary" aria-hidden="true">Send email</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </figure>
  </section>

  <section class="proof-section" id="proof" aria-labelledby="proof-title">
    <p id="proof-title" class="proof-kicker">The operating surface you can turn on</p>
    <div class="proof-grid">
      <% [
        ["Shared email", "Inboxes land on Accounts, Contacts, and a case.", "#how-it-works"],
        ["Intercom", "Two-way sync beside the native conversation.", "#faq"],
        ["Webhooks", "Notify other systems from attributable events.", "#self-host"],
        ["Knowledge", "Approved sources stay cited beside the draft.", "#features"],
        ["Memory", "Scoped records carry source, time, and supersession.", "#how-it-works"],
        ["Scorecard", "Deterministic health with inspectable weights.", "#features"],
        ["Scripted runner", "Go owns process lifecycle, not Rails.", "#self-host"],
        ["Human send", "No agent, job, or approval can send later.", "#quote"]
      ].each do |name, detail, href| %>
        <a class="proof-cell" href="<%= href %>" data-action="landing-header#jump">
          <span class="proof-mark"><%= name %></span>
          <span class="proof-more"><%= detail %> <span aria-hidden="true">→</span></span>
        </a>
      <% end %>
    </div>
  </section>

  <section id="how-it-works" class="bento-section" aria-labelledby="bento-title">
    <div class="section-frame">
      <div class="section-hatch section-hatch-start" aria-hidden="true"></div>
      <div class="section-hatch section-hatch-end" aria-hidden="true"></div>
      <header class="section-header">
        <h2 id="bento-title">Work stays attributable from intake to send</h2>
        <p>Ask the crew to investigate, retrieve, and draft. Sending remains a fresh human command.</p>
      </header>
      <div class="bento-grid">
        <article class="bento-card" data-controller="bento-reason">
          <div class="bento-visual" data-bento-reason-target="stage">
            <div class="reason-stack" data-bento-reason-target="stack">
              <div class="reason-human">
                <p>The webhook still 401s after the secret rotation. Can we send a reply yet?</p>
                <span class="reason-avatar" aria-hidden="true">MC</span>
              </div>
              <div class="reason-agent">
                <span class="reason-mark" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.2 13.4 4.3v7.4L8 14.8 2.6 11.7V4.3L8 1.2Z"/></svg>
                </span>
                <div class="reason-bubble">
                  <div class="typing-dots" data-bento-reason-target="dots" aria-hidden="true"><span></span><span></span><span></span></div>
                  <div class="reason-response" data-bento-reason-target="response" hidden>
                    <p class="reason-label">Reasoning</p>
                    <p>The worker cache still holds the previous signing key. Knowledge cites the rotation runbook. The draft is ready. Sending still needs you.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="bento-copy">
            <h3>Case work with a human send</h3>
            <p>Crews prepare cited drafts. Sending is a fresh, authenticated human command, never a standing permission.</p>
          </div>
        </article>

        <article class="bento-card">
          <div class="bento-visual orbit-stage" aria-hidden="true">
            <div class="orbit-fade orbit-fade-top"></div>
            <div class="orbit-fade orbit-fade-bottom"></div>
            <div class="orbit-cluster">
              <div class="orbit-core">
                <svg width="28" height="28" viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.2 13.4 4.3v7.4L8 14.8 2.6 11.7V4.3L8 1.2Z"/></svg>
              </div>
              <div class="orbit-ring orbit-ring-inner">
                <span class="orbit-icon" title="Shared email"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 6.75A2.75 2.75 0 0 1 5.75 4h12.5A2.75 2.75 0 0 1 21 6.75v10.5A2.75 2.75 0 0 1 18.25 20H5.75A2.75 2.75 0 0 1 3 17.25V6.75Zm2.2.5 6.2 4.4a1 1 0 0 0 1.2 0l6.2-4.4H5.2Zm13.05 1.66-6.05 4.3a2.5 2.5 0 0 1-3 0L3.75 8.91v8.34c0 .69.56 1.25 1.25 1.25h14c.69 0 1.25-.56 1.25-1.25V8.91Z"/></svg></span>
                <span class="orbit-icon" title="Intercom"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 5.75A2.75 2.75 0 0 1 7.75 3h8.5A2.75 2.75 0 0 1 19 5.75v7.5A2.75 2.75 0 0 1 16.25 16H13l-3.4 3.4A1 1 0 0 1 8 18.7V16H7.75A2.75 2.75 0 0 1 5 13.25v-7.5Z"/></svg></span>
                <span class="orbit-icon" title="Webhooks"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13 3.5 6.2 13.2A1.5 1.5 0 0 0 7.45 15.5H11v5l6.8-9.7A1.5 1.5 0 0 0 16.55 8.5H13V3.5Z"/></svg></span>
              </div>
              <div class="orbit-ring orbit-ring-mid">
                <span class="orbit-icon" title="Knowledge"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.5 4.5A2.5 2.5 0 0 0 4 7v11.25c0 .97.78 1.75 1.75 1.75H18.5v-1.5H5.75a.25.25 0 0 1-.25-.25V7A1 1 0 0 1 6.5 6h12V18h1.5V4.5H6.5Z"/></svg></span>
                <span class="orbit-icon" title="Memory"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5 2.5 2.5 0 0 1 17.5 10h-11A2.5 2.5 0 0 1 4 7.5Zm2 6A2.5 2.5 0 0 1 8.5 11h7a2.5 2.5 0 0 1 0 5h-7A2.5 2.5 0 0 1 6 13.5Zm2 6A2.5 2.5 0 0 1 10.5 17h3a2.5 2.5 0 0 1 0 5h-3A2.5 2.5 0 0 1 8 19.5Z"/></svg></span>
                <span class="orbit-icon" title="Scorecard"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 19.5h16v-1.5H5.5V5H4v14.5ZM8 16h1.5v-5H8v5Zm4 0h1.5V8H12v8Zm4 0h1.5v-8H16v8Z"/></svg></span>
              </div>
              <div class="orbit-ring orbit-ring-outer">
                <span class="orbit-icon" title="Go runner"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l11-6.5L8 5.5Z"/></svg></span>
                <span class="orbit-icon" title="PostgreSQL"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 4.5h10A3.5 3.5 0 0 1 20.5 8v8A3.5 3.5 0 0 1 17 19.5H7A3.5 3.5 0 0 1 3.5 16V8A3.5 3.5 0 0 1 7 4.5Zm1.5 4v7h2V12h3v3.5h2v-7h-2V10h-3V8.5h-2Z"/></svg></span>
                <span class="orbit-icon" title="Supermemory"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3.5 19.5 8v8L12 20.5 4.5 16V8L12 3.5Zm0 2.3L6.5 9v6L12 18.2 17.5 15V9L12 5.8Z"/></svg></span>
              </div>
            </div>
          </div>
          <div class="bento-copy">
            <h3>Approved integrations, not a free-for-all</h3>
            <p>Email, Intercom, webhooks, knowledge, memory, and the runner stay inside the registry Admins approve.</p>
          </div>
        </article>

        <article class="bento-card" data-controller="health-chart">
          <div class="bento-visual health-stage">
            <div class="health-tooltip" data-health-chart-target="tooltip">72</div>
            <span class="health-stem" data-health-chart-target="stem" aria-hidden="true"></span>
            <svg class="health-chart" viewBox="0 0 600 200" role="img" aria-label="Account health trend">
              <defs>
                <linearGradient id="health-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--secondary)" stop-opacity="0.3"/>
                  <stop offset="100%" stop-color="var(--secondary)" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path class="chart-fill" data-health-chart-target="fill" d="M0 160 C100 150 150 120 200 128 C280 140 340 70 400 82 C470 96 530 48 600 54 L600 200 L0 200 Z"/>
              <path class="chart-line" data-health-chart-target="line" d="M0 160 C100 150 150 120 200 128 C280 140 340 70 400 82 C470 96 530 48 600 54"/>
              <circle class="chart-dot" data-health-chart-target="dot" cx="300" cy="105" r="4"/>
              <circle class="chart-pulse" cx="300" cy="105" r="10"/>
              <circle class="chart-pulse chart-pulse-2" cx="300" cy="105" r="10"/>
              <circle class="chart-pulse chart-pulse-3" cx="300" cy="105" r="10"/>
            </svg>
          </div>
          <div class="bento-copy">
            <h3>Account health you can inspect</h3>
            <p>Deterministic signals keep their source and weight. AI narrative is labeled as analysis, not as a hidden score.</p>
          </div>
        </article>

        <article class="bento-card" data-controller="spring-cards">
          <div class="bento-visual stack-stage" data-action="mousemove->spring-cards#move mouseleave->spring-cards#reset">
            <div class="stack-grid" aria-hidden="true"></div>
            <div class="stack-days" aria-hidden="true"><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
            <div class="stack-cursor" data-spring-cards-target="cursor">
              <span>Human send</span>
            </div>
            <div class="stack-cards">
              <div class="stack-card stack-card-1" data-spring-cards-target="card">Human send</div>
              <div class="stack-card stack-card-2" data-spring-cards-target="card">Evidence review</div>
              <div class="stack-card stack-card-3" data-spring-cards-target="card">Crew draft</div>
            </div>
          </div>
          <div class="bento-copy">
            <h3>Memory with a paper trail</h3>
            <p>Scoped records carry source, time, and supersession. If memory is down, NavishAI says so and keeps the rest of the case moving.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="quote-section" id="quote" aria-labelledby="principle-title">
    <blockquote>
      <p>Agents investigate, draft, and recommend. A human presses Send.</p>
      <footer>
        <span class="quote-mark" aria-hidden="true">N</span>
        <cite>
          <strong id="principle-title">NavishAI design rule</strong>
          <span>No agent, background job, or earlier approval can send, schedule, or trigger a customer message.</span>
        </cite>
      </footer>
    </blockquote>
  </section>

  <section id="features" class="feature-section" aria-labelledby="features-title" data-controller="feature-cycle">
    <header class="section-header section-header-plain">
      <h2 id="features-title">From inbox to attributed send</h2>
      <p>Four steps. Same evidence, memory, and review rules on Support cases and account health.</p>
      <button type="button" class="feature-pause" data-feature-cycle-target="pause" data-action="feature-cycle#togglePause" aria-pressed="false">
        Pause slideshow
      </button>
    </header>
    <div class="feature-cycle">
      <div class="feature-desktop">
        <ul class="feature-list" role="tablist" aria-label="Workflow steps">
          <% features = [
            ["Receive and identify", "Shared email and Intercom land on Accounts, Contacts, and a case with a recorded state change."],
            ["Investigate with evidence", "Crews pull current records, approved knowledge, scoped memory, and read-only public-web results."],
            ["Review the draft", "Policy review surfaces missing evidence, stale sources, and conflicts before anyone can send."],
            ["Send as yourself", "A signed-in human edits the draft and presses Send. The ledger stores who sent what, where, and when."]
          ] %>
          <% features.each_with_index do |(title, body), index| %>
            <li>
              <button type="button" class="feature-item<%= " is-active" if index.zero? %>" role="tab"
                id="workflow-tab-<%= index %>" aria-controls="workflow-panel-<%= index %>"
                aria-selected="<%= index.zero? %>" tabindex="<%= index.zero? ? 0 : -1 %>" data-feature-cycle-target="item" data-feature-index="<%= index %>"
                data-action="feature-cycle#select keydown->feature-cycle#keyselect">
                <span class="feature-rail" aria-hidden="true"><span class="feature-line" data-feature-cycle-target="line"></span></span>
                <h3><%= title %></h3>
                <p><%= body %></p>
              </button>
            </li>
          <% end %>
        </ul>
        <div class="feature-stage">
          <% features.each_with_index do |(title, _body), index| %>
            <article class="feature-panel<%= " is-active" if index.zero? %>" id="workflow-panel-<%= index %>" role="tabpanel"
              aria-labelledby="workflow-tab-<%= index %>" tabindex="<%= index.zero? ? 0 : -1 %>" data-feature-cycle-target="panel" <%= "hidden" unless index.zero? %>>
              <div class="feature-canvas feature-visual-<%= index %>">
                <div class="feature-canvas-inner">
                <% if index.zero? %>
                  <span class="feature-chip">Shared email</span>
                  <span class="feature-chip">Intercom</span>
                  <div class="feature-inbox-row is-new"><strong>New case</strong><small>Invoice webhook retry</small></div>
                  <div class="feature-inbox-row"><strong>Account linked</strong><small>Acme · Maya Chen</small></div>
                <% elsif index == 1 %>
                  <div class="feature-evidence-card"><strong>Knowledge</strong><small>Rotation runbook · current</small></div>
                  <div class="feature-evidence-card"><strong>Memory</strong><small>Prior 401 after secret change</small></div>
                  <div class="feature-evidence-card is-web"><strong>Public web</strong><small>Cited, untrusted until reviewed</small></div>
                <% elsif index == 2 %>
                  <p class="feature-chip">Policy review</p>
                  <ul class="feature-review-list">
                    <li class="is-ok">Evidence cited beside the draft</li>
                    <li class="is-warn">Stale article flagged for review</li>
                    <li class="is-ok">Send still requires a human</li>
                  </ul>
                <% else %>
                  <div class="feature-send-card">
                    <strong>Ready to send as you</strong>
                    <span>The ledger will record the human, channel, and time. No agent can press this.</span>
                    <span class="button button-primary">Send email</span>
                  </div>
                <% end %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      </div>
      <div class="feature-mobile">
        <div class="feature-mobile-stage">
          <% features.each_with_index do |(_title, _body), index| %>
            <div class="feature-mobile-canvas feature-visual-<%= index %><%= " is-active" if index.zero? %>" data-feature-cycle-target="mobileCanvas" <%= "hidden" unless index.zero? %>>
              <div class="feature-canvas-inner">
              <% if index.zero? %>
                <span class="feature-chip">Shared email</span>
                <span class="feature-chip">Intercom</span>
                <div class="feature-inbox-row is-new"><strong>New case</strong><small>Invoice webhook retry</small></div>
                <div class="feature-inbox-row"><strong>Account linked</strong><small>Acme · Maya Chen</small></div>
              <% elsif index == 1 %>
                <div class="feature-evidence-card"><strong>Knowledge</strong><small>Rotation runbook · current</small></div>
                <div class="feature-evidence-card"><strong>Memory</strong><small>Prior 401 after secret change</small></div>
                <div class="feature-evidence-card is-web"><strong>Public web</strong><small>Cited, untrusted until reviewed</small></div>
              <% elsif index == 2 %>
                <p class="feature-chip">Policy review</p>
                <ul class="feature-review-list">
                  <li class="is-ok">Evidence cited beside the draft</li>
                  <li class="is-warn">Stale article flagged for review</li>
                  <li class="is-ok">Send still requires a human</li>
                </ul>
              <% else %>
                <div class="feature-send-card">
                  <strong>Ready to send as you</strong>
                  <span>The ledger will record the human, channel, and time.</span>
                </div>
              <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <ul class="feature-carousel" data-feature-cycle-target="carousel">
          <% features.each_with_index do |(title, body), index| %>
            <li class="card<%= " is-active" if index.zero? %>" data-feature-cycle-target="card">
              <button type="button" data-feature-index="<%= index %>" data-action="feature-cycle#select">
                <span class="feature-rail" aria-hidden="true"><span class="feature-line" data-feature-cycle-target="mobileLine"></span></span>
                <h3><%= title %></h3>
                <p><%= body %></p>
              </button>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </section>

  <section id="self-host" class="growth-section" aria-labelledby="host-title">
    <div class="section-frame">
      <div class="section-hatch section-hatch-start" aria-hidden="true"></div>
      <div class="section-hatch section-hatch-end" aria-hidden="true"></div>
      <header class="section-header">
        <h2 id="host-title">Built for self-hosted control</h2>
        <p>Run it on infrastructure you operate. PostgreSQL stays authoritative. Security is a posture you can inspect, not a certificate we claim.</p>
      </header>
      <div class="growth-grid">
        <article class="growth-panel">
          <div class="growth-visual shield-visual" aria-hidden="true">
            <svg class="shield-outer" viewBox="0 0 265 268">
              <path fill="currentColor" fill-rule="evenodd" d="M121.384 4.5393C124.406 1.99342 128.319 0.585938 132.374 0.585938C136.429 0.585938 140.342 1.99342 143.365 4.5393C173.074 29.6304 210.174 45.6338 249.754 50.4314C253.64 50.9018 257.221 52.6601 259.855 55.3912C262.489 58.1223 264.005 61.6477 264.13 65.3354C265.616 106.338 254.748 146.9 232.782 182.329C210.816 217.759 178.649 246.61 140.002 265.547C137.645 266.701 135.028 267.301 132.371 267.298C129.715 267.294 127.1 266.686 124.747 265.526C86.0991 246.59 53.9325 217.739 31.9665 182.309C10.0005 146.879 -0.867679 106.317 0.618784 65.3147C0.748654 61.6306 2.26627 58.1102 4.9001 55.3833C7.53394 52.6565 11.1121 50.9012 14.9945 50.4314C54.572 45.6396 91.6716 29.6435 121.384 4.56V4.5393Z"/>
            </svg>
            <svg class="shield-inner" viewBox="0 0 81 80">
              <path fill="currentColor" fill-rule="evenodd" d="M20.5 36V28C20.5 22.7 22.6 17.6 26.4 13.9C30.1 10.1 35.2 8 40.5 8C45.8 8 50.9 10.1 54.6 13.9C58.4 17.6 60.5 22.7 60.5 28V36C62.6 36 64.7 36.8 66.2 38.3C67.7 39.8 68.5 41.9 68.5 44V64C68.5 66.1 67.7 68.2 66.2 69.7C64.7 71.2 62.6 72 60.5 72H20.5C18.4 72 16.3 71.2 14.8 69.7C13.3 68.2 12.5 66.1 12.5 64V44C12.5 41.9 13.3 39.8 14.8 38.3C16.3 36.8 18.4 36 20.5 36ZM52.5 28V36H28.5V28C28.5 24.8 29.8 21.8 32 19.5C34.3 17.3 37.3 16 40.5 16C43.7 16 46.7 17.3 49 19.5C51.2 21.8 52.5 24.8 52.5 28Z"/>
            </svg>
            <div class="shield-grid" data-controller="flickering-grid" data-flickering-grid-max-opacity-value="0.5" data-flickering-grid-square-size-value="2" data-flickering-grid-grid-gap-value="4">
              <canvas></canvas>
            </div>
          </div>
          <h3>Security you can inspect</h3>
          <p>NavishAI is designed so a later SOC 2 or ISO review has evidence to inspect. It does not claim SOC 2, HIPAA, ISO 27001, or any other certification.</p>
        </article>
        <article class="growth-panel">
          <div class="growth-visual globe-visual" aria-hidden="true">
            <div class="globe">
              <span class="globe-atmosphere"></span>
              <span class="globe-highlight"></span>
              <span class="globe-ring"></span>
              <span class="globe-ring globe-ring-2"></span>
              <span class="globe-ring globe-ring-3"></span>
              <span class="globe-meridian"></span>
              <span class="globe-meridian globe-meridian-2"></span>
              <span class="globe-meridian globe-meridian-3"></span>
              <span class="globe-equator"></span>
              <span class="globe-equator globe-equator-2"></span>
              <span class="globe-dot globe-dot-1"></span>
              <span class="globe-dot globe-dot-2"></span>
              <span class="globe-dot globe-dot-3"></span>
              <span class="globe-dot globe-dot-4"></span>
