        <div>
          <h3>Trust</h3>
          <ul>
            <li><a href="#quote" data-action="landing-header#jump">Human control</a></li>
            <li><a href="#proof" data-action="landing-header#jump">Built-in context</a></li>
            <li><a href="#faq" data-action="landing-header#jump">Product boundaries</a></li>
            <li><a href="#hero" data-action="landing-header#jump">Overview</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-signoff">
      <span aria-hidden="true">NavishAI</span>
    </div>
