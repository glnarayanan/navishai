<% content_for :title, "Eval case #{@eval_case.id} — NavishAI" %>
<main class="page-shell">
  <%= link_to "Scenario version #{@version.number}", workspace_corpus_scenario_path(Current.workspace, @corpus, @version.scenario_id, version: @version.number), class: "back-link" %>
  <div class="page-heading"><div><h1><%= @version.title %></h1><p>Eval case #<%= @eval_case.id %> · definition <%= @eval_case.number %> · <%= @eval_case.compiler_version %></p></div></div>
  <p>Compiled by expert #<%= @eval_case.compiled_by_id %>, with approval #<%= @eval_case.scenario_review_id %>. This is a fixed definition, not a run result.</p>
  <div class="review-layout">
    <section><h2>Behavioural contract</h2><% @checks.each do |check| %><article class="source-record"><h3><%= check.requirement_kind.humanize %></h3><p><%= check.requirement %></p><p><%= link_to "#{check.grader_version.grader.name} · version #{check.grader_version.number}", workspace_corpus_grader_path(Current.workspace, @corpus, check.grader_version.grader_id, version: check.grader_version.number) %></p><pre class="evidence-text"><%= JSON.pretty_generate(check.grader_version.definition) %></pre><%= link_to "Supporting source snapshot", source_evidence_path(check.scenario_evidence.corpus_item) %><pre class="evidence-text"><%= check.scenario_evidence.excerpt %></pre></article><% end %></section>
    <section><h2>Target-visible input</h2><p>Only the starting situation, known facts and expert-permitted knowledge. No title, hidden-fact or expectation fields. Check that this starting context does not give away the answer.</p><pre class="evidence-text"><%= JSON.pretty_generate(@version.target_input) %></pre></section>
  </div>
  <%= render "conversation_plan", version: @version %>
  <% if Current.require_membership!.can_write? %><section class="section-block config-panel"><h2>Add to a suite</h2><% if @suites.empty? %><p><%= link_to "Create an eval suite", workspace_corpus_eval_suites_path(Current.workspace, @corpus) %>, then add this case.</p><% else %><p>Adding an old, rejected or stale version fails. Suites contain at most 50 cases.</p><% @suites.each do |suite| %><%= button_to "Add to #{suite.name}", workspace_corpus_eval_suite_path(Current.workspace, @corpus, suite), method: :patch, params: { case_id: @eval_case.id }, class: "button" %><% end %><% end %></section><% end %>
</main>
