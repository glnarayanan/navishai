<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="reset-title">
    <div class="page-heading">
      <h1 id="reset-title">Reset your password</h1>
      <p>We’ll email a reset link if the address belongs to an account.</p>
    </div>

    <%= form_with url: passwords_path, class: "form-stack" do |form| %>
      <div class="field">
        <%= form.label :email_address, "Email address" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
      </div>
      <%= form.submit "Email reset link", class: "button button-primary" %>
    <% end %>
    <p class="panel-foot"><%= link_to "Back to sign in", new_session_path %></p>
  </section>
</main>
