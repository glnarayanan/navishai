<% content_for :title, "Choose a new password — NavishAI" %>

<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="password-title">
    <div class="page-heading">
      <h1 id="password-title">Choose a new password</h1>
      <p>Use at least 12 characters.</p>
    </div>

    <%= form_with url: password_path(token: params[:token]), method: :put, class: "form-stack" do |form| %>
      <div class="field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
      </div>
      <%= form.submit "Save password", class: "button button-primary" %>
    <% end %>
  </section>
</main>
