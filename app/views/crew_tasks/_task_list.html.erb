<nav class="crew-task-list" aria-label="Crew tasks">
  <% if tasks.any? %>
    <% tasks.each do |task| %>
      <%= link_to workspace_support_case_crew_task_path(@workspace, @support_case, task),
        class: ["crew-task-list-item", ("is-current" if @task == task)] do %>
        <span class="crew-task-list-copy">
          <strong><%= task.title %></strong>
          <small><%= task.assigned_agent_profile.name %></small>
        </span>
        <span class="task-status task-status-<%= task.status.dasherize %>"><%= task.status.humanize %></span>
      <% end %>
    <% end %>
  <% else %>
    <p class="muted-copy">No crew tasks yet.</p>
  <% end %>
</nav>
