<% content_for :title, "#{@task.title} · Crew work — NavishAI" %>

<main class="crew-work-page">
  <header class="crew-work-header crew-task-header">
    <%= link_to "Back to crew work", workspace_support_case_crew_tasks_path(@workspace, @support_case), class: "back-link" %>
    <div>
      <h1><%= @task.title %></h1>
      <p><strong><%= @task.assigned_agent_profile.name %></strong> · Task <%= @task.task_key.first(8) %></p>
      <p><%= @task.expected_output %></p>
    </div>
    <span class="task-status task-status-<%= @task.status.dasherize %>"><%= @task.status.humanize %></span>
  </header>

  <% if @command_error %>
    <div class="inline-error" role="alert"><strong>Work record not changed</strong><p><%= @command_error %></p></div>
  <% end %>

  <div class="crew-task-detail-grid">
    <aside class="crew-work-panel crew-task-rail">
      <div class="crew-work-panel-heading"><h2>Case plan</h2><span><%= @tasks.size %></span></div>
      <%= render "task_list", tasks: @tasks %>
    </aside>

    <section class="crew-work-panel" aria-labelledby="work-record-title">
      <div class="crew-work-panel-heading">
        <h2 id="work-record-title">Work record</h2>
        <span>v<%= @task.current_event.sequence_number %></span>
      </div>
      <% if @task.dependencies.any? %>
        <div class="crew-task-dependency-summary">
          <strong>Depends on</strong>
          <ul>
            <% @task.dependencies.each do |dependency| %>
              <li><%= link_to dependency.title, workspace_support_case_crew_task_path(@workspace, @support_case, dependency) %> · <%= dependency.status.humanize %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= render "execution_runs" %>
      <%= render "public_web_searches" %>
      <ol class="crew-event-list">
        <% @events.each do |event| %>
          <li>
            <div class="crew-event-mark" aria-hidden="true"></div>
            <article>
              <header>
                <strong><%= event.event_kind.humanize %></strong>
                <time datetime="<%= event.created_at.iso8601 %>"><%= event.created_at.to_fs(:short) %></time>
              </header>
              <p class="crew-event-attribution"><%= event.actor_user&.email_address || event.source.humanize %> · <%= event.to_agent_profile.name %></p>
              <% if event.from_status != event.to_status %><p><%= event.from_status&.humanize || "New task" %> → <%= event.to_status.humanize %></p><% end %>
              <% if event.from_agent_profile && event.from_agent_profile != event.to_agent_profile %><p><%= event.from_agent_profile.name %> → <%= event.to_agent_profile.name %></p><% end %>
              <% if event.body.present? %><div class="message-body"><%= simple_format(event.body) %></div><% end %>
              <% if event.evidence_locator.present? %><p class="crew-evidence-ref"><span><%= event.evidence_kind.humanize %></span><code><%= event.evidence_locator %></code></p><% end %>
              <% if event.review_outcome.present? %><p><strong>Decision:</strong> <%= event.review_outcome.humanize %></p><% end %>
            </article>
          </li>
        <% end %>
      </ol>
    </section>

    <aside class="crew-work-panel crew-task-actions" aria-labelledby="task-actions-title">
      <h2 id="task-actions-title">Next step</h2>
      <dl class="case-facts">
        <div><dt>Specialist</dt><dd><%= @task.assigned_agent_profile.name %></dd></div>
        <div><dt>Policy version</dt><dd>v<%= @task.assigned_agent_profile_version.version_number %></dd></div>
        <div><dt>Owner</dt><dd><%= @task.owner_user.email_address %></dd></div>
      </dl>
      <div class="crew-task-input">
        <strong>Input and scope</strong>
        <p><%= @task.input_context %></p>
      </div>
      <% if @membership.can_write? %>
        <% expected = @task.current_event.sequence_number %>
        <% if @task.ready? %>
          <%= button_to "Start task", command_workspace_support_case_crew_task_path(@workspace, @support_case, @task),
            params: { command_name: "start", expected_sequence: expected }, class: "button button-primary" %>
        <% elsif @task.pending? %>
          <p class="muted-copy">This task starts when every dependency is complete.</p>
        <% elsif @task.blocked? %>
          <%= button_to "Resume task", command_workspace_support_case_crew_task_path(@workspace, @support_case, @task),
            params: { command_name: "resume", expected_sequence: expected }, class: "button button-primary" %>
        <% elsif @task.failed? %>
          <%= form_with url: command_workspace_support_case_crew_task_path(@workspace, @support_case, @task), class: "crew-command-form" do |form| %>
            <%= form.hidden_field :command_name, value: "retry", id: nil %><%= form.hidden_field :expected_sequence, value: expected, id: nil %>
            <div class="field"><%= form.label :body, "Why retry?", for: "task-retry-body" %><%= form.text_area :body, id: "task-retry-body", required: true, rows: 3 %></div>
            <%= form.submit "Retry task", class: "button button-primary" %>
          <% end %>
        <% end %>

        <% unless @task.completed? || @task.canceled? %>
          <details class="crew-command-group" open>
            <summary>Add to the record</summary>
            <%= form_with url: command_workspace_support_case_crew_task_path(@workspace, @support_case, @task), class: "crew-command-form" do |form| %>
              <%= form.hidden_field :command_name, value: "comment", id: nil %><%= form.hidden_field :expected_sequence, value: expected, id: nil %>
              <div class="field"><%= form.label :body, "Comment", for: "task-comment-body" %><%= form.text_area :body, id: "task-comment-body", required: true, rows: 3 %></div>
              <%= form.submit "Add comment", class: "button button-secondary" %>
            <% end %>
            <%= form_with url: command_workspace_support_case_crew_task_path(@workspace, @support_case, @task), class: "crew-command-form" do |form| %>
              <%= form.hidden_field :command_name, value: "add_evidence", id: nil %><%= form.hidden_field :expected_sequence, value: expected, id: nil %>
              <div class="field"><%= form.label :evidence_kind, "Evidence type", for: "task-evidence-kind" %><%= form.select :evidence_kind, CrewTaskEvent::EVIDENCE_KINDS.map { |kind| [kind.humanize, kind] }, {}, id: "task-evidence-kind" %></div>
              <div class="field"><%= form.label :evidence_locator, "Stable reference", for: "task-evidence-locator" %><%= form.text_field :evidence_locator, id: "task-evidence-locator", required: true, maxlength: 2_000 %></div>
              <div class="field"><%= form.label :body, "What it supports", for: "task-evidence-body" %><%= form.text_area :body, id: "task-evidence-body", required: true, rows: 3 %></div>
              <%= form.submit "Add evidence", class: "button button-secondary" %>
            <% end %>
          </details>

          <% if (@task.in_progress? || @task.blocked?) && @active_run.nil? %>
            <details class="crew-command-group">
              <summary>Handoff or outcome</summary>
              <%= form_with url: command_workspace_support_case_crew_task_path(@workspace, @support_case, @task), class: "crew-command-form" do |form| %>
                <%= form.hidden_field :command_name, value: "handoff", id: nil %><%= form.hidden_field :expected_sequence, value: expected, id: nil %>
                <div class="field"><%= form.label :agent_profile_id, "Hand off to", for: "task-handoff-profile" %><%= form.select :agent_profile_id, @profiles.reject { |profile| profile == @task.assigned_agent_profile }.map { |profile| [profile.name, profile.id] }, {}, id: "task-handoff-profile" %></div>
                <div class="field"><%= form.label :body, "Reason and expected output", for: "task-handoff-body" %><%= form.text_area :body, id: "task-handoff-body", required: true, rows: 3 %></div>
                <%= form.submit "Record handoff", class: "button button-secondary" %>
              <% end %>
              <% if @task.in_progress? %>
                <%= form_with url: command_workspace_support_case_crew_task_path(@workspace, @support_case, @task), class: "crew-command-form" do |form| %>
                  <%= form.hidden_field :command_name, value: "request_review", id: nil %><%= form.hidden_field :expected_sequence, value: expected, id: nil %>
                  <div class="field"><%= form.label :body, "What needs review", for: "task-review-request-body" %><%= form.text_area :body, id: "task-review-request-body", required: true, rows: 3 %></div>
                  <%= form.submit "Request review", class: "button button-primary" %>
                <% end %>
              <% end %>
            </details>
          <% elsif @task.review_requested? && @membership.can_manage_work? %>
            <%= form_with url: command_workspace_support_case_crew_task_path(@workspace, @support_case, @task), class: "crew-command-form crew-review-form" do |form| %>
              <%= form.hidden_field :command_name, value: "review", id: nil %><%= form.hidden_field :expected_sequence, value: expected, id: nil %>
              <div class="field"><%= form.label :review_outcome, "Decision", for: "task-review-outcome" %><%= form.select :review_outcome, [["Approve outcome", "approved"], ["Request changes", "changes_requested"]], {}, id: "task-review-outcome" %></div>
              <div class="field"><%= form.label :body, "Review record", for: "task-review-body" %><%= form.text_area :body, id: "task-review-body", required: true, rows: 4 %></div>
              <%= form.submit "Record decision", class: "button button-primary" %>
            <% end %>
          <% end %>
          <% outcome_commands = [] %>
          <% if @active_run.nil? %>
            <% outcome_commands << ["Mark blocked", "block"] if @task.ready? || @task.in_progress? %>
            <% outcome_commands << ["Record failure", "fail"] if @task.in_progress? || @task.blocked? || @task.review_requested? %>
            <% outcome_commands << ["Cancel task", "cancel"] unless @task.completed? || @task.canceled? %>
          <% end %>
          <% if outcome_commands.any? %>
            <details class="crew-command-group">
              <summary>Record a block or stop</summary>
              <%= form_with url: command_workspace_support_case_crew_task_path(@workspace, @support_case, @task), class: "crew-command-form" do |form| %>
                <%= form.hidden_field :expected_sequence, value: expected, id: nil %>
                <div class="field"><%= form.label :command_name, "Outcome", for: "task-stop-command" %><%= form.select :command_name, outcome_commands, {}, id: "task-stop-command" %></div>
                <div class="field"><%= form.label :body, "Reason", for: "task-stop-body" %><%= form.text_area :body, id: "task-stop-body", required: true, rows: 3 %></div>
                <%= form.submit "Record outcome", class: "button button-secondary" %>
              <% end %>
            </details>
          <% end %>
        <% end %>
      <% else %>
        <p class="read-only-notice">Read-only access. You can inspect every handoff, source, and decision.</p>
      <% end %>
    </aside>
  </div>
</main>
