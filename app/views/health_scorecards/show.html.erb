<% content_for :title, "Health scorecard — NavishAI" %>
<% definition = @selected_version.definition %>
<% proposal_open = @membership.can_write? && @backtest.blank? %>
<% preview_open = @backtest.present? %>
<% published_selected = @scorecard.current_version_id == @selected_version.id %>

<main class="scorecard-page">
  <header class="scorecard-heading">
    <div>
      <%= link_to "Accounts", workspace_accounts_path(@workspace), class: "back-link" %>
      <h1>Health scorecard</h1>
      <p>Shape a scoring proposal, test it against retained facts, then choose what future snapshots use.</p>
    </div>
  </header>

  <% if @command_error %>
    <%= render "shared/notice", kind: "destructive", title: "Scorecard not changed", body: @command_error %>
  <% end %>

  <section class="scorecard-decision" aria-label="Published scorecard versus this version">
    <article>
      <span>Published</span>
      <strong>Version <%= @scorecard.current_version.version_number %></strong>
      <p class="muted-copy">Scores future snapshots.</p>
    </article>
    <article>
      <span><%= published_selected ? "Current view" : "Proposal" %></span>
      <strong>Version <%= @selected_version.version_number %></strong>
      <p class="muted-copy"><%= published_selected ? "This is the live definition." : "Immutable until you publish." %></p>
    </article>
    <article>
      <span>Change</span>
      <% if @backtest %>
        <strong><%= @backtest.results.fetch("summary").fetch("changed_count") %></strong>
        <p class="muted-copy">scores moved in the last preview.</p>
      <% else %>
        <strong>Not previewed</strong>
        <p class="muted-copy">Run a backtest before publishing.</p>
      <% end %>
    </article>
  </section>

  <div class="scorecard-layout">
    <div class="scorecard-flow">
      <section class="scorecard-proposal" aria-labelledby="proposal-title">
        <header><div><h2 id="proposal-title">Current proposal</h2><p>This version is immutable. Edit by creating another proposal.</p></div></header>
        <div class="scorecard-proposal-head">
          <div>
            <span class="version-label"><%= published_selected ? "Published" : "Proposal" %></span>
            <h3>Version <%= @selected_version.version_number %></h3>
            <p><%= @selected_version.explanation %></p>
            <% if @selected_version.created_by_user %>
              <p class="scorecard-lineage">
                Designed by <%= @selected_version.created_by_user.email_address %>
                <% if @selected_version.source_proposal %>
                  · accepted from run <%= @selected_version.source_proposal.execution_run.run_key %>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>
        <ul class="scorecard-rule-cards">
          <% definition.fetch("rules").each do |rule| %>
            <li>
              <strong><%= @catalog.fetch(rule.fetch("signal_key")).fetch(:label) %></strong>
              <span>Up to <%= rule.fetch("weight") %> risk points</span>
            </li>
          <% end %>
          <li class="scorecard-band-card">
            <strong>Health bands</strong>
            <span>Healthy ≥ <%= definition.fetch("healthy_min") %> · Watch ≥ <%= definition.fetch("watch_min") %></span>
          </li>
        </ul>
      </section>

      <% if @membership.can_write? %>
        <section class="scorecard-ai" aria-labelledby="ai-proposal-title">
          <header>
            <div>
              <h2 id="ai-proposal-title">Ask for a constrained proposal</h2>
              <p>The model may suggest supported signals and weights. It never calculates authoritative health. Revise a proposal to keep parent and run lineage. Accepting is a separate action and still leaves the version unpublished.</p>
            </div>
          </header>
          <%= form_with url: generate_workspace_health_scorecard_path(@workspace), class: "scorecard-form" do |form| %>
            <% if @proposals.any? %>
              <%= hidden_field_tag :expected_latest_proposal_id, @proposals.first.id, id: "expected_latest_proposal_id_generate" %>
            <% end %>
            <div class="field scorecard-goal">
              <%= form.label :proposal_prompt, "What should this scorecard emphasise?" %>
              <%= form.text_area :proposal_prompt, required: true, minlength: 10, maxlength: 2000, rows: 3,
                placeholder: "Make approaching renewal and repeated SLA breaches matter more." %>
              <span class="field-hint">Plain language only. Unsupported requests such as call sentiment or churn prediction are reported, not invented.</span>
            </div>
            <%= form.submit "Generate AI proposal", class: "button button-primary" %>
          <% end %>

          <% if @pending_proposal_run %>
            <p class="muted-copy" role="status">A proposal run is in progress through the approved runtime. Scores are unchanged.</p>
          <% end %>

          <% if @proposals.any? %>
            <ul class="scorecard-ai-list">
              <% @proposals.each do |proposal| %>
                <%= render "ai_proposal", proposal: proposal %>
              <% end %>
            </ul>
          <% end %>
        </section>

        <details class="scorecard-designer scorecard-stage" name="scorecard-stage" <%= "open" if proposal_open %>>
          <summary>
            <span class="section-number">01</span>
            <span>
              <strong>Build proposal</strong>
              <small>Intent and signal mapping for a new immutable version.</small>
            </span>
          </summary>
          <%= form_with url: propose_workspace_health_scorecard_path(@workspace), class: "scorecard-form" do |form| %>
            <section aria-labelledby="intent-title">
              <header><span class="section-number">01</span><div><h2 id="intent-title">Intent</h2><p>Record what should drive risk. This text is the design prompt, not the score.</p></div></header>
              <div class="field scorecard-goal">
                <%= form.label :goal_prompt, "Scoring goal" %>
                <%= form.text_area :goal_prompt, value: @selected_version.design_prompt, required: true, minlength: 10, maxlength: 500, rows: 3,
                  placeholder: "Flag accounts with near renewals, low use, unresolved cases, and SLA breaches." %>
                <span class="field-hint">Keep this specific. The mapped signals below do the scoring.</span>
              </div>
            </section>

            <section aria-labelledby="mapping-title">
              <header><span class="section-number">02</span><div><h2 id="mapping-title">Signal mapping</h2><p>Choose only facts NavishAI retains and set their maximum risk points.</p></div></header>
              <fieldset class="scorecard-signal-map">
                <legend>Signal map</legend>
                <% @catalog.each do |key, item| %>
                  <% rule = definition.fetch("rules").find { |candidate| candidate.fetch("signal_key") == key } %>
                  <div class="scorecard-signal">
                    <label class="scorecard-signal-choice">
                      <%= check_box_tag "signals[#{key}][enabled]", "1", rule.present? %>
                      <span><strong><%= item.fetch(:label) %></strong><small><%= item.fetch(:detail) %></small></span>
                    </label>
                    <label>Max points
                      <%= number_field_tag "signals[#{key}][weight]", rule&.fetch("weight") || item.fetch(:default_weight), min: 0, max: 100, step: 1, inputmode: "numeric" %>
                    </label>
                  </div>
                <% end %>
              </fieldset>
              <fieldset class="scorecard-bands">
                <legend>Health bands</legend>
                <label>Healthy starts at <%= number_field_tag :healthy_min, definition.fetch("healthy_min"), min: 2, max: 99, required: true %></label>
                <label>Watch starts at <%= number_field_tag :watch_min, definition.fetch("watch_min"), min: 1, max: 98, required: true %></label>
                <span class="field-hint">Scores below the watch threshold are At risk.</span>
              </fieldset>
              <%= form.submit "Create proposal", class: "button button-primary" %>
            </section>
          <% end %>
        </details>
      <% end %>

      <details class="scorecard-preview scorecard-stage" id="preview" name="scorecard-stage" <%= "open" if preview_open %>>
        <summary>
          <span class="section-number">03</span>
          <span>
            <strong>Preview and backtest</strong>
            <small>
              <% if @backtest %>
                <%= pluralize(@backtest.sample_count, "snapshot") %> tested · <%= @backtest.results.fetch("summary").fetch("changed_count") %> scores changed
              <% else %>
                Compare this version with retained account snapshots.
              <% end %>
            </small>
          </span>
        </summary>
        <header><div><h2 id="preview-title">Preview and backtest</h2><p>This preview uses at most <%= HealthScorecardBacktester::MAX_SNAPSHOTS %> retained snapshots. Publishing never rewrites those past results.</p></div></header>
        <% if @backtest %>
          <% summary = @backtest.results.fetch("summary") %>
          <% current_rows = @backtest.results.fetch("current") %>
          <div class="scorecard-preview-stats">
            <div><strong><%= @backtest.sample_count %></strong><span>snapshots tested</span></div>
            <div><strong><%= summary.fetch("changed_count") %></strong><span>scores changed</span></div>
            <div><strong><%= summary.fetch("band_changed_count") %></strong><span>bands changed</span></div>
            <div><strong><%= summary.fetch("at_risk_count") %></strong><span>at risk</span></div>
          </div>
          <% if current_rows.any? %>
            <div class="table-scroll scorecard-compare-scroll" role="region" tabindex="0" aria-label="Score comparison by account">
              <table class="scorecard-compare-table">
                <thead><tr><th>Account</th><th>Published snapshot</th><th>Proposal</th><th>Change</th></tr></thead>
                <tbody>
                  <% current_rows.each do |row| %>
                    <tr>
                      <th scope="row"><%= row.fetch("account_name") %></th>
                      <td><%= row.fetch("existing_score") %> · <%= row.fetch("existing_risk_level").humanize %></td>
                      <td><strong><%= row.fetch("proposed_score") %> · <%= row.fetch("proposed_risk_level").humanize %></strong></td>
                      <td><%= row.fetch("proposed_score") - row.fetch("existing_score") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <ul class="scorecard-compare-cards">
              <% current_rows.each do |row| %>
                <li>
                  <h3><%= row.fetch("account_name") %></h3>
                  <dl>
                    <div><dt>Published snapshot</dt><dd><%= row.fetch("existing_score") %> · <%= row.fetch("existing_risk_level").humanize %></dd></div>
                    <div><dt>Proposal</dt><dd><%= row.fetch("proposed_score") %> · <%= row.fetch("proposed_risk_level").humanize %></dd></div>
                    <div><dt>Change</dt><dd><%= row.fetch("proposed_score") - row.fetch("existing_score") %></dd></div>
                  </dl>
                </li>
              <% end %>
            </ul>
          <% end %>
          <p class="scorecard-evidence">
            At most <%= summary.fetch("snapshot_limit", HealthScorecardBacktester::MAX_SNAPSHOTS) %> retained snapshots
            <% if summary["truncated"] %> · older snapshots were omitted<% end %>
            · evidence digest <code><%= @backtest.source_digest %></code>
            · <%= @backtest.generated_at.to_fs(:long) %>
          </p>
        <% else %>
          <div class="scorecard-empty">
            <div><strong>No preview for this version</strong><p>Test it against current accounts and retained history before publishing.</p></div>
          </div>
        <% end %>
      </details>
    </div>

    <aside class="stage-rail scorecard-sticky-preview" aria-label="Published state and history">
      <div class="stage-card" aria-label="Current published scorecard">
        <p class="text-label">Published</p>
        <p><strong>Version <%= @scorecard.current_version.version_number %></strong></p>
        <p class="muted-copy"><%= @scorecard.current_version.design_prompt %></p>
        <% if published_selected %>
          <p class="scorecard-published-notice"><strong>Version <%= @selected_version.version_number %> is published.</strong> New snapshots use these rules.</p>
        <% else %>
          <p class="muted-copy">Viewing a proposal — not yet published.</p>
        <% end %>
      </div>

      <div class="stage-card" id="sticky-preview">
        <p class="text-label">Preview</p>
        <% if @backtest %>
          <% summary = @backtest.results.fetch("summary") %>
          <dl class="case-facts">
            <div><dt>Snapshots</dt><dd><%= @backtest.sample_count %> of at most <%= HealthScorecardBacktester::MAX_SNAPSHOTS %></dd></div>
            <div><dt>Scores changed</dt><dd><%= summary.fetch("changed_count") %></dd></div>
            <div><dt>Bands changed</dt><dd><%= summary.fetch("band_changed_count") %></dd></div>
            <div><dt>At risk</dt><dd><%= summary.fetch("at_risk_count") %></dd></div>
          </dl>
        <% else %>
          <p class="muted-copy">Run a preview against retained snapshots before publishing.</p>
        <% end %>
        <% if @membership.can_write? %>
          <%= button_to @backtest ? "Refresh preview and backtest" : "Run preview and backtest",
            backtest_workspace_health_scorecard_path(@workspace),
            params: { version_id: @selected_version.id },
            class: "button button-secondary" %>
        <% end %>
      </div>

      <div class="stage-card">
        <p class="text-label">Publish</p>
        <% if @membership.can_configure_agents? && @backtest %>
          <% if @selected_version.source_proposal %>
            <p class="muted-copy">Accepted proposal <%= @selected_version.source_proposal.id %> still needs this inspected preview. Generate and accept never publish.</p>
          <% end %>
          <% if published_selected %>
            <p class="muted-copy">This version already scores future snapshots.</p>
          <% elsif @selected_version.version_number < @scorecard.current_version.version_number %>
            <%= button_to "Roll back to version #{@selected_version.version_number}", rollback_workspace_health_scorecard_path(@workspace), params: { version_id: @selected_version.id, expected_current_version_id: @scorecard.current_version_id, expected_backtest_id: @backtest.id }, class: "button button-danger" %>
          <% else %>
            <%= button_to "Publish version #{@selected_version.version_number}", publish_workspace_health_scorecard_path(@workspace), params: { version_id: @selected_version.id, expected_current_version_id: @scorecard.current_version_id, expected_backtest_id: @backtest.id }, class: "button button-primary" %>
          <% end %>
        <% else %>
          <p class="read-only-notice"><%= @backtest ? "You can review this version, but an Owner or Admin must publish it." : "Run a preview before this version can be published." %></p>
        <% end %>
      </div>

      <details class="scorecard-history setup-disclosure" <%= "open" if @versions.size <= 4 %>>
        <summary>Version history</summary>
        <p class="muted-copy">Every proposal, test, publish, and rollback remains in the audit trail.</p>
        <ol>
          <% @versions.each do |version| %>
            <li class="<%= "is-selected" if version.id == @selected_version.id %>">
              <%= link_to workspace_health_scorecard_path(@workspace, version_id: version.id) do %>
                <span><strong>Version <%= version.version_number %></strong><small><%= version.design_prompt %></small></span>
                <span><%= @scorecard.current_version_id == version.id ? "Published" : pluralize(version.backtests.size, "backtest") %></span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </details>
    </aside>
  </div>
</main>
