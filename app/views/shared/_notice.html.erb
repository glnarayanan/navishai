<%# locals: kind, title, body, extra %>
<% kind = local_assigns.fetch(:kind, "info") %>
<% role = %w[blocked destructive warning].include?(kind.to_s) ? "alert" : "status" %>
<aside class="notice notice-<%= kind %> <%= local_assigns[:css] %>" role="<%= role %>">
  <span class="notice-icon" aria-hidden="true">
    <% case kind.to_s %>
    <% when "success" %>
      <svg viewBox="0 0 16 16"><path fill="currentColor" d="M6.4 11.2 3.2 8l1.1-1.1 2.1 2.1 5.2-5.2 1.1 1.1z"/></svg>
    <% when "warning", "degraded" %>
      <svg viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.5 15 14H1L8 1.5zm0 4.2v4h1.2V5.7H8zm0 5.3v1.3h1.2V11H8z"/></svg>
    <% when "blocked", "destructive" %>
      <svg viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.5A6.5 6.5 0 1 1 1.5 8 6.5 6.5 0 0 1 8 1.5zm-.6 3h1.2v4.2H7.4zm0 5.3h1.2V13H7.4z"/></svg>
    <% when "review" %>
      <svg viewBox="0 0 16 16"><path fill="currentColor" d="M3 2.5h10v11H3zm1.4 1.4v8.2h7.2V3.9zm1.3 2h4.6v1.1H5.7zm0 2.2h4.6v1.1H5.7z"/></svg>
    <% else %>
      <svg viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.5A6.5 6.5 0 1 1 1.5 8 6.5 6.5 0 0 1 8 1.5zM7.4 7h1.2v5H7.4zm0-2.8h1.2V5.4H7.4z"/></svg>
    <% end %>
  </span>
  <div class="notice-body">
    <strong><%= title %></strong>
    <% if local_assigns[:body].present? %><p><%= body %></p><% end %>
    <%= extra if local_assigns[:extra] %>
  </div>
</aside>
