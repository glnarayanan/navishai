<section class="empty-state empty-state-<%= local_assigns.fetch(:kind, "info") %>">
  <h2><%= title %></h2>
  <p><%= description %></p>
  <% if local_assigns[:action_path].present? && local_assigns[:action_label].present? %>
    <%= link_to action_label, action_path, class: "button button-secondary" %>
  <% end %>
</section>
