<nav class="workspace-tabs" aria-label="Record pages">
  <% if page_number > 1 %><%= link_to "Previous records", url_for(request.query_parameters.merge(page: page_number - 1)) %><% end %>
  <% if more %><%= link_to "Next records", url_for(request.query_parameters.merge(page: page_number + 1)) %><% end %>
</nav>
