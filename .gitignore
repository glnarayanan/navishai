/.local-agent/
.amp/portals/*

# Ignore Bundler configuration.
/.bundle

# Ignore local environment files.
/.env*
!/.env.example
/ops/secrets/
/backups/

# Ignore runtime output while retaining directory placeholders.
/log/*
/storage/*
/tmp/*
!/log/.keep
!/storage/.keep
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
!/tmp/storage/
!/tmp/storage/.keep

# Ignore generated assets.
/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key
