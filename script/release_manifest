#!/usr/bin/env ruby
require "digest"
require "json"
require "open3"
require "time"

output = ARGV.shift || abort("usage: script/release_manifest OUTPUT.json ARTIFACT...")
abort "at least one artifact is required" if ARGV.empty?
missing = ARGV.reject { |path| File.file?(path) }
abort "missing artifact: #{missing.join(', ')}" if missing.any?

commit, status = Open3.capture2("git", "rev-parse", "HEAD")
abort "cannot resolve the source commit" unless status.success?
dirty, status = Open3.capture2("git", "status", "--porcelain", "--untracked-files=no")
abort "cannot inspect the source tree" unless status.success?
abort "release manifests require a clean tracked source tree" unless dirty.empty?

source_time = ENV["SOURCE_DATE_EPOCH"]
generated_at = source_time ? Time.at(Integer(source_time), in: "+00:00") : Time.now.utc
manifest = {
  "schema" => "navishai-release-manifest-v1", "source_commit" => commit.strip,
  "generated_at" => generated_at.iso8601,
  "artifacts" => ARGV.sort.map do |path|
    { "name" => File.basename(path), "bytes" => File.size(path), "sha256" => Digest::SHA256.file(path).hexdigest }
  end
}
File.write(output, JSON.pretty_generate(manifest) << "\n")
puts "Wrote #{output} for #{ARGV.size} artifacts"
