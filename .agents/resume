#!/usr/bin/env bash
# Fast wake-up repair for the evaluation lab; no runtime or memory services.
# Do not install packages or toolchains here.
set -euo pipefail

log() {
  printf '[resume] %s\n' "$*"
}

ensure_postgres() {
  if ! command -v pg_lsclusters >/dev/null 2>&1; then
    log "postgres not installed; nothing to repair"
    return 0
  fi

  local ver name port status found=false
  while read -r ver name port status _; do
    [[ "$ver" == 18 && "$name" == main ]] || continue
    found=true
    if [[ "$port" != 5432 ]]; then
      log "PostgreSQL 18/main must use port 5432; existing clusters were not changed"
      return 1
    fi
    if [[ "$status" != "online" ]]; then
      log "starting PostgreSQL ${ver}/${name}"
      sudo pg_ctlcluster "$ver" "$name" start
    fi
  done < <(pg_lsclusters --no-header)

  if [[ "$found" != true ]]; then
    log "PostgreSQL 18/main missing; run .agents/setup"
    return 1
  fi

  if ! command -v pg_isready >/dev/null 2>&1; then
    return 0
  fi

  local i
  for i in $(seq 1 16); do
    if pg_isready -q; then
      log "postgres ready"
      return 0
    fi
    sleep 0.25
  done

  log "postgres did not become ready"
  return 1
}

ensure_postgres
