# Configure production behind an HTTPS reverse proxy. Never reuse an old database volume.
NAVISHAI_APP_HOST=navishai.example.com
NAVISHAI_DATABASE_PASSWORD=
NAVISHAI_SECRET_KEY_BASE=
# One-time first-Owner flow: random 32+ byte token and future ISO 8601 expiry.
NAVISHAI_BOOTSTRAP_TOKEN=
NAVISHAI_BOOTSTRAP_TOKEN_EXPIRES_AT=
# Optional HTTP eval approval registry. Default denies all external target requests.
# JSON entries: workspace_id, endpoint and optional bearer_token. See documentation/DEVELOPMENT.md.
# Treat the registry as a secret when it contains credentials; never commit it.
NAVISHAI_EVALUATION_ENDPOINTS=[]
# Optional OIDC; configure all three or none.
NAVISHAI_OIDC_ISSUER=
NAVISHAI_OIDC_CLIENT_ID=
NAVISHAI_OIDC_CLIENT_SECRET=
# Authentication/invitation mail only. SMTP is mandatory for production mail delivery.
NAVISHAI_SYSTEM_SMTP_ADDRESS=
NAVISHAI_SYSTEM_SMTP_PORT=
NAVISHAI_SYSTEM_SMTP_USER_NAME=
NAVISHAI_SYSTEM_SMTP_PASSWORD=
NAVISHAI_SYSTEM_SMTP_FROM=
