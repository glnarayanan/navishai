# Copy this file to .env and replace every change-me value before starting Compose.
NAVISHAI_APP_HOST=navishai.example.com
NAVISHAI_SOURCE_COMMIT=replace-with-the-40-character-source-commit
NAVISHAI_DATABASE_PASSWORD=change-me-database-password
NAVISHAI_RUNNER_SHARED_SECRET=change-me-at-least-32-random-bytes
NAVISHAI_RUNNER_PROVIDER_VAULT_SECRET=change-me-separate-at-least-32-random-bytes
NAVISHAI_SECRET_KEY_BASE=change-me-output-of-bin-rails-secret
NAVISHAI_SUPERMEMORY_API_KEY=change-me-after-supermemory-first-boot

# Optional generic OpenID Connect login. Set all three values or leave all three blank.
NAVISHAI_OIDC_ISSUER=
NAVISHAI_OIDC_CLIENT_ID=
NAVISHAI_OIDC_CLIENT_SECRET=

# Optional malware scanning. Leave blank to keep every attachment quarantined (fail closed).
# Set NAVISHAI_ATTACHMENT_SCANNER=clamd and point NAVISHAI_CLAMD_ADDRESS at a deployment-run ClamAV daemon.
NAVISHAI_ATTACHMENT_SCANNER=
NAVISHAI_CLAMD_ADDRESS=

# Generate these files with script/generate_runner_tls.
NAVISHAI_RUNNER_CERTS_PATH=./ops/secrets/runner

# Deployment-owned runner policy, executable, and pre-existing subscription-home overrides.
# The policy is an immutable ceiling; Workspace provider connections are configured in the app.
NAVISHAI_RUNNER_EXECUTION_CONFIG_PATH=./ops/runner/execution.example.json
NAVISHAI_RUNTIME_EXECUTABLES_PATH=./ops/runtime-executables
NAVISHAI_RUNTIME_STATE_PATH=./ops/runtime-state
