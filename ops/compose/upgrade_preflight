#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "$root/ops/compose/lib.sh"
cd "$root"

require_command docker
require_command openssl
archive="${1:-}"
[[ -n "$archive" ]] || { printf 'Usage: %s VERIFIED_BACKUP_DIRECTORY\n' "$0" >&2; exit 1; }

compose config --quiet
"$root/ops/compose/verify_backup" "$archive"

certs="${NAVISHAI_RUNNER_CERTS_PATH:-ops/secrets/runner}"
openssl verify -CAfile "$certs/ca.crt" "$certs/server.crt" >/dev/null
openssl x509 -checkend 604800 -noout -in "$certs/server.crt" >/dev/null || {
  printf 'Runner certificate expires in less than seven days.\n' >&2
  exit 1
}
openssl x509 -in "$certs/server.crt" -noout -ext subjectAltName | grep -q 'DNS:runner' || {
  printf 'Runner certificate must contain DNS:runner.\n' >&2
  exit 1
}

compose up -d --wait postgres
postgres_version="$(compose exec -T postgres psql --username navishai --dbname navishai_production --tuples-only --no-align --command 'SHOW server_version_num')"
case "$postgres_version" in
  15*|16*) ;;
  *) printf 'PostgreSQL 15 or 16 is required; found %s.\n' "$postgres_version" >&2; exit 1 ;;
esac
target_postgres_version="$(compose run --rm -T --no-deps --entrypoint psql postgres --version 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)"
if [[ "$postgres_version" == 15* && "$target_postgres_version" != "15" ]]; then
  printf 'The database runs PostgreSQL 15 but the target image is PostgreSQL %s. Follow the major-version upgrade in documentation/OPERATIONS.md before this release.\n' "${target_postgres_version:-unknown}" >&2
  exit 1
fi
vector_version="$(compose exec -T postgres psql --username navishai --dbname navishai_production --tuples-only --no-align --command "SELECT extversion FROM pg_extension WHERE extname = 'vector'")"
case "$vector_version" in
  0.8.1|0.8.6) ;;
  *) printf 'Unsupported pgvector version %s; expected 0.8.1 or 0.8.6.\n' "${vector_version:-none}" >&2; exit 1 ;;
esac
available_vector_version="$(compose exec -T postgres psql --username navishai --dbname navishai_production --tuples-only --no-align --command "SELECT version FROM pg_available_extension_versions WHERE name = 'vector' AND version = '0.8.6'")"
[[ "$available_vector_version" == "0.8.6" ]] || { printf 'pgvector 0.8.6 is not available in the target PostgreSQL image.\n' >&2; exit 1; }

compose run --rm -T --no-deps web bin/rails db:migrate:status
printf 'Upgrade preflight passed with verified backup %s\n' "$archive"
