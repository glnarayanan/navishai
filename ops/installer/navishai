#!/usr/bin/env bash
set -euo pipefail

managed_root="${NAVISHAI_MANAGED_ROOT:-}"
prefix="${managed_root:-}/opt/navishai"
etc="${managed_root:-}/etc/navishai"
state="${managed_root:-}/var/lib/navishai"
project="${NAVISHAI_COMPOSE_PROJECT:-navishai}"
verified_bundle_staging=""
answer_memory_key=""
selected_host=""
configured_smtp_address=""
configured_smtp_port=""
configured_smtp_user_name=""
configured_smtp_password=""
configured_smtp_from=""
configured_scanner_address=""

die() { echo "navishai: $*" >&2; exit 1; }
need_root() { [[ ${NAVISHAI_TEST_ALLOW_UNPRIVILEGED:-} == 1 || ${EUID:-$(id -u)} -eq 0 ]] || die "run with sudo"; }
compose() {
  local arguments=(--project-name "$project" --env-file "$etc/env" -f "$prefix/current/compose.yaml" -f "$prefix/current/ops/installer/compose.yaml")
  if [[ -n ${NAVISHAI_TEST_COMPOSE_OVERRIDE:-} ]]; then
    [[ ${NAVISHAI_TEST_ALLOW_UNPRIVILEGED:-} == 1 && -f $NAVISHAI_TEST_COMPOSE_OVERRIDE ]] || die "test Compose override is unavailable"
    arguments+=(-f "$NAVISHAI_TEST_COMPOSE_OVERRIDE")
  fi
  docker compose "${arguments[@]}" "$@"
}
compose_at() {
  local release="$1" arguments
  shift
  arguments=(--project-name "$project" --env-file "$etc/env" -f "$release/compose.yaml" -f "$release/ops/installer/compose.yaml")
  if [[ -n ${NAVISHAI_TEST_COMPOSE_OVERRIDE:-} ]]; then
    [[ ${NAVISHAI_TEST_ALLOW_UNPRIVILEGED:-} == 1 && -f $NAVISHAI_TEST_COMPOSE_OVERRIDE ]] || die "test Compose override is unavailable"
    arguments+=(-f "$NAVISHAI_TEST_COMPOSE_OVERRIDE")
  fi
  docker compose "${arguments[@]}" "$@"
}
operation() {
  operation_at "$prefix/current" "$@"
}
operation_at() {
  local release="$1"
  shift
  local compose_files="$release/compose.yaml:$release/ops/installer/compose.yaml"
  if [[ -n ${NAVISHAI_TEST_COMPOSE_OVERRIDE:-} ]]; then
    [[ ${NAVISHAI_TEST_ALLOW_UNPRIVILEGED:-} == 1 && -f $NAVISHAI_TEST_COMPOSE_OVERRIDE ]] || die "test Compose override is unavailable"
    compose_files+=":$NAVISHAI_TEST_COMPOSE_OVERRIDE"
  fi
  env -u COMPOSE_PROJECT_NAME -u COMPOSE_FILE -u COMPOSE_ENV_FILES -u COMPOSE_PATH_SEPARATOR \
    COMPOSE_PROJECT_NAME="$project" \
    COMPOSE_FILE="$compose_files" \
    COMPOSE_PATH_SEPARATOR=: \
    COMPOSE_ENV_FILES="$etc/env" \
    NAVISHAI_RUNNER_CERTS_PATH="$etc/runner" \
    NAVISHAI_RELEASE_ID="$(basename "$(readlink -f "$release")")" \
    NAVISHAI_RELEASE_IMAGES_SHA256="$(sha256sum "$release/images.tar" | cut -d' ' -f1)" \
    NAVISHAI_INSTALL_STATE_PATH="$state" \
    NAVISHAI_OPERATION_LOCK_HELD=1 \
    "$@"
}
random() { openssl rand -hex 32; }
progress() {
  local step="$1" temporary
  mkdir -p "$state"
  temporary="$(mktemp "$state/install.json.XXXXXX")"
  printf '{"schema":1,"release":"%s","step":"%s"}\n' "$(cat "$prefix/current/SOURCE_COMMIT" 2>/dev/null || echo pending)" "$step" >"$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$state/install.json"
}
lock() {
  mkdir -p "$state"
  command -v flock >/dev/null || die "flock is required"
  exec {install_lock_fd}>"$state/install.lock"
  flock -n "$install_lock_fd" || die "another mutating operation is running"
  trap '[[ -z $verified_bundle_staging ]] || rm -rf "$verified_bundle_staging"' EXIT
}
validate_answers() {
  local mode key value secret_file secret_value
  [[ -z ${NAVISHAI_ANSWERS_FILE:-} ]] && return
  [[ -f $NAVISHAI_ANSWERS_FILE && ! -L $NAVISHAI_ANSWERS_FILE ]] || die "answer file must be a regular file"
  [[ $(stat -c %u "$NAVISHAI_ANSWERS_FILE") -eq ${EUID:-$(id -u)} ]] || die "answer file must be owned by the current user"
  mode=$((8#$(stat -c %a "$NAVISHAI_ANSWERS_FILE")))
  (( (mode & 0077) == 0 )) || die "answer file must not be readable by group or others"
  declare -A seen=()
  while IFS='=' read -r key value || [[ -n ${key:-} ]]; do
    [[ -n $key && -n $value ]] || die "answer file contains an empty field"
    [[ -z ${seen[$key]:-} ]] || die "answer file contains a duplicate field"
    seen[$key]=1
    case "$key" in
      NAVISHAI_APP_HOST) selected_host="$(validate_hostname "$value")" ;;
      NAVISHAI_SUPERMEMORY_API_KEY_FILE)
        secret_file="$value"
        [[ -f $secret_file && ! -L $secret_file && $(stat -c %u "$secret_file") -eq ${EUID:-$(id -u)} ]] || die "secret reference must be an owned regular file"
        mode=$((8#$(stat -c %a "$secret_file")))
        (( (mode & 0077) == 0 )) || die "secret reference must not be readable by group or others"
        od -An -t x1 "$secret_file" | grep -q '00' && die "secret reference contains unsupported characters"
        secret_value="$(<"$secret_file")"
        [[ -n $secret_value && $secret_value != *$'\n'* && $secret_value != *$'\r'* && $secret_value =~ ^[[:graph:]]+$ && $secret_value != *'$'* && $secret_value != *'#'* && $secret_value != *'"'* && $secret_value != *"'"* ]] || die "secret reference contains unsupported characters"
        answer_memory_key="$secret_value"
        ;;
      NAVISHAI_SYSTEM_SMTP_ADDRESS) configured_smtp_address="$(validate_smtp_address "$value")" ;;
      NAVISHAI_SYSTEM_SMTP_PORT) configured_smtp_port="$(validate_smtp_port "$value")" ;;
      NAVISHAI_SYSTEM_SMTP_USER_NAME) configured_smtp_user_name="$(validate_env_value "$value")" ;;
      NAVISHAI_SYSTEM_SMTP_PASSWORD_FILE)
        secret_value="$(read_secret_reference "$value")"
        configured_smtp_password="$secret_value"
        ;;
      NAVISHAI_SYSTEM_SMTP_FROM) configured_smtp_from="$(validate_mailbox "$value")" ;;
      NAVISHAI_ATTACHMENT_SCANNER) [[ $value == clamd ]] || die "only the clamd attachment scanner is supported" ;;
      NAVISHAI_CLAMD_ADDRESS) configured_scanner_address="$(validate_clamd_address "$value")" ;;
      *) die "answer file contains an unsupported field: $key" ;;
    esac
  done <"$NAVISHAI_ANSWERS_FILE"
}

read_secret_reference() {
  local secret_file="$1" mode secret_value
  [[ -f $secret_file && ! -L $secret_file && $(stat -c %u "$secret_file") -eq ${EUID:-$(id -u)} ]] || die "secret reference must be an owned regular file"
  mode=$((8#$(stat -c %a "$secret_file")))
  (( (mode & 0077) == 0 )) || die "secret reference must not be readable by group or others"
  od -An -t x1 "$secret_file" | grep -q '00' && die "secret reference contains unsupported characters"
  secret_value="$(<"$secret_file")"
  validate_env_value "$secret_value"
}

validate_env_value() {
  local value="$1"
  [[ -n $value && $value != *$'\n'* && $value != *$'\r'* && $value =~ ^[[:graph:]]+$ && $value != *'$'* && $value != *'#'* && $value != *'"'* && $value != *"'"* ]] || die "configuration value contains unsupported characters"
  printf '%s\n' "$value"
}

validate_clamd_address() {
  local address
  address="$(validate_env_value "$1")"
  [[ $address =~ ^tcp://[^/[:space:]]+:[0-9]{1,5}$ || $address =~ ^unix:///[^[:space:]]+$ ]] || die "ClamAV address must be tcp://host:port or unix:///path"
  printf '%s\n' "$address"
}

validate_smtp_address() {
  local address
  address="$(validate_env_value "$1")"
  [[ $address =~ ^[A-Za-z0-9.-]+$ && $address != .* && $address != *..* ]] || die "SMTP address must be a hostname or IP address"
  printf '%s\n' "$address"
}

validate_smtp_port() {
  local port="$1"
  [[ $port =~ ^[0-9]+$ && $port -ge 1 && $port -le 65535 ]] || die "SMTP port must be between 1 and 65535"
  printf '%s\n' "$port"
}

validate_mailbox() {
  local mailbox
  mailbox="$(validate_env_value "$1")"
  [[ $mailbox =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] || die "system mail sender must be an email address"
  printf '%s\n' "$mailbox"
}

validate_hostname() {
  local host="${1,,}" label
  host="${host%.}"
  [[ -n $host && ${#host} -le 253 && "$host" != *..* && "$host" != *.invalid && "$host" != *.test && "$host" != localhost && ! "$host" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || die "a public hostname is required for production TLS"
  IFS=. read -r -a labels <<<"$host"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 && "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || die "a public hostname is required for production TLS"
  done
  printf '%s\n' "$host"
}

prepare_setup_host() {
  local host
  [[ -f "$etc/env" ]] && return
  if [[ -z $selected_host ]]; then
    { : </dev/tty; } 2>/dev/null || die "provide NAVISHAI_APP_HOST in a protected answer file"
    read -r -p 'Public hostname: ' host </dev/tty
    selected_host="$(validate_hostname "$host")"
  fi
}

preflight() {
  [[ $(uname -m) == x86_64 ]] || die "only x86-64 hosts are supported"
  . /etc/os-release
  [[ ($ID == debian && $VERSION_ID == 12) || ($ID == ubuntu && $VERSION_ID == 24.04) ]] || die "supported hosts are Debian 12 and Ubuntu 24.04"
  command -v docker >/dev/null || die "Docker Engine is required"
  docker compose version >/dev/null || die "Docker Compose v2 is required"
  preflight_ports
  [[ $(free -m | awk '/Mem:/ {print $2}') -ge 7168 ]] || echo "navishai: warning: this host has less than the 8 GiB test-host budget" >&2
}

preflight_ports() {
  local port problem
  command -v ss >/dev/null || die "ss is required to inspect HTTPS ports"
  for port in 80 443; do
    problem="$(port_conflict "$port")"
    [[ -z $problem ]] || die "$problem"
  done
}
# Prints why a public port cannot be used, or nothing when it is free or owned by this installation's Caddy.
port_conflict() {
  local port="$1" listeners containers container labels binding
  listeners="$(ss -ltnH "( sport = :$port )")"
  [[ -n $listeners ]] || return 0
  [[ -e "$prefix/current" ]] || { echo "port $port is in use; stop the service using it, then rerun setup"; return 0; }
  containers="$(docker ps --filter "publish=$port" --format '{{.ID}}')" || { echo "cannot inspect port $port ownership; retry setup"; return 0; }
  [[ $(wc -w <<<"$containers") == 1 ]] || { echo "port $port ownership is ambiguous; stop the conflicting service, then rerun setup"; return 0; }
  container="$containers"
  labels="$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }} {{ index .Config.Labels "com.docker.compose.service" }}' "$container")" || { echo "cannot inspect port $port ownership; retry setup"; return 0; }
  binding="$(docker inspect --format "{{range \$p, \$bindings := .HostConfig.PortBindings}}{{range \$bindings}}{{if eq .HostPort \"$port\"}}{{\$p}}{{end}}{{end}}{{end}}" "$container")" || { echo "cannot inspect port $port ownership; retry setup"; return 0; }
  [[ -n $binding ]] || { echo "port $port is in use by a non-Docker service; stop it, then rerun setup"; return 0; }
  [[ $labels == "$project caddy" ]] || echo "port $port is in use by another container; stop it, then rerun setup"
}

disk_check() {
  local bundle="$1" bundle_kib docker_root docker_free root_free required_kib
  [[ -f "$bundle" ]] || die "bundle not found: $bundle"
  bundle_kib=$((($(stat -c%s "$bundle") + 1023) / 1024))
  docker_root="$(docker info --format '{{.DockerRootDir}}')"
  docker_free="$(df -Pk "$docker_root" | awk 'NR==2 {print $4}')"
  root_free="$(df -Pk / | awk 'NR==2 {print $4}')"
  # One source archive, one extracted image archive, one imported image set, plus 2 GiB durable-data headroom.
  required_kib=$((bundle_kib * 3 + 2097152))
  if [[ "$docker_free" -lt "$required_kib" || "$root_free" -lt "$required_kib" ]]; then
    die "insufficient installation space: bundle ${bundle_kib} KiB, required ${required_kib} KiB (archive + extraction + imported images + 2 GiB data headroom); free root ${root_free} KiB, Docker root ${docker_free} KiB"
  fi
}

stage_bundle() {
  local bundle="$1" staging entry expected actual canonical_manifest bundle_kib staging_free
  [[ -f "$bundle" ]] || die "bundle not found: $bundle"
  bundle_kib=$((($(stat -c%s "$bundle") + 1023) / 1024))
  staging_free="$(df -Pk "${TMPDIR:-/tmp}" | awk 'NR==2 {print $4}')"
  [[ "$staging_free" -ge "$bundle_kib" ]] || die "insufficient temporary space to verify bundle"
  staging="$(mktemp -d)"
  verified_bundle_staging="$staging"
  while IFS= read -r entry; do
    [[ "$entry" != /* && "$entry" != *"/../"* && "$entry" != ../* && "$entry" != *"//"* ]] || die "bundle contains an unsafe path"
    case "$entry" in
      SHA256SUMS|images.tar|release/|release/compose.yaml|release/SOURCE_COMMIT|release/ops/|release/ops/compose/|release/ops/compose/backup|release/ops/compose/lib.sh|release/ops/compose/restore|release/ops/compose/upgrade_preflight|release/ops/compose/verify_backup|release/ops/installer/|release/ops/installer/bootstrap|release/ops/installer/Caddyfile|release/ops/installer/compose.yaml|release/ops/installer/navishai|release/ops/runner/|release/ops/runner/execution.example.json|release/script/|release/script/generate_runner_tls) ;;
      *) die "bundle contains an unexpected payload: $entry" ;;
    esac
  done < <(tar -tf "$bundle")
  tar -tvf "$bundle" | awk '$1 !~ /^[-d]/ { exit 1 }' || die "bundle contains unsupported entry types"
  tar -xf "$bundle" -C "$staging"
  expected='images.tar
release/SOURCE_COMMIT
release/compose.yaml
release/ops/compose/backup
release/ops/compose/lib.sh
release/ops/compose/restore
release/ops/compose/upgrade_preflight
release/ops/compose/verify_backup
release/ops/installer/Caddyfile
release/ops/installer/bootstrap
release/ops/installer/compose.yaml
release/ops/installer/navishai
release/ops/runner/execution.example.json
release/script/generate_runner_tls'
  actual="$(cd "$staging" && find images.tar release -type f -printf '%p\n' | LC_ALL=C sort)"
  [[ "$actual" == "$expected" ]] || die "bundle payload is incomplete or unexpected"
  canonical_manifest="$(cd "$staging" && find images.tar release -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum)"
  [[ $(cat "$staging/SHA256SUMS") == "$canonical_manifest" ]] || die "bundle manifest is incomplete or unsafe"
  (cd "$staging" && printf '%s\n' "$canonical_manifest" | sha256sum --check) || die "bundle checksum failed"
  [[ $(cat "$staging/release/SOURCE_COMMIT") =~ ^[0-9a-f]{40}$ ]] || die "bundle has an invalid source commit"
  verified_bundle_identity="$(printf '%s\n' "$canonical_manifest" | sha256sum | cut -d' ' -f1)"
}

install_bundle() {
  local staging="$verified_bundle_staging" release temporary_release
  [[ -n ${staging:-} && -d $staging ]] || die "bundle was not verified"
  release="$prefix/releases/$verified_bundle_identity"
  mkdir -p "$prefix/releases" "$etc" "$state"
  if [[ ! -e "$release" ]]; then
    temporary_release="$prefix/releases/.${verified_bundle_identity}.tmp"
    rm -rf "$temporary_release"
    mv "$staging/release" "$temporary_release" || return
    mv "$staging/images.tar" "$temporary_release/images.tar" || return
    [[ ${NAVISHAI_TEST_FAIL_BEFORE_RELEASE_PUBLISH:-} != 1 ]] || return 1
    mv "$temporary_release" "$release" || return
  fi
  docker image load -i "$release/images.tar" || return
  ln -sfn "$release" "$prefix/current" || return
  rm -rf "$staging" || return
  verified_bundle_staging=""
}

confirm_setup() {
  local release="$prefix/releases/$verified_bundle_identity" consent host
  if [[ -e "$prefix/current" ]]; then
    [[ "$(readlink -f "$prefix/current")" == "$release" ]] || die "installed release differs from this bundle; use navishai upgrade"
    host="$(sed -n 's/^NAVISHAI_APP_HOST=//p' "$etc/env")"
    echo "Resume setup for release $verified_bundle_identity at https://$host on ports 80 and 443. Existing environment and runner TLS will be retained."
  else
    echo "Install release $verified_bundle_identity for https://$selected_host on ports 80 and 443."
    echo "Create installer metadata under $state and persistent Docker volumes for PostgreSQL, Rails storage, runner, Supermemory, and Caddy; then start PostgreSQL, runner, web, jobs, and Caddy."
  fi
  echo "No firewall, SSH, unrelated service, or package change is part of this step."
  [[ ${NAVISHAI_SETUP_ACCEPT:-} == yes ]] && return
  { : </dev/tty; } 2>/dev/null || die "review the setup summary, then rerun with NAVISHAI_SETUP_ACCEPT=yes"
  read -r -p 'Apply this setup? [yes/no] ' consent </dev/tty
  [[ $consent == yes ]] || die "no setup changes made"
}

validate_staged_target() {
  local staging="$verified_bundle_staging" target_postgres current_postgres_major target_postgres_major current_images_archive target_services current_services
  [[ -n $staging && -d $staging ]] || die "target bundle was not verified"
  command -v jq >/dev/null || die "jq is required to inspect the target Compose configuration"
  docker compose --project-name "$project" --env-file "$etc/env" -f "$staging/release/compose.yaml" -f "$staging/release/ops/installer/compose.yaml" config --quiet || die "target Compose configuration is invalid"
  current_images_archive="$prefix/current/images.tar"
  [[ -f "$current_images_archive" ]] || die "changed-image upgrades are temporarily unavailable; the installed release has no retained image archive"
  cmp -s "$staging/images.tar" "$current_images_archive" || die "changed-image upgrades are temporarily unavailable; restore-compatible recovery is not yet implemented"
  target_services="$(docker compose --project-name "$project" --env-file "$etc/env" -f "$staging/release/compose.yaml" -f "$staging/release/ops/installer/compose.yaml" config --format json | jq -cS '[.services | to_entries[] | {name: .key, image: (.value.image // "")} ]')"
  current_services="$(compose config --format json | jq -cS '[.services | to_entries[] | {name: .key, image: (.value.image // "")} ]')"
  [[ "$target_services" == "$current_services" ]] || die "changed-image upgrades are temporarily unavailable; target service image references differ"
  target_postgres="$(jq -r '.[] | select(.name == "postgres") | .image' <<<"$target_services")"
  [[ "$target_postgres" == pgvector/pgvector:*@sha256:* ]] || die "target postgres service must use a digest-pinned pgvector image"
  [[ "$target_postgres" == *"pg15"* || "$target_postgres" == *"pg16"* ]] || die "target PostgreSQL major version is unsupported"
  target_postgres_major="$(sed -nE 's/.*pg(15|16).*/\1/p' <<<"$target_postgres")"
  current_postgres_major="$(compose exec -T postgres psql --username navishai --dbname navishai_production --tuples-only --no-align --command 'SHOW server_version_num' | sed -nE 's/^([0-9]{2}).*/\1/p')"
  [[ "$current_postgres_major" == "$target_postgres_major" ]] || die "target PostgreSQL $target_postgres_major does not match installed PostgreSQL $current_postgres_major"
}

write_env() {
  if [[ -f "$etc/env" ]]; then
    if grep -qx 'NAVISHAI_SUPERMEMORY_API_KEY=' "$etc/env"; then
      sed -i 's/^NAVISHAI_SUPERMEMORY_API_KEY=$/NAVISHAI_SUPERMEMORY_API_KEY=memory-pending-placeholder/' "$etc/env"
      grep -qx 'NAVISHAI_MEMORY_PENDING=1' "$etc/env" || echo 'NAVISHAI_MEMORY_PENDING=1' >>"$etc/env"
    fi
    if [[ ${NAVISHAI_TEST_ALLOW_UNPRIVILEGED:-} != 1 || $(id -u) -eq 0 ]]; then
      chown 1000:1000 "$etc/runner"/*
      chown root:1000 "$etc/runner"
    fi
    chmod 0750 "$etc/runner"
    chmod 0644 "$etc/runner/ca.crt" "$etc/runner/server.crt"
    chmod 0600 "$etc/runner/server.key"
    return
  fi
  umask 077
  local memory_key="${answer_memory_key:-memory-pending-placeholder}"
  cat >"$etc/env" <<EOF
NAVISHAI_APP_HOST=$selected_host
NAVISHAI_SOURCE_COMMIT=$(cat "$prefix/current/SOURCE_COMMIT")
NAVISHAI_DATABASE_PASSWORD=$(random)
NAVISHAI_RUNNER_SHARED_SECRET=$(random)
NAVISHAI_RUNNER_PROVIDER_VAULT_SECRET=$(random)
NAVISHAI_SECRET_KEY_BASE=$(random)
NAVISHAI_SUPERMEMORY_API_KEY=$memory_key
NAVISHAI_MEMORY_PENDING=1
NAVISHAI_BOOTSTRAP_TOKEN=$(random)
NAVISHAI_BOOTSTRAP_TOKEN_EXPIRES_AT=$(date -u -d '+24 hours' +%Y-%m-%dT%H:%M:%SZ)
NAVISHAI_RUNNER_CERTS_PATH=$etc/runner
EOF
  mkdir -p "$etc/runner"
  "$prefix/current/script/generate_runner_tls" "$etc/runner"
  if [[ ${NAVISHAI_TEST_ALLOW_UNPRIVILEGED:-} != 1 || $(id -u) -eq 0 ]]; then
    chown 1000:1000 "$etc/runner"/*
    chown root:1000 "$etc/runner"
  fi
  chmod 0750 "$etc/runner"
  chmod 0640 "$etc/env"
  chmod 0644 "$etc/runner/ca.crt" "$etc/runner/server.crt"
  chmod 0600 "$etc/runner/server.key"
}

validate_resume_state() {
  [[ ! -e "$etc/env" ]] && return
  [[ -L "$prefix/current" && -d "$(readlink -f "$prefix/current")" && -f "$etc/runner/ca.crt" && -f "$etc/runner/server.crt" && -f "$etc/runner/server.key" ]] || die "incomplete setup state detected; restore the managed release and runner TLS before rerunning setup"
}

verify_https() {
  local host="$1" https_status interval deadline
  interval=5
  [[ ${NAVISHAI_TEST_ALLOW_UNPRIVILEGED:-} == 1 && -n ${NAVISHAI_TEST_HTTPS_INTERVAL:-} ]] && interval="$NAVISHAI_TEST_HTTPS_INTERVAL"
  deadline=$((SECONDS + ${NAVISHAI_HTTPS_WAIT_SECONDS:-120}))
  # Certificate issuance is asynchronous after Caddy starts, so allow a bounded wait for an exact 200.
  while :; do
    https_status="$(curl --fail --silent --show-error --connect-timeout 10 --max-time 30 --output /dev/null --write-out '%{http_code}' "https://$host/up")" && [[ $https_status == 200 ]] && return 0
    (( SECONDS < deadline )) || return 1
    echo "navishai: waiting for HTTPS at https://$host/up; certificate issuance can take a minute" >&2
    sleep "$interval"
  done
}

setup() {
  need_root
  [[ $# -eq 1 ]] || die "usage: navishai setup BUNDLE.tar"
  lock
  validate_answers
  validate_resume_state
  stage_bundle "$1"
  prepare_setup_host
  preflight
  disk_check "$1"
  confirm_setup
  install_bundle; progress bundle_verified
  write_env; progress secrets_ready
  compose up -d --wait postgres runner app-net
  compose run --rm web bin/rails db:prepare
  compose up -d --wait web jobs caddy
  local setup_host
  setup_host="$(sed -n 's/^NAVISHAI_APP_HOST=//p' "$etc/env")"
  if verify_https "$setup_host"; then
    progress https_verified
    echo "Infrastructure and HTTPS are ready at https://$setup_host."
  else
    progress https_unverified
    die "services started, but HTTPS could not be verified at https://$setup_host/up; check DNS, the certificate, and HTTPS connectivity, then rerun setup"
  fi
  echo "Create the first Owner at https://$setup_host/setup. In a trusted terminal, run: navishai reveal-owner-token --confirm-reveal"
  if grep -qx 'NAVISHAI_MEMORY_PENDING=1' "$etc/env"; then
    echo "Open setup if you have not created the first Owner. Memory configuration remains incomplete: Supermemory Local 0.0.8 needs approved first-boot provider configuration."
    echo "The First-Owner token is not printed automatically. Do not record it in terminal output."
    return 0
  fi
  compose up -d supermemory web jobs
}

status() {
  need_root
  [[ -f "$etc/env" ]] || die "not installed"
  if [[ -L "$prefix/current" && -d "$(readlink -f "$prefix/current")" ]]; then
    echo "release: $(basename "$(readlink -f "$prefix/current")")"
    echo "source commit: $(cat "$prefix/current/SOURCE_COMMIT" 2>/dev/null || echo unknown)"
  else
    echo "release: none selected; restore the managed release before relying on this installation"
  fi
  compose ps
  [[ ! -f "$state/install.json" ]] || cat "$state/install.json"
  if grep -qx 'NAVISHAI_MEMORY_PENDING=1' "$etc/env"; then
    echo "memory: pending configuration"
  else
    echo "memory: key configured; scoped indexing and retrieval are not verified by this command"
  fi
  if grep -q '^NAVISHAI_SYSTEM_SMTP_ADDRESS=' "$etc/env"; then
    echo "system mail: configured, untested"
  else
    echo "system mail: not configured"
  fi
  if grep -qx 'NAVISHAI_ATTACHMENT_SCANNER=clamd' "$etc/env"; then
    echo "attachment scanner: clamd configured, untested; files stay quarantined until a clean result"
  else
    echo "attachment scanner: not configured; every attachment stays quarantined"
  fi
}
# Read-only diagnostics: every finding is collected with a recovery action; nothing is repaired or probed for cost.
doctor_findings=()
doctor_failed=0
finding() {
  local status="$1" key="$2" message="$3" action="${4:-}"
  doctor_findings+=("$status"$'\t'"$key"$'\t'"$message"$'\t'"$action")
  [[ $status != failure ]] || doctor_failed=1
}
json_string() { local value="$1"; value="${value//\\/\\\\}"; value="${value//\"/\\\"}"; printf '"%s"' "$value"; }
doctor() {
  local output="text" step release free_root free_docker docker_root problem port host
  need_root
  case "${1:-}" in
    "") ;;
    --json) output="json" ;;
    *) die "usage: navishai doctor [--json]" ;;
  esac
  [[ $# -le 1 ]] || die "usage: navishai doctor [--json]"
  if [[ $(uname -m) == x86_64 ]]; then finding ok architecture "x86-64 host"; else finding failure architecture "only x86-64 hosts are supported" "install on a supported x86-64 host"; fi
  . /etc/os-release
  if [[ ($ID == debian && $VERSION_ID == 12) || ($ID == ubuntu && $VERSION_ID == 24.04) ]]; then finding ok os "$ID $VERSION_ID is a supported host"; else finding failure os "$ID $VERSION_ID is not a supported host" "use Debian 12 or Ubuntu 24.04"; fi
  if command -v docker >/dev/null; then
    finding ok docker "Docker Engine is installed"
    if docker compose version >/dev/null 2>&1; then finding ok compose "Docker Compose v2 is installed"; else finding failure compose "Docker Compose v2 is missing" "rerun bootstrap to install the Compose plugin"; fi
    if docker info >/dev/null 2>&1; then finding ok docker_daemon "Docker daemon is running"; else finding failure docker_daemon "Docker daemon is not reachable" "run systemctl enable --now docker, then rerun navishai doctor"; fi
  else
    finding failure docker "Docker Engine is missing" "rerun bootstrap to install Docker"
  fi
  if command -v ss >/dev/null; then
    for port in 80 443; do
      problem="$(port_conflict "$port")"
      if [[ -z $problem ]]; then finding ok "port_$port" "port $port is free or owned by this installation"; else finding failure "port_$port" "$problem" "free port $port, then rerun navishai setup"; fi
    done
  else
    finding warning ports "ss is unavailable; ports 80 and 443 were not inspected" "install iproute2"
  fi
  if [[ $(free -m | awk '/Mem:/ {print $2}') -ge 7168 ]]; then finding ok memory "at least the 8 GiB test-host budget"; else finding warning memory "less than the 8 GiB test-host budget" "expect slower startup; this is a measured test budget, not a support minimum"; fi
  free_root="$(df -Pk / | awk 'NR==2 {print $4}')"
  if [[ $free_root -ge 2097152 ]]; then finding ok disk_root "root filesystem has $((free_root / 1024)) MiB free"; else finding warning disk_root "root filesystem has only $((free_root / 1024)) MiB free" "free at least 2 GiB before backup or upgrade"; fi
  if command -v docker >/dev/null && docker_root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)" && [[ -n $docker_root && -d $docker_root ]]; then
    free_docker="$(df -Pk "$docker_root" | awk 'NR==2 {print $4}')"
    if [[ $free_docker -ge 2097152 ]]; then finding ok disk_docker "Docker root has $((free_docker / 1024)) MiB free"; else finding warning disk_docker "Docker root has only $((free_docker / 1024)) MiB free" "free at least 2 GiB before loading a candidate"; fi
  fi
  if [[ -f "$etc/env" ]]; then
    host="$(sed -n 's/^NAVISHAI_APP_HOST=//p' "$etc/env")"
    finding ok installation "installed for https://$host"
    if [[ -L "$prefix/current" && -d "$(readlink -f "$prefix/current")" ]]; then
      release="$(basename "$(readlink -f "$prefix/current")")"
      finding ok release "current release $release"
      if [[ -f "$prefix/current/images.tar" ]]; then finding ok release_images "retained image archive present"; else finding failure release_images "current release has no retained image archive" "managed restore and upgrade need the retained archive; reinstall the same release from its candidate"; fi
    else
      finding failure release "no valid current release" "restore the managed release before rerunning setup"
    fi
    if [[ -f "$etc/runner/ca.crt" && -f "$etc/runner/server.crt" && -f "$etc/runner/server.key" ]]; then finding ok runner_tls "runner TLS files present"; else finding failure runner_tls "runner TLS files are missing" "restore $etc/runner from the secret backup before rerunning setup"; fi
    if [[ -f "$state/install.json" ]]; then
      step="$(sed -n 's/.*"step":"\([a-z_]*\)".*/\1/p' "$state/install.json")"
      case "$step" in
        https_verified|upgrade_completed|restore_completed) finding ok install_step "last recorded step: $step" ;;
        https_unverified) finding failure install_step "HTTPS was never verified" "check DNS for $host, the certificate, and connectivity, then rerun navishai setup" ;;
        *_restore_required) finding failure install_step "last recorded step: $step" "restore from the verified backup with navishai restore before retrying" ;;
        "") finding warning install_step "install record has no step" "rerun navishai setup with the same candidate" ;;
        *) finding warning install_step "setup stopped at step $step" "rerun navishai setup with the same candidate" ;;
      esac
    else
      finding warning install_step "no install record" "rerun navishai setup with the same candidate"
    fi
    if grep -qx 'NAVISHAI_MEMORY_PENDING=1' "$etc/env"; then finding warning memory_service "memory is pending configuration" "complete the isolated Supermemory first boot, then run navishai configure memory"; else finding ok memory_service "memory key configured; scoped indexing is not verified here"; fi
    if grep -q '^NAVISHAI_SYSTEM_SMTP_ADDRESS=' "$etc/env"; then finding ok system_mail "system mail configured, untested"; else finding warning system_mail "system mail not configured" "run navishai configure system-mail to enable invitations and reset mail"; fi
    if grep -qx 'NAVISHAI_ATTACHMENT_SCANNER=clamd' "$etc/env"; then finding ok scanner "clamd configured, untested; files stay quarantined until a clean result"; else finding warning scanner "no attachment scanner; every attachment stays quarantined" "run navishai configure scanner when a ClamAV daemon is available"; fi
  else
    finding failure installation "NavishAI is not installed" "run navishai setup CANDIDATE.tar"
  fi
  doctor_report "$output"
  return "$doctor_failed"
}
doctor_report() {
  local output="$1" entry status key message action first=1 result="healthy"
  [[ $doctor_failed -eq 0 ]] || result="attention"
  for entry in "${doctor_findings[@]}"; do
    IFS=$'\t' read -r status key message action <<<"$entry"
    [[ $status == warning && $result == healthy ]] && result="warnings"
  done
  if [[ $output == json ]]; then
    printf '{"schema":1,"result":%s,"findings":[' "$(json_string "$result")"
    for entry in "${doctor_findings[@]}"; do
      IFS=$'\t' read -r status key message action <<<"$entry"
      [[ $first -eq 1 ]] || printf ','
      first=0
      printf '{"key":%s,"status":%s,"message":%s,"action":%s}' "$(json_string "$key")" "$(json_string "$status")" "$(json_string "$message")" "$(json_string "$action")"
    done
    printf ']}\n'
    return 0
  fi
  for entry in "${doctor_findings[@]}"; do
    IFS=$'\t' read -r status key message action <<<"$entry"
    if [[ -n $action ]]; then printf '%s: %s: %s; %s\n' "$status" "$key" "$message" "$action"; else printf '%s: %s: %s\n' "$status" "$key" "$message"; fi
  done
  echo "result: $result"
}
replace_env_values() {
  local temporary key
  temporary="$(mktemp "$etc/env.XXXXXX")"
  cp "$etc/env" "$temporary"
  for key in NAVISHAI_SYSTEM_SMTP_ADDRESS NAVISHAI_SYSTEM_SMTP_PORT NAVISHAI_SYSTEM_SMTP_USER_NAME NAVISHAI_SYSTEM_SMTP_PASSWORD NAVISHAI_SYSTEM_SMTP_FROM; do
    sed -i "/^${key}=/d" "$temporary"
  done
  {
    printf 'NAVISHAI_SYSTEM_SMTP_ADDRESS=%s\n' "$configured_smtp_address"
    printf 'NAVISHAI_SYSTEM_SMTP_PORT=%s\n' "$configured_smtp_port"
    printf 'NAVISHAI_SYSTEM_SMTP_USER_NAME=%s\n' "$configured_smtp_user_name"
    printf 'NAVISHAI_SYSTEM_SMTP_PASSWORD=%s\n' "$configured_smtp_password"
    printf 'NAVISHAI_SYSTEM_SMTP_FROM=%s\n' "$configured_smtp_from"
  } >>"$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$etc/env"
}
configure_system_mail() {
  need_root
  lock
  [[ -f "$etc/env" ]] || die "not installed"
  validate_answers
  [[ -n $configured_smtp_address && -n $configured_smtp_port && -n $configured_smtp_user_name && -n $configured_smtp_password && -n $configured_smtp_from ]] || die "provide all system SMTP values in a protected answer file"
  replace_env_values
  compose up -d --wait web jobs
  echo "System SMTP is configured with required STARTTLS. SMTP acceptance has not been tested."
}
configure_memory() {
  local temporary
  need_root
  lock
  [[ -f "$etc/env" ]] || die "not installed"
  validate_answers
  [[ -n $answer_memory_key ]] || die "provide NAVISHAI_SUPERMEMORY_API_KEY_FILE in a protected answer file"
  temporary="$(mktemp "$etc/env.XXXXXX")"
  grep -Ev '^NAVISHAI_SUPERMEMORY_API_KEY=|^NAVISHAI_MEMORY_PENDING=' "$etc/env" >"$temporary" || true
  printf 'NAVISHAI_SUPERMEMORY_API_KEY=%s\n' "$answer_memory_key" >>"$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$etc/env"
  compose up -d --wait supermemory web jobs
  echo "Memory key is configured. Confirm scoped indexing and retrieval before treating Memory as ready."
}
configure_scanner() {
  local temporary
  need_root
  lock
  [[ -f "$etc/env" ]] || die "not installed"
  validate_answers
  [[ -n $configured_scanner_address ]] || die "provide NAVISHAI_ATTACHMENT_SCANNER=clamd and NAVISHAI_CLAMD_ADDRESS in a protected answer file"
  temporary="$(mktemp "$etc/env.XXXXXX")"
  grep -Ev '^NAVISHAI_ATTACHMENT_SCANNER=|^NAVISHAI_CLAMD_ADDRESS=' "$etc/env" >"$temporary" || true
  printf 'NAVISHAI_ATTACHMENT_SCANNER=clamd\nNAVISHAI_CLAMD_ADDRESS=%s\n' "$configured_scanner_address" >>"$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$etc/env"
  compose up -d --wait web jobs
  echo "ClamAV is configured, not yet reachable or tested. Files remain quarantined until a clean scanner result."
}
renew_owner_token() {
  local temporary
  need_root
  [[ $# -eq 0 ]] || die "usage: navishai renew-owner-token"
  lock
  [[ -f "$etc/env" ]] || die "not installed"
  compose run --rm web bin/rails navishai:first_owner:renewable || die "first-Owner setup is already complete or the installation has state; the token cannot be renewed"
  temporary="$(mktemp "$etc/env.XXXXXX")"
  grep -Ev '^NAVISHAI_BOOTSTRAP_TOKEN=|^NAVISHAI_BOOTSTRAP_TOKEN_EXPIRES_AT=' "$etc/env" >"$temporary" || true
  printf 'NAVISHAI_BOOTSTRAP_TOKEN=%s\nNAVISHAI_BOOTSTRAP_TOKEN_EXPIRES_AT=%s\n' "$(random)" "$(date -u -d '+24 hours' +%Y-%m-%dT%H:%M:%SZ)" >>"$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$etc/env"
  compose up -d --wait web jobs
  echo "A new first-Owner token is valid for 24 hours. In a trusted terminal, run: navishai reveal-owner-token --confirm-reveal"
}
reveal_owner_token() {
  need_root
  [[ $# -eq 1 && $1 == --confirm-reveal ]] || die "usage: navishai reveal-owner-token --confirm-reveal"
  [[ -f "$etc/env" ]] || die "not installed"
  { : >/dev/tty; } 2>/dev/null || die "reveal the token only from a trusted interactive terminal"
  echo "Terminal recording can expose this token. Continue only in a trusted terminal." >/dev/tty
  sed -n 's/^NAVISHAI_BOOTSTRAP_TOKEN=//p' "$etc/env" >/dev/tty
}
backup() { need_root; [[ $# -eq 1 ]] || die "usage: navishai backup PATH"; lock; operation "$prefix/current/ops/compose/backup" "$1"; operation "$prefix/current/ops/compose/verify_backup" "$1"; }
release_for_backup() {
  local archive="$1" release_id images_sha release
  [[ -f "$archive/manifest" ]] || die "backup manifest is required to select a restore release"
  release_id="$(sed -n 's/^managed_release_id=//p' "$archive/manifest")"
  images_sha="$(sed -n 's/^managed_images_sha256=//p' "$archive/manifest")"
  [[ "$release_id" =~ ^[0-9a-f]{64}$ && "$images_sha" =~ ^[0-9a-f]{64}$ ]] || die "managed backup lacks exact release identity metadata"
  release="$prefix/releases/$release_id"
  [[ -f "$release/images.tar" && "$(sha256sum "$release/images.tar" | cut -d' ' -f1)" == "$images_sha" ]] || die "no retained release matches the managed backup image archive"
  printf '%s\n' "$release"
}
restore() {
  need_root
  [[ $# -eq 2 && $2 == --confirm-destroy ]] || die "usage: navishai restore PATH --confirm-destroy"
  local release status
  lock
  operation "$prefix/current/ops/compose/verify_backup" "$1"
  release="$(release_for_backup "$1")"
  compose stop caddy jobs web runner supermemory
  if docker image load -i "$release/images.tar"; then
    :
  else
    status=$?
    restore_failure image_load "$status"
  fi
  if operation_at "$release" "$release/ops/compose/restore" "$1" "$2"; then
    :
  else
    status=$?
    restore_failure data "$status"
  fi
  if grep -qx 'NAVISHAI_MEMORY_PENDING=1' "$etc/env"; then
    compose_at "$release" up -d --wait runner web jobs caddy || restore_failure readiness "$?"
  else
    compose_at "$release" up -d --wait supermemory runner web jobs caddy || restore_failure readiness "$?"
  fi
  ln -sfn "$release" "$prefix/current" || restore_failure current_align "$?"
  progress restore_completed
}
restore_failure() {
  local phase="$1" status="$2"
  compose stop caddy jobs web runner supermemory || true
  progress "restore_${phase}_restore_required"
  printf 'navishai: restore %s failed; restore remains required\n' "$phase" >&2
  exit "$status"
}
upgrade() {
  need_root
  [[ $# -eq 3 && $3 == --confirm-apply ]] || die "usage: navishai upgrade VERIFIED_BACKUP TARGET.tar --confirm-apply"
  local backup="$1" target="$2"
  lock
  stage_bundle "$target"
  validate_staged_target
  disk_check "$target"
  operation "$prefix/current/ops/compose/upgrade_preflight" "$backup"
  echo "Upgrade will stop writers, prepare the target database once, and recreate application services. A failed migration requires restore from the verified backup."
  compose stop caddy jobs web runner supermemory
  progress upgrade_writers_stopped
  if install_bundle; then
    progress upgrade_target_promoted
  else
    upgrade_failure target_load "$?"
  fi
  if compose up -d --wait postgres app-net runner; then
    :
  else
    upgrade_failure target_start "$?"
  fi
  if compose run --rm web bin/rails db:prepare; then
    :
  else
    upgrade_failure prepare "$?"
  fi
  if grep -qx 'NAVISHAI_MEMORY_PENDING=1' "$etc/env"; then
    compose up -d --wait web jobs caddy || upgrade_failure health "$?"
  else
    compose up -d --wait supermemory web jobs caddy || upgrade_failure health "$?"
  fi
  progress upgrade_completed
}

upgrade_failure() {
  local phase="$1" status="$2"
  compose stop caddy jobs web runner supermemory || true
  progress "upgrade_${phase}_restore_required"
  printf 'navishai: upgrade %s failed; restore from the verified backup before retrying\n' "$phase" >&2
  exit "$status"
}

case "${1:-}" in
  setup) shift; setup "$@" ;;
  status) status ;;
  doctor) shift; doctor "$@" ;;
  configure) shift; case "${1:-}" in system-mail) [[ $# -eq 1 ]] || die "usage: navishai configure system-mail"; configure_system_mail ;; memory) [[ $# -eq 1 ]] || die "usage: navishai configure memory"; configure_memory ;; scanner) [[ $# -eq 1 ]] || die "usage: navishai configure scanner"; configure_scanner ;; *) die "usage: navishai configure {system-mail|memory|scanner}" ;; esac ;;
  renew-owner-token) shift; renew_owner_token "$@" ;;
  reveal-owner-token) shift; reveal_owner_token "$@" ;;
  backup) shift; backup "$@" ;;
  restore) shift; restore "$@" ;;
  upgrade) shift; upgrade "$@" ;;
  *) echo "usage: navishai {setup|status|doctor|configure|renew-owner-token|reveal-owner-token|backup|restore|upgrade}" >&2; exit 2 ;;
esac
