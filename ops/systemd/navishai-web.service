[Unit]
Description=NavishAI web application
After=network-online.target postgresql.service navishai-runner.service navishai-supermemory.service
Wants=network-online.target

[Service]
Type=simple
User=navishai
Group=navishai
WorkingDirectory=/opt/navishai/current
EnvironmentFile=/etc/navishai/navishai.env
ExecStartPre=/opt/navishai/current/bin/rails db:prepare
ExecStart=/opt/navishai/current/bin/rails server -b 127.0.0.1
Restart=on-failure
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/navishai

[Install]
WantedBy=multi-user.target
