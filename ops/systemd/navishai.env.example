RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
NAVISHAI_APP_HOST=navishai.example.com
NAVISHAI_DATABASE_HOST=127.0.0.1
NAVISHAI_DATABASE_PORT=5432
NAVISHAI_DATABASE_PASSWORD=change-me
NAVISHAI_RUNNER_ADDRESS=https://127.0.0.1:8081
NAVISHAI_RUNNER_CA_FILE=/etc/navishai/runner-ca.crt
NAVISHAI_RUNNER_SHARED_SECRET=change-me-at-least-32-random-bytes
NAVISHAI_SUPERMEMORY_ADDRESS=http://127.0.0.1:6767
NAVISHAI_SUPERMEMORY_API_KEY=change-me
# Optional: set all three OIDC values to enable single sign-on.
NAVISHAI_OIDC_ISSUER=
NAVISHAI_OIDC_CLIENT_ID=
NAVISHAI_OIDC_CLIENT_SECRET=
SECRET_KEY_BASE=change-me
