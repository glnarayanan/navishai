[Unit]
Description=NavishAI execution runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=navishai-runner
Group=navishai-runner
WorkingDirectory=/var/lib/navishai-runner
EnvironmentFile=/etc/navishai/runner.env
ExecStart=/usr/local/bin/navishai-runner
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/navishai-runner

[Install]
WantedBy=multi-user.target
