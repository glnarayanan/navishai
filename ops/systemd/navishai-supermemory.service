[Unit]
Description=NavishAI self-hosted Supermemory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=supermemory
Group=supermemory
Environment=SUPERMEMORY_DATA_DIR=/var/lib/supermemory
Environment=SUPERMEMORY_DISABLE_TELEMETRY=1
ExecStart=/usr/local/bin/supermemory-server
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/supermemory

[Install]
WantedBy=multi-user.target
