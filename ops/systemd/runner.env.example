NAVISHAI_RUNNER_BIND_ADDRESS=127.0.0.1:8081
NAVISHAI_RUNNER_SHARED_SECRET=change-me-at-least-32-random-bytes
NAVISHAI_RUNNER_PROVIDER_VAULT_SECRET=change-me-separate-at-least-32-random-bytes
NAVISHAI_RUNNER_STATE_PATH=/var/lib/navishai-runner/admissions.json
NAVISHAI_RUNNER_EXECUTION_CONFIG=/etc/navishai/execution.json
NAVISHAI_CONTROL_PLANE_ADDRESS=https://navishai.example.com
PATH=/opt/navishai/runtimes:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NAVISHAI_RUNNER_TLS_CERT_FILE=/etc/navishai/runner.crt
NAVISHAI_RUNNER_TLS_KEY_FILE=/etc/navishai/runner.key
